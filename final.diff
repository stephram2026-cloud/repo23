+from decimal import Decimal
+
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.payment.enums import TransactionEventTypeEnum
+from saleor.graphql.tests.utils import get_graphql_content
+
+TRANSACTION_CREATE = """
+mutation Create($id: ID!, $transaction: TransactionCreateInput!) {
+  transactionCreate(id: $id, transaction: $transaction) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+EVENT_REPORT = """
+mutation Report(
+  $id: ID, $type: TransactionEventTypeEnum!, $amount: PositiveDecimal,
+  $pspReference: String!
+) {
+  transactionEventReport(
+    id: $id, type: $type, amount: $amount, pspReference: $pspReference
+  ) {
+    transaction { authorizedAmount { amount } chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+TRANSACTION_UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { authorizedAmount { amount } chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_amount_authorized_set_by_update_is_not_the_amount_stored(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+):
+    """transactionUpdate(amountAuthorized: X) stores X minus all previously reported charges.
+
+    On a transaction whose charge was reported with transactionEventReport, setting the
+    authorized amount creates an AUTHORIZATION_ADJUSTMENT of X, and the recalculation
+    then subtracts every CHARGE_SUCCESS again.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_CREATE,
+            {"id": to_global_id_or_none(order), "transaction": {"name": "Card"}},
+        )
+    )
+    assert content["data"]["transactionCreate"]["errors"] == []
+    transaction_id = content["data"]["transactionCreate"]["transaction"]["id"]
+
+    authorized = Decimal(90)
+    charged = Decimal(30)
+    for event_type, amount, psp_reference in [
+        (TransactionEventTypeEnum.AUTHORIZATION_SUCCESS, authorized, "auth-1"),
+        (TransactionEventTypeEnum.CHARGE_SUCCESS, charged, "charge-1"),
+    ]:
+        content = get_graphql_content(
+            staff_api_client.post_graphql(
+                EVENT_REPORT,
+                {
+                    "id": transaction_id,
+                    "type": event_type.name,
+                    "amount": amount,
+                    "pspReference": psp_reference,
+                },
+            )
+        )
+        assert content["data"]["transactionEventReport"]["errors"] == []
+    data = content["data"]["transactionEventReport"]["transaction"]
+    assert Decimal(str(data["authorizedAmount"]["amount"])) == authorized - charged
+    assert Decimal(str(data["chargedAmount"]["amount"])) == charged
+
+    # when
+    requested_authorized = Decimal(50)
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_UPDATE,
+            {
+                "id": transaction_id,
+                "transaction": {
+                    "amountAuthorized": {
+                        "amount": requested_authorized,
+                        "currency": order.currency,
+                    }
+                },
+            },
+        )
+    )
+
+    # then
+    data = content["data"]["transactionUpdate"]
+    assert data["errors"] == []
+    stored_authorized = Decimal(str(data["transaction"]["authorizedAmount"]["amount"]))
+    print("requested authorized:", requested_authorized, "| stored:", stored_authorized)
+    # Reviewed: this follows the built-in rule (entered figure = total authorization,
+    # reported charges are deducted). See test_p15_review_authorized_amount.py.
+    assert stored_authorized == requested_authorized - charged
+    assert stored_authorized != requested_authorized
+    order.refresh_from_db()
+    assert order.total_authorized_amount == requested_authorized - charged
