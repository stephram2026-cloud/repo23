new file mode 100644
index 0000000000..0fa7ab1471
--- /dev/null
+++ b/_repro/orders/15_reservations_oversell.py
@@ -0,0 +1,41 @@
+"""Two orders race for the last unit. Control: reservations off. Test: reservations on."""
+
+from live import *  # noqa: F403
+from live import DRAFT_COMPLETE, shop_settings, verdict
+
+
+def race(label, attempts=6):
+    oversold = 0
+    for attempt in range(attempts):
+        variant, stock = make_variant(stock_qty=1)
+        drafts = [create_draft([(variant, 1)]) for _ in range(2)]
+        results = fire_concurrently(
+            [lambda d=d: gql(DRAFT_COMPLETE, {"id": d["id"]}, check=False) for d in drafts]
+        )
+        outcomes = []
+        for r in results:
+            errs = r["errors"] if "errors" in r else r["data"]["draftOrderComplete"]["errors"]
+            outcomes.append("completed" if not errs else errs[0].get("code") or errs[0]["message"][:60])
+        stock_now = get_stocks(variant)[0]
+        over = stock_now["quantityAllocated"] > stock_now["quantity"]
+        oversold += over
+        print(
+            f"  [{label}] attempt {attempt + 1}: {outcomes} -> in stock {stock_now['quantity']}, "
+            f"allocated {stock_now['quantityAllocated']} {'OVERSOLD' if over else ''}"
+        )
+    return oversold, attempts
+
+
+RESERVE = """
+mutation($input: ShopSettingsInput!){
+  shopSettingsUpdate(input:$input){ shop{ reserveStockDurationAuthenticatedUser reserveStockDurationAnonymousUser } errors{ message } }
+}"""
+
+off = race("reservations OFF")
+gql(RESERVE, {"input": {"reserveStockDurationAuthenticatedUser": 10, "reserveStockDurationAnonymousUser": 10}})
+try:
+    on = race("reservations ON ")
+finally:
+    gql(RESERVE, {"input": {"reserveStockDurationAuthenticatedUser": None, "reserveStockDurationAnonymousUser": None}})
+print(f"  oversold with reservations off: {off[0]}/{off[1]}; on: {on[0]}/{on[1]}")
+verdict(on[0] > 0 and off[0] == 0, "the last unit is sold twice only when stock reservation is enabled.")
diff --git a/_repro/orders/16_stock_webhooks_wrong_variant.py b/_repro/orders/16_stock_webhooks_wrong_variant.py
new file mode 100644
index 0000000000..1b7f8980f2
--- /dev/null
+++ b/_repro/orders/16_stock_webhooks_wrong_variant.py
@@ -0,0 +1,115 @@
+"""Out-of-stock / back-in-stock webhooks name the wrong product."""
+
+import json
+import os
+import time
+
+from live import *  # noqa: F403
+from live import brief, cancel_order, errors_of, new_order, verdict
+
+SINK = "/tmp/webhook_sink.jsonl"
+
+APP_CREATE = """
+mutation{ appCreate(input:{name:"repro-stock-hooks", permissions:[MANAGE_PRODUCTS, MANAGE_ORDERS]}){
+  app{ id } errors{ message } } }"""
+WEBHOOK_CREATE = """
+mutation($input: WebhookCreateInput!){ webhookCreate(input:$input){ webhook{ id } errors{ field message } } }"""
+SUBSCRIPTION = """
+subscription {
+  event {
+    __typename
+    ... on ProductVariantOutOfStock { productVariant { sku } warehouse { name } }
+    ... on ProductVariantBackInStock { productVariant { sku } warehouse { name } }
+  }
+}"""
+
+from saleor.app.models import App  # noqa: E402
+
+if not App.objects.filter(name="repro-stock-hooks").exists():
+    app_id = gql(APP_CREATE)["data"]["appCreate"]["app"]["id"]
+    res = gql(
+        WEBHOOK_CREATE,
+        {
+            "input": {
+                "name": "stock hooks",
+                "app": app_id,
+                "targetUrl": "http://localhost:9911/",
+                "asyncEvents": ["PRODUCT_VARIANT_OUT_OF_STOCK", "PRODUCT_VARIANT_BACK_IN_STOCK"],
+                "query": SUBSCRIPTION,
+            }
+        },
+    )["data"]["webhookCreate"]
+    assert not res["errors"], res
+
+
+def received(skus):
+    """Deliveries seen for the given skus: [(event, sku)]."""
+    if not os.path.exists(SINK):
+        return []
+    out = []
+    for line in open(SINK):
+        body = json.loads(line)["body"]
+        variant = (body or {}).get("productVariant") or {}
+        if variant.get("sku") in skus:
+            out.append((body["__typename"], variant["sku"]))
+    return out
+
+
+def wait_for(skus, at_least, timeout=30):
+    deadline = time.time() + timeout
+    while time.time() < deadline and len(received(skus)) < at_least:
+        time.sleep(0.5)
+    time.sleep(2)  # let stragglers arrive
+    return received(skus)
+
+
+variant_a, stock_a = make_variant(stock_qty=2, sku=None)
+variant_b, stock_b = make_variant(stock_qty=3, sku=None)
+skus = {variant_a.sku, variant_b.sku}
+print(f"  A = {variant_a.sku} (2 in stock), B = {variant_b.sku} (3 in stock)")
+
+# 1) One order takes the full stock of both products, then is shipped in one go.
+order = new_order([(variant_a, 2), (variant_b, 3)])
+seen_after_place = wait_for(skus, 2)
+show("after placing the order", seen_after_place)
+res = fulfill(
+    order["id"], [(order["lines"][0]["id"], 2), (order["lines"][1]["id"], 3)], stock_a.warehouse
+)
+assert not errors_of(res, "orderFulfill"), res
+seen_after_ship = wait_for(skus, len(seen_after_place) + 2)[len(seen_after_place):]
+show("out-of-stock deliveries caused by shipping both lines", seen_after_ship)
+
+# 2) Another order takes the full stock of two products and is then cancelled.
+variant_c, _ = make_variant(stock_qty=2)
+variant_d, _ = make_variant(stock_qty=3)
+skus2 = {variant_c.sku, variant_d.sku}
+print(f"  C = {variant_c.sku}, D = {variant_d.sku}")
+order2 = new_order([(variant_c, 2), (variant_d, 3)])
+before = wait_for(skus2, 2)
+assert not errors_of(cancel_order(order2["id"]), "orderCancel")
+seen_after_cancel = wait_for(skus2, len(before) + 2)[len(before):]
+show("back-in-stock deliveries caused by cancelling", seen_after_cancel)
+
+# 3) Single product, fully allocated to one order, shipped: nothing comes back.
+variant_e, stock_e = make_variant(stock_qty=2)
+order3 = new_order([(variant_e, 2)])
+before = wait_for({variant_e.sku}, 1)
+res = fulfill(order3["id"], [(order3["lines"][0]["id"], 2)], stock_e.warehouse)
+assert not errors_of(res, "orderFulfill"), res
+seen_single = wait_for({variant_e.sku}, len(before) + 2)[len(before):]
+show("deliveries caused by shipping a single sold-out product", [e for e, _ in seen_single])
+
+ship_skus = {s for _, s in seen_after_ship}
+cancel_skus = [s for _, s in seen_after_cancel]
+verdict(
+    len(seen_after_ship) >= 2 and variant_a.sku not in ship_skus,
+    "shipping two sold-out products sent every stock webhook for product B and none for product A.",
+)
+verdict(
+    len(cancel_skus) == 2 and len(set(cancel_skus)) == 1,
+    "cancelling sent two back-in-stock webhooks for the SAME product and none for the other.",
+)
+verdict(
+    "ProductVariantBackInStock" in [e for e, _ in seen_single],
+    "shipping goods that were already reserved for the order announced them as 'back in stock'.",
+)
