+                ORDER_VOID_MUTATION, {"id": order_id}
+            )
+        )["data"]["orderVoid"]["errors"]
+
+    capture_errors, void_errors = run_concurrently(capture, void)
+
+    payment.refresh_from_db()
+    print(
+        "capture errors:",
+        capture_errors,
+        "| void errors:",
+        void_errors,
+        "| captured:",
+        payment.captured_amount,
+        "| active:",
+        payment.is_active,
+    )
+    kinds = set(
+        payment.transactions.filter(is_success=True).values_list("kind", flat=True)
+    )
+    print("successful transaction kinds:", kinds)
+    assert not ({"capture", "void"} <= kinds)
+
