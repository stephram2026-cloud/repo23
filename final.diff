+
+Q = """query($id: ID!){ order(id:$id){ status paymentStatus chargeStatus canFinalize
+  totalCharged{amount} totalRefunded{amount} totalBalance{amount} total{gross{amount}}
+  payments{ gateway chargeStatus capturedAmount{amount} availableRefundAmount{amount} actions }
+  transactions{ id name chargedAmount{amount} refundedAmount{amount} actions }
+  actions grantedRefunds{ id amount{amount} status } } channel(slug:"default-channel"){ orderSettings{ markAsPaidStrategy automaticallyConfirmAllNewOrders } } }"""
+REFUND = """mutation($id: ID!, $amount: PositiveDecimal!){ orderRefund(id:$id, amount:$amount){ order{ id } errors{ field code message } } }"""
+REFUND_PRODUCTS = """mutation($order: ID!, $input: OrderRefundProductsInput!){
+  orderFulfillmentRefundProducts(order:$order, input:$input){ fulfillment{ id status } errors{ field code message } } }"""
+
+variant, stock = make_variant(stock_qty=10)
+order = new_order([(variant, 2)])
+show("state", gql(Q, {"id": order["id"]})["data"])
+res = gql(REFUND, {"id": order["id"], "amount": "5"}, check=False)
