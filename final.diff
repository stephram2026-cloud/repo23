+"""'Add product' submitted twice at once on a draft order."""
+
+from live import *  # noqa: F403
+from live import errors_of, lines_create, verdict
+
+attempts, hits = 5, 0
+for attempt in range(attempts):
+    variant, stock = make_variant(stock_qty=50)
+    other, _ = make_variant(stock_qty=50)
+    draft = create_draft([(other, 1)])
+    results = fire_concurrently([lambda: lines_create(draft["id"], variant, 2)] * 2)
+    errs = [errors_of(r, "orderLinesCreate") for r in results]
+    after = get_order(draft["id"])
+    lines = [(l["variant"]["sku"][-4:], l["quantity"]) for l in after["lines"]]
+    same = [q for sku, q in lines if sku == variant.sku[-4:]]
+    # sequential behaviour: second add merges into the first line -> one line, qty 4
+    bad = same != [4]
+    hits += bad
+    print(f"  attempt {attempt + 1}: errors={errs} lines for the added product={same} (sequentially: [4])")
+verdict(hits > 0, f"{hits}/{attempts}: concurrent adds did not end as one line of 4.")
