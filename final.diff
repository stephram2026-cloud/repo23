+++ b/_repro/webhooks/test_fulfilling_last_units_fires_back_in_stock.py
@@ -0,0 +1,109 @@
+"""Fulfilling the last (already allocated) units of a variant fires PRODUCT_VARIANT_BACK_IN_STOCK.
+
+`decrease_stock()` first drops the order's allocation and only then lowers the
+physical quantity. Between the two steps the stock looks available again, so
+`deallocate_stock()` registers a BACK_IN_STOCK event; it is sent on commit although
+the variant was at 0 available before the fulfillment and is at 0 available after it
+(OUT_OF_STOCK is sent as well). Integrations ("notify me when available", ERP
+re-listing) are told the product is back when it never was.
+
+This is not the late-binding-lambda problem in the same module: a single order line
+/ single stock is fulfilled, so the event is sent for the right stock - it simply
+should not be sent at all.
+
+Real HTTP against a loopback server.
+"""
+
+import graphene
+
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import FulfillmentStatus
+from saleor.warehouse.models import Stock
+from saleor.webhook.event_types import WebhookEventAsyncType
+from saleor.webhook.models import Webhook
+
+ORDER_FULFILL = """
+mutation($order: ID, $input: OrderFulfillInput!) {
+  orderFulfill(order: $order, input: $input) {
+    fulfillments { status }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_back_in_stock_event_sent_while_stock_stays_unavailable(
+    local_server,
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_products,
+    order_with_lines,
+    warehouse,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_products)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    webhook = Webhook.objects.create(
+        name="stock", app=app, target_url=f"{local_server.url}/stock"
+    )
+    webhook.events.create(event_type=WebhookEventAsyncType.PRODUCT_VARIANT_BACK_IN_STOCK)
+    webhook.events.create(event_type=WebhookEventAsyncType.PRODUCT_VARIANT_OUT_OF_STOCK)
+
+    # An order line whose stock is completely allocated to this order: nothing is
+    # available for sale before the fulfillment.
+    line = order_with_lines.lines.get(quantity=2)
+    stock = Stock.objects.get(product_variant=line.variant, warehouse=warehouse)
+    assert stock.quantity == line.quantity
+    assert stock.quantity_allocated == line.quantity
+    assert stock.quantity - stock.quantity_allocated == 0
+
+    # when: staff ships exactly those units
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            ORDER_FULFILL,
+            {
+                "order": graphene.Node.to_global_id("Order", order_with_lines.pk),
+                "input": {
+                    "notifyCustomer": False,
+                    "lines": [
+                        {
+                            "orderLineId": graphene.Node.to_global_id(
+                                "OrderLine", line.pk
+                            ),
+                            "stocks": [
+                                {
+                                    "quantity": line.quantity,
+                                    "warehouse": graphene.Node.to_global_id(
+                                        "Warehouse", warehouse.pk
+                                    ),
+                                }
+                            ],
+                        }
+                    ],
+                },
+            },
+        )
+    )
+
+    # then
+    assert content["data"]["orderFulfill"]["errors"] == []
+    assert content["data"]["orderFulfill"]["fulfillments"] == [
+        {"status": FulfillmentStatus.FULFILLED.upper()}
+    ]
+    # The stock is still not available for sale after the fulfillment.
+    stock.refresh_from_db(fields=("quantity", "quantity_allocated"))
+    assert stock.quantity == 0
+    assert stock.quantity_allocated == 0
+
+    sent_events = sorted(
+        request["headers"]["saleor-event"] for request in local_server.requests
+    )
+    # BUG: a BACK_IN_STOCK webhook was delivered for a variant that had 0 available
+    # units before the fulfillment and has 0 available units after it.
+    assert sent_events == [
+        WebhookEventAsyncType.PRODUCT_VARIANT_BACK_IN_STOCK,
+        WebhookEventAsyncType.PRODUCT_VARIANT_OUT_OF_STOCK,
+    ]
diff --git a/_repro/webhooks/test_manifest_installed_webhook_ignores_channel_filter.py b/_repro/webhooks/test_manifest_installed_webhook_ignores_channel_filter.py
new file mode 100644
index 0000000000..3ae4cbd949
--- /dev/null
+++ b/_repro/webhooks/test_manifest_installed_webhook_ignores_channel_filter.py
@@ -0,0 +1,132 @@
+"""A channel-filtered subscription installed from an app manifest receives every channel.
+
+`subscription { orderUpdated(channels: ["..."]) { ... } }` is enforced only through
+`Webhook.filterable_channel_slugs`, which `webhookCreate`/`webhookUpdate` fill in
+from the query. `install_app()` (the manifest path that real apps use) creates the
+Webhook rows without it, and the subscription resolver itself ignores the
+`channels` argument, so the filter silently does nothing: the app is sent orders of
+channels it explicitly excluded.
+
+Real HTTP against a loopback server: the manifest is fetched from it, the install
+token and the webhook are POSTed to it.
+"""
+
+import json
+
+import graphene
+
+from saleor.app.installation_utils import install_app
+from saleor.app.models import AppInstallation
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.webhook.event_types import WebhookEventAsyncType
+
+ORDER_CANCEL = """
+mutation cancelOrder($id: ID!) {
+  orderCancel(id: $id) { order { status } errors { field code message } }
+}
+"""
+WEBHOOK_CREATE = """
+mutation($input: WebhookCreateInput!) {
+  webhookCreate(input: $input) {
+    webhook { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_channel_filter_from_manifest_is_not_applied(
+    local_server,
+    staff_api_client,
+    permission_manage_apps,
+    permission_manage_orders,
+    permission_group_manage_orders,
+    order_with_lines,
+    channel_PLN,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    order_channel_slug = order_with_lines.channel.slug
+    allowed_channel_slug = channel_PLN.slug
+    assert order_channel_slug != allowed_channel_slug
+
+    query = (
+        f'subscription {{ orderUpdated(channels: ["{allowed_channel_slug}"]) '
+        "{ order { id channel { slug } } } }"
+    )
+    manifest = {
+        "id": "channel-filter-app",
+        "name": "Channel filter app",
+        "version": "1.0.0",
+        "about": "",
+        "permissions": ["MANAGE_ORDERS"],
+        "appUrl": "",
+        "tokenTargetUrl": f"{local_server.url}/install",
+        "webhooks": [
+            {
+                "name": "from manifest",
+                "targetUrl": f"{local_server.url}/manifest-hook",
+                "query": query,
+            }
+        ],
+    }
+    local_server.get_payloads["/manifest"] = json.dumps(manifest).encode()
+    app_installation = AppInstallation.objects.create(
+        app_name="Channel filter app", manifest_url=f"{local_server.url}/manifest"
+    )
+    app_installation.permissions.set([permission_manage_orders])
+    app, _ = install_app(app_installation, activate=True)
+    manifest_webhook = app.webhooks.get()
+    assert manifest_webhook.subscription_query == query
+
+    # Control: the very same subscription registered through `webhookCreate`.
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            WEBHOOK_CREATE,
+            {
+                "input": {
+                    "app": graphene.Node.to_global_id("App", app.pk),
+                    "name": "from api",
+                    "targetUrl": f"{local_server.url}/api-hook",
+                    "query": query,
+                }
+            },
+        )
+    )
+    assert content["data"]["webhookCreate"]["errors"] == []
+    api_webhook = app.webhooks.get(name="from api")
+    assert api_webhook.filterable_channel_slugs == [allowed_channel_slug]
+
+    # when: staff cancels an order that belongs to a channel NOT in the filter
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            ORDER_CANCEL,
+            {"id": graphene.Node.to_global_id("Order", order_with_lines.pk)},
+        )
+    )
+    assert content["data"]["orderCancel"]["errors"] == []
+
+    # then
+    hook_requests = [
+        request
+        for request in local_server.requests
+        if request["path"] in ("/manifest-hook", "/api-hook")
+    ]
+    # BUG: the manifest-installed webhook lost its channel filter...
+    manifest_webhook.refresh_from_db(fields=("filterable_channel_slugs",))
+    assert manifest_webhook.filterable_channel_slugs == []
+    # BUG: ...so it was sent the order of the excluded channel, while the identical
+    # API-created webhook correctly received nothing.
+    assert len(hook_requests) == 1
+    delivered = hook_requests[0]
+    assert delivered["path"] == "/manifest-hook"
+    assert delivered["headers"]["saleor-event"] == WebhookEventAsyncType.ORDER_UPDATED
+    payload = json.loads(delivered["body"])
+    assert payload["data"]["orderUpdated"]["order"] == {
+        "id": graphene.Node.to_global_id("Order", order_with_lines.pk),
+        "channel": {"slug": order_channel_slug},
+    }
diff --git a/_repro/webhooks/test_order_shipping_filter_cache_ignores_subscription_inputs.py b/_repro/webhooks/test_order_shipping_filter_cache_ignores_subscription_inputs.py
new file mode 100644
index 0000000000..341e614dd3
--- /dev/null
+++ b/_repro/webhooks/test_order_shipping_filter_cache_ignores_subscription_inputs.py
@@ -0,0 +1,129 @@
+"""The ORDER_FILTER_SHIPPING_METHODS response cache ignores what the app was actually sent.
+
+The 3-minute cache key is built from the *legacy* order payload
+(`_get_cache_data_for_exclude_shipping_methods`), not from the subscription payload
+the webhook really receives. Anything the app's subscription query reads that is
+not part of the legacy payload (product / variant / customer data, ...) can change
+without invalidating the cache, so staff keep seeing - and can assign - a shipping
+method the app would now exclude.
+
+Real HTTP against a loopback server acting as a shipping app that bans every
+method as soon as a product in the order is flagged `hazmat`.
+"""
+
+import json
+
+import graphene
+from django.core.cache import cache
+
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.webhook.event_types import WebhookEventSyncType
+from saleor.webhook.models import Webhook
+
+ORDER_QUERY = """
+query($id: ID!) {
+  order(id: $id) { shippingMethods { id active message } }
+}
+"""
+SUBSCRIPTION = """
+subscription {
+  event {
+    ... on OrderFilterShippingMethods {
+      order {
+        id
+        lines { variant { product { metadata { key value } } } }
+      }
+      shippingMethods { id }
+    }
+  }
+}
+"""
+
+
+def test_cached_shipping_filter_response_survives_change_of_data_sent_to_app(
+    local_server,
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_orders,
+    permission_manage_shipping,
+    permission_manage_products,
+    draft_order,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(
+        permission_manage_orders, permission_manage_shipping, permission_manage_products
+    )
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    webhook = Webhook.objects.create(
+        name="shipping app",
+        app=app,
+        target_url=f"{local_server.url}/filter-shipping",
+        subscription_query=SUBSCRIPTION,
+    )
+    webhook.events.create(
+        event_type=WebhookEventSyncType.ORDER_FILTER_SHIPPING_METHODS
+    )
+    reason = "hazardous goods"
+
+    def shipping_app(handler):
+        body = json.loads(local_server.requests[-1]["body"])
+        hazmat = any(
+            item["key"] == "hazmat"
+            for line in body["order"]["lines"]
+            for item in line["variant"]["product"]["metadata"]
+        )
+        excluded = (
+            [{"id": method["id"], "reason": reason} for method in body["shippingMethods"]]
+            if hazmat
+            else []
+        )
+        payload = json.dumps({"excluded_methods": excluded}).encode()
+        handler.send_response(200)
+        handler.send_header("Content-Type", "application/json")
+        handler.send_header("Content-Length", str(len(payload)))
+        handler.end_headers()
+        handler.wfile.write(payload)
+
+    local_server.default = (200, shipping_app, 0)
+    variables = {"id": graphene.Node.to_global_id("Order", draft_order.pk)}
+
+    # Staff opens the draft order: the app is asked and excludes nothing.
+    content = get_graphql_content(staff_api_client.post_graphql(ORDER_QUERY, variables))
+    methods_before = content["data"]["order"]["shippingMethods"]
+    assert len(local_server.requests) == 1
+    assert len(methods_before) == 1
+    assert methods_before[0]["active"] is True
+
+    # when: a product in the order gets flagged, i.e. the payload the app would
+    # receive changes and the app would now exclude the method...
+    product = draft_order.lines.first().variant.product
+    product.metadata = {"hazmat": "true"}
+    product.save(update_fields=("metadata",))
+    # ...and staff opens the draft order again
+    content = get_graphql_content(staff_api_client.post_graphql(ORDER_QUERY, variables))
+    methods_after = content["data"]["order"]["shippingMethods"]
+
+    # then
+    # BUG: the app was not asked again - the stale cached answer was reused...
+    assert len(local_server.requests) == 1
+    # BUG: ...so the method the app would exclude is still offered as active.
+    assert methods_after == methods_before
+
+    # Proof that only the cache stands in the way: once this webhook's cache
+    # entries are dropped, the same query reaches the app and the method is excluded.
+    # (The cache key starts with "<app id>-<target url>-<event>-"; the target url
+    # contains this test's random port, so only this test's entries are removed.)
+    redis_client = cache._cache.get_client()
+    cache_keys = list(
+        redis_client.scan_iter(match=f"*:{app.pk}-{webhook.target_url}-*")
+    )
+    assert len(cache_keys) == 1
+    redis_client.delete(*cache_keys)
+    content = get_graphql_content(staff_api_client.post_graphql(ORDER_QUERY, variables))
+    assert len(local_server.requests) == 2
+    assert content["data"]["order"]["shippingMethods"] == [
+        {"id": methods_before[0]["id"], "active": False, "message": reason}
+    ]
diff --git a/_repro/webhooks/test_rate_limited_delivery_is_never_retried.py b/_repro/webhooks/test_rate_limited_delivery_is_never_retried.py
new file mode 100644
index 0000000000..69748e8eb3
--- /dev/null
+++ b/_repro/webhooks/test_rate_limited_delivery_is_never_retried.py
@@ -0,0 +1,70 @@
+"""An async delivery answered with HTTP 429 (or 408) is failed for good after one attempt.
+
+`handle_webhook_retry()` refuses to retry any response with a status in
+[300, 500). That includes 429 Too Many Requests and 408 Request Timeout - the two
+4xx codes that mean "try again later". A receiver that rate-limits during a burst
+(bulk fulfilment, stock import) therefore loses every event it throttled: the
+delivery goes straight to FAILED and no Celery retry is scheduled.
+
+Real HTTP against a loopback server; the task is run through Celery's eager
+`apply()` so that a scheduled retry would be executed (and observable as a second
+request).
+"""
+
+import pytest
+
+from saleor.core import EventDeliveryStatus
+from saleor.core.models import EventDelivery, EventPayload
+from saleor.core.telemetry import get_task_context
+from saleor.webhook.event_types import WebhookEventAsyncType
+from saleor.webhook.models import Webhook
+from saleor.webhook.transport.asynchronous.transport import send_webhook_request_async
+
+
+@pytest.mark.parametrize(
+    ("_case", "status_code", "expected_requests", "expected_status"),
+    [
+        # control: a 503 is retried (eager mode runs the retry inline) and the
+        # second attempt succeeds, which deletes the delivery
+        ("service_unavailable_is_retried", 503, 2, None),
+        ("too_many_requests_is_dropped", 429, 1, EventDeliveryStatus.FAILED),
+        ("request_timeout_is_dropped", 408, 1, EventDeliveryStatus.FAILED),
+    ],
+)
+def test_throttled_delivery_is_failed_without_retry(
+    _case, status_code, expected_requests, expected_status, local_server, app
+):
+    # given
+    webhook = Webhook.objects.create(
+        name="erp", app=app, target_url=f"{local_server.url}/hook"
+    )
+    payload = EventPayload.objects.create_with_payload_file('{"order": "1"}')
+    delivery = EventDelivery.objects.create(
+        event_type=WebhookEventAsyncType.ORDER_UPDATED,
+        payload=payload,
+        webhook=webhook,
+    )
+    # First answer is the error; afterwards the receiver is healthy (default 200).
+    local_server.responses.append((status_code, b'{"error": "slow down"}', 0))
+
+    # when
+    send_webhook_request_async.apply(
+        kwargs={
+            "event_delivery_id": delivery.pk,
+            "telemetry_context": get_task_context().to_dict(),
+        }
+    )
+
+    # then
+    # Reviewed: no retry on any 3xx/4xx is Saleor's stated rule (#14566), not a defect.
+    # See test_w9_review_no_retry_rule.py. 429/408: exactly one request was made.
+    assert len(local_server.requests) == expected_requests
+    # The delivery is FAILED after a single attempt (it can be resent by hand).
+    remaining = EventDelivery.objects.filter(pk=delivery.pk).first()
+    if expected_status is None:
+        assert remaining is None
+    else:
+        assert remaining.status == expected_status
+        assert list(
+            remaining.attempts.values_list("status", "response_status_code")
+        ) == [(EventDeliveryStatus.FAILED, status_code)]
diff --git a/_repro/webhooks/test_sync_webhook_timeout_is_not_a_total_deadline.py b/_repro/webhooks/test_sync_webhook_timeout_is_not_a_total_deadline.py
new file mode 100644
index 0000000000..db3112f674
--- /dev/null
+++ b/_repro/webhooks/test_sync_webhook_timeout_is_not_a_total_deadline.py
@@ -0,0 +1,60 @@
+"""The sync-webhook timeout does not bound how long a staff request is blocked.
+
+`WEBHOOK_SYNC_TIMEOUT = (2, 18)` is handed to `requests` as (connect, read), and
+the read timeout only limits the gap between two received bytes. A tax / shipping /
+payment endpoint (or a proxy in front of it) that keeps trickling bytes holds the
+request thread for as long as it likes, far beyond the configured limit; nothing
+enforces a total deadline or a maximum response size.
+
+To keep the test fast the same code path is exercised with a (1s, 1s) timeout and
+an endpoint that sends one byte every 0.5s for 6s. Real HTTP, loopback server.
+"""
+
+import time
+
+from saleor.core.models import EventDelivery, EventPayload
+from saleor.webhook.event_types import WebhookEventSyncType
+from saleor.webhook.models import Webhook
+from saleor.webhook.transport.synchronous.transport import send_webhook_request_sync
+
+
+def test_slow_dripping_response_blocks_far_longer_than_the_timeout(local_server, app):
+    # given
+    connect_timeout = 1
+    read_timeout = 1
+    drip_interval = 0.5
+    drip_count = 12
+
+    def drip(handler):
+        handler.send_response(200)
+        handler.send_header("Content-Type", "application/json")
+        handler.end_headers()
+        for _ in range(drip_count):
+            handler.wfile.write(b" ")
+            handler.wfile.flush()
+            time.sleep(drip_interval)
+        handler.wfile.write(b'{"excluded_methods": []}')
+
+    local_server.responses.append((200, drip, 0))
+    webhook = Webhook.objects.create(
+        name="shipping app", app=app, target_url=f"{local_server.url}/filter-shipping"
+    )
+    delivery = EventDelivery(
+        event_type=WebhookEventSyncType.ORDER_FILTER_SHIPPING_METHODS,
+        payload=EventPayload(payload='{"order": {}}'),
+        webhook=webhook,
+    )
+
+    # when
+    started = time.monotonic()
+    response_data = send_webhook_request_sync(
+        delivery, timeout=(connect_timeout, read_timeout)
+    )
+    elapsed = time.monotonic() - started
+
+    # then
+    # BUG: the call was not cut off after connect + read timeout (2s); it blocked
+    # for the full ~6s the endpoint chose to take and was then accepted as valid.
+    assert elapsed > 2 * (connect_timeout + read_timeout)
+    assert elapsed >= drip_interval * drip_count
+    assert response_data == {"excluded_methods": []}
diff --git a/_repro/webhooks/test_sync_webhook_with_non_http_target_breaks_draft_orders.py b/_repro/webhooks/test_sync_webhook_with_non_http_target_breaks_draft_orders.py
new file mode 100644
index 0000000000..24db523d2c
--- /dev/null
+++ b/_repro/webhooks/test_sync_webhook_with_non_http_target_breaks_draft_orders.py
@@ -0,0 +1,95 @@
+"""A sync webhook registered with an SQS/PubSub target makes draft orders unreadable.
+
+`webhookCreate` / `webhookUpdate` validate the target URL scheme against
+http/https/awssqs/gcpubsub regardless of the events, so a *synchronous* event can
+be subscribed with an `awssqs://` (or `gcpubsub://`) target. The sync sender only
+supports HTTP(S) and raises a bare `ValueError("Unknown webhook scheme")`, which
+nothing catches: every staff query that resolves `shippingMethods` on a draft
+order then fails with "Internal Server Error" and `order: null`.
+"""
+
+import graphene
+
+from saleor.graphql.tests.utils import (
+    get_graphql_content,
+    get_graphql_content_from_response,
+)
+from saleor.graphql.webhook.enums import WebhookEventTypeSyncEnum
+from saleor.webhook.event_types import WebhookEventSyncType
+from saleor.webhook.models import Webhook
+
+WEBHOOK_CREATE = """
+mutation($input: WebhookCreateInput!) {
+  webhookCreate(input: $input) {
+    webhook { id targetUrl syncEvents { eventType } }
+    errors { field code message }
+  }
+}
+"""
+ORDER_QUERY = """
+query($id: ID!) {
+  order(id: $id) { id status shippingMethods { id name active } }
+}
+"""
+
+
+def test_sync_event_with_sqs_target_is_accepted_and_breaks_draft_order_query(
+    staff_api_client,
+    permission_manage_apps,
+    permission_group_manage_orders,
+    permission_manage_orders,
+    permission_manage_shipping,
+    draft_order,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_orders, permission_manage_shipping)
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order_id = graphene.Node.to_global_id("Order", draft_order.pk)
+    variables = {"id": order_id}
+
+    # precondition: the draft order is readable before the webhook exists
+    content = get_graphql_content(staff_api_client.post_graphql(ORDER_QUERY, variables))
+    assert content["data"]["order"]["id"] == order_id
+
+    # when: a sync event is subscribed with a queue target
+    target_url = "awssqs://key:secret@sqs.us-east-1.amazonaws.com/123456789012/queue"
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            WEBHOOK_CREATE,
+            {
+                "input": {
+                    "app": graphene.Node.to_global_id("App", app.pk),
+                    "name": "shipping filter",
+                    "targetUrl": target_url,
+                    "syncEvents": [
+                        WebhookEventTypeSyncEnum.ORDER_FILTER_SHIPPING_METHODS.name
+                    ],
+                }
+            },
+        )
+    )
+
+    # then
+    # BUG: the mutation accepts a non-HTTP target for a synchronous event.
+    assert content["data"]["webhookCreate"]["errors"] == []
+    webhook = Webhook.objects.get()
+    assert webhook.target_url == target_url
+    assert list(webhook.events.values_list("event_type", flat=True)) == [
+        WebhookEventSyncType.ORDER_FILTER_SHIPPING_METHODS
+    ]
+
+    # when: staff opens the same draft order again
+    response = staff_api_client.post_graphql(ORDER_QUERY, variables)
+    content = get_graphql_content_from_response(response)
+
+    # BUG: the whole order is nulled out by an unhandled ValueError.
+    assert content["data"]["order"] is None
+    assert len(content["errors"]) == 1
+    error = content["errors"][0]
+    assert error["message"] == "Internal Server Error"
+    assert error["path"] == ["order", "shippingMethods"]
+    assert error["extensions"]["exception"]["code"] == ValueError.__name__
diff --git a/_repro/webhooks/test_transaction_request_retry_sends_empty_body.py b/_repro/webhooks/test_transaction_request_retry_sends_empty_body.py
