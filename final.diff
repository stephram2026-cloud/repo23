+from decimal import Decimal
+
+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.payment import TransactionAction, TransactionEventType
+
+REQUEST_ACTION = """
+mutation Action($id: ID, $action_type: TransactionActionEnum!, $amount: PositiveDecimal) {
+  transactionRequestAction(id: $id, actionType: $action_type, amount: $amount) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db(transaction=True)
+def test_two_concurrent_refunds_credit_gift_card_twice(
+    staff_user,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """Two concurrent full refunds of a gift-card payment both credit the gift card.
+
+    Real threads, two independent HTTP-like requests (double click / two staff members).
+    Each request reads `charged_value` before any lock, so both refund the full amount.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_user)
+    staff_user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+
+    gift_card = gift_card_created_by_staff
+    gift_card.current_balance_amount = Decimal(0)
+    gift_card.save(update_fields=["current_balance_amount"])
+    paid_with_gift_card = Decimal(10)
+    transaction = transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order.pk,
+        gift_card=gift_card,
+        charged_value=paid_with_gift_card,
+        available_actions=[TransactionAction.REFUND],
+    )
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.REFUND.name,
+    }
+
+    def refund():
+        client = new_client(user=staff_user)
+        return get_graphql_content(client.post_graphql(REQUEST_ACTION, variables))
+
+    # when
+    results = run_concurrently(refund, refund)
+
+    # then
+    for content in results:
+        assert content["data"]["transactionRequestAction"]["errors"] == []
+
+    gift_card.refresh_from_db()
+    transaction.refresh_from_db()
+    order.refresh_from_db()
+    success_events = transaction.events.filter(
+        type=TransactionEventType.REFUND_SUCCESS
+    )
+    print(
+        "gift card balance:",
+        gift_card.current_balance_amount,
+        "| tx charged:",
+        transaction.charged_value,
+        "| tx refunded:",
+        transaction.refunded_value,
+        "| order total_charged:",
+        order.total_charged_amount,
+        "| refund success events:",
+        [e.amount_value for e in success_events],
+    )
+
+    # BUG: 10 was paid with the card, 20 was given back
+    assert gift_card.current_balance_amount == 2 * paid_with_gift_card
+    assert [e.amount_value for e in success_events] == [
+        paid_with_gift_card,
+        paid_with_gift_card,
+    ]
+    # BUG: refunded more than charged, negative charged amount on the transaction
+    assert transaction.refunded_value == 2 * paid_with_gift_card
+    assert transaction.charged_value == -paid_with_gift_card
