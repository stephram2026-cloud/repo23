+        f"update={'ok' if not e_update else e_update[0]['message'][:50]} -> status={after['status']} "
+        f"line quantity={qty} allocated={allocated} total={after['total']['gross']['amount']} "
+        f"{'MISMATCH' if bad else ''}"
