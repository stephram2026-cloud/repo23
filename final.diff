+"""Returning lines of a not-yet-approved fulfillment leaves stock allocated forever."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, new_order, return_products, shop_settings, verdict
+
+shop_settings(fulfillmentAutoApprove=False)
+try:
+    variant, stock = make_variant(stock_qty=10)
+    order = new_order([(variant, 4)])
+    res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+    assert not errors_of(res, "orderFulfill"), res
+    order = get_order(order["id"])
+    show("fulfillment waiting for approval", brief(order))
+    show("stock", get_stocks(variant))
+
+    res = return_products(
+        order["id"], fulfillment_lines=[(order["fulfillments"][0]["lines"][0]["id"], 4)]
+    )
+    show("return errors", errors_of(res, "orderFulfillmentReturnProducts"))
+    order = get_order(order["id"])
+    show("after return", brief(order))
+    stock_now = get_stocks(variant)[0]
+    show("stock after return", stock_now)
+    show("allocation rows (order number, qty)", db_allocations(variant))
+    verdict(
+        order["status"] == "RETURNED" and stock_now["quantityAllocated"] == 4,
+        "order is RETURNED (nothing left to ship, nothing ever left the warehouse) "
+        "but 4 units stay allocated to it, so only 6 of 10 are sellable.",
+    )
+finally:
+    shop_settings(fulfillmentAutoApprove=True)
