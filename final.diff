+"""orderFulfillmentCancel sent twice at once -> goods restocked twice."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, fulfillment_cancel, new_order, verdict
+
+attempts, hits = 5, 0
+for attempt in range(attempts):
+    variant, stock = make_variant(stock_qty=10)
+    order = new_order([(variant, 4)])
+    res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+    assert not errors_of(res, "orderFulfill"), res
+    order = get_order(order["id"])
+    fulfillment_id = order["fulfillments"][0]["id"]
+    before = get_stocks(variant)[0]
+
+    results = fire_concurrently(
+        [lambda: fulfillment_cancel(fulfillment_id, warehouse=stock.warehouse)] * 2
+    )
+    errs = [errors_of(r, "orderFulfillmentCancel") for r in results]
+    after = get_order(order["id"])
+    stock_now = get_stocks(variant)[0]
+    bad = stock_now["quantity"] != 10 or after["lines"][0]["quantityFulfilled"] != 0
+    hits += bad
+    print(
+        f"  attempt {attempt + 1}: errors={[e[0]['message'] if e else None for e in errs]} "
+        f"stock {before['quantity']} -> {stock_now['quantity']} (started with 10) "
+        f"allocated={stock_now['quantityAllocated']} line.quantityFulfilled={after['lines'][0]['quantityFulfilled']} "
+        f"-> {'DOUBLE RESTOCK' if bad else 'ok'}"
+    )
+verdict(hits > 0, f"{hits}/{attempts} double cancellations restocked the goods twice.")
