+"""orderFulfill accepts order lines that belong to a different order."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, new_order, verdict
+
+variant, stock = make_variant(stock_qty=20)
+order_a = new_order([(variant, 2)])
+order_b = new_order([(variant, 5)])
+show("order A before", brief(order_a))
+show("order B before", brief(order_b))
+
+# Staff member is on order A's page, but the request carries order B's line id.
+res = fulfill(order_a["id"], [(order_b["lines"][0]["id"], 5)], stock.warehouse)
+show("orderFulfill(order=A, line of B) errors", errors_of(res, "orderFulfill"))
+
+order_a, order_b = get_order(order_a["id"]), get_order(order_b["id"])
+show("order A after", brief(order_a))
+show("order B after", brief(order_b))
+verdict(
+    bool(order_a["fulfillments"]) and order_b["lines"][0]["quantityFulfilled"] == 5,
+    "order A now owns a fulfillment made of order B's line; order B's line is "
+    "marked fulfilled although order B shows no fulfillment.",
+)
