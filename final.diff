+
+Fully-paid checkouts that cannot be completed (no shipping method, unavailable
+variant, validation error...) stay eligible for 30 days
+(AUTOMATIC_CHECKOUT_COMPLETION_OLDEST_MODIFIED), because a failed attempt only
+bumps `last_automatic_completion_attempt`. The whole backlog (all columns, on
+the writer DB - the block runs under `allow_writer()`) is re-read every minute.
+"""
+
+from decimal import Decimal
+from unittest import mock
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from saleor.checkout import CheckoutAuthorizeStatus
+from saleor.checkout.models import Checkout
+from saleor.checkout.tasks import (
+    AUTOMATIC_COMPLETION_BATCH_SIZE,
+    trigger_automatic_checkout_completion_task,
+)
+
+
+@pytest.mark.django_db
+@mock.patch("saleor.checkout.tasks.automatic_checkout_completion_task.apply_async")
+def test_trigger_fetches_every_eligible_checkout(
+    mocked_apply_async, channel_USD, address
+):
+    # given: 500 fully authorized checkouts waiting for automatic completion
+    backlog = 25 * AUTOMATIC_COMPLETION_BATCH_SIZE
+    channel_USD.automatically_complete_fully_paid_checkouts = True
+    channel_USD.save(update_fields=["automatically_complete_fully_paid_checkouts"])
+    Checkout.objects.bulk_create(
+        [
+            Checkout(
+                channel=channel_USD,
+                currency=channel_USD.currency_code,
+                email=f"customer{i}@example.com",
+                billing_address=address,
+                authorize_status=CheckoutAuthorizeStatus.FULL,
+                total_gross_amount=Decimal(10),
+            )
+            for i in range(backlog)
+        ]
+    )
+
+    # when: one beat run
+    with CaptureQueriesContext(connection) as ctx:
+        trigger_automatic_checkout_completion_task()
+
+    # then: only one batch of 20 is dispatched ...
+    assert mocked_apply_async.call_count == AUTOMATIC_COMPLETION_BATCH_SIZE
+
+    # BUG: ... but the checkout SELECT has no LIMIT and returns all 500 rows with
+    # every column (the per-run cost grows with the backlog, not the batch size)
+    checkout_selects = [
+        q["sql"]
+        for q in ctx.captured_queries
+        if q["sql"].startswith("SELECT") and 'FROM "checkout_checkout"' in q["sql"]
+    ]
+    assert len(checkout_selects) == 1
+    sql = checkout_selects[0]
+    assert "LIMIT" not in sql
+    selected_columns = sql.split(" FROM ")[0].count('"checkout_checkout".')
+    with connection.cursor() as cursor:
+        cursor.execute(f"SELECT count(*) FROM ({sql}) AS q")  # noqa: S608
+        rows_returned = cursor.fetchone()[0]
+    print(
+        f"dispatched={mocked_apply_async.call_count} rows fetched={rows_returned} "
+        f"columns per row={selected_columns}; SQL tail: ...{sql[-110:]}"
+    )
+    assert rows_returned == backlog
+    assert selected_columns > 40
diff --git a/_repro/tasks/test_decrease_voucher_usage_task_query_per_code.py b/_repro/tasks/test_decrease_voucher_usage_task_query_per_code.py
new file mode 100644
index 0000000000..ec015badd8
--- /dev/null
+++ b/_repro/tasks/test_decrease_voucher_usage_task_query_per_code.py
@@ -0,0 +1,52 @@
+"""`decrease_voucher_codes_usage_task` runs one extra query per voucher code.
+
+The task loads the codes with `.only("voucher", "used", "is_active")` and then
+reads `voucher_code.code` inside the loop. `code` is a deferred field, so every
+iteration issues its own `SELECT ... WHERE id = X` (up to 1000 per batch). The
+task is scheduled by `channelUpdate` when staff switch
+`includeDraftOrderInVoucherUsage` from true to false.
+"""
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from saleor.discount.models import VoucherCode
+from saleor.discount.tasks import decrease_voucher_codes_usage_task
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize("codes_count", [10, 100, 400])
+def test_one_query_per_voucher_code(codes_count, voucher):
+    # given: a usage-limited voucher with N codes, each used once by a draft order
+    voucher.usage_limit = 5
+    voucher.save(update_fields=["usage_limit"])
+    VoucherCode.objects.filter(voucher=voucher).delete()
+    codes = VoucherCode.objects.bulk_create(
+        [
+            VoucherCode(code=f"REPRO-{i}", voucher=voucher, used=1)
+            for i in range(codes_count)
+        ]
+    )
+    code_ids = [code.pk for code in codes]
+    code_values = [code.code for code in codes]
+
+    # when
+    with CaptureQueriesContext(connection) as ctx:
+        decrease_voucher_codes_usage_task(code_ids, code_values)
+
+    # then: the task did its job ...
+    assert VoucherCode.objects.filter(pk__in=code_ids, used=0).count() == codes_count
+
+    # BUG: ... with one deferred-field refetch per voucher code
+    refetches = [
+        q["sql"]
+        for q in ctx.captured_queries
+        if q["sql"].startswith('SELECT "discount_vouchercode"."id", '
+                               '"discount_vouchercode"."code" FROM')
+    ]
+    print(
+        f"codes={codes_count} total queries={len(ctx.captured_queries)} "
+        f"per-code refetch queries={len(refetches)}"
+    )
+    assert len(refetches) == codes_count
diff --git a/_repro/tasks/test_delete_expired_orders_double_decrements_user_counter.py b/_repro/tasks/test_delete_expired_orders_double_decrements_user_counter.py
new file mode 100644
index 0000000000..ab66677be9
--- /dev/null
+++ b/_repro/tasks/test_delete_expired_orders_double_decrements_user_counter.py
@@ -0,0 +1,66 @@
+"""Two overlapping runs of `delete_expired_orders_task` decrement
+`User.number_of_orders` twice for the same deleted orders.
+
+The task (1) reads the batch of expired order ids and the per-user order count
+from the *read replica*, (2) deletes the orders on the writer, (3) subtracts the
+count it computed in step 1 from `User.number_of_orders`, (4) re-queues itself.
+Nothing ties step 3 to the rows step 2 actually deleted. If a second run reads
+the same batch before the first one's delete is visible to it (duplicate broker
+delivery, a manually triggered run, or the self re-queued run reading a replica
+that has not replayed the delete yet), both runs subtract the same orders.
+
+`number_of_orders` is what staff see/filter/sort customers by in the dashboard.
+
+Concurrency: reproduced deterministically with the repo helper
+`saleor.tests.race_condition.RunBefore` (second run executes after the first
+run's replica reads and before its DELETE). No threads.
+"""
+
+import datetime
+
+import pytest
+from django.utils import timezone
+
+from saleor.order import OrderStatus
+from saleor.order.models import Order
+from saleor.order.tasks import delete_expired_orders_task
+from saleor.tests.race_condition import RunBefore
+
+
+@pytest.mark.django_db
+def test_overlapping_runs_subtract_deleted_orders_twice(
+    order_generator, customer_user, channel_USD
+):
+    # given: a customer with 5 orders, 2 of them expired long enough to be deleted
+    channel_USD.delete_expired_orders_after = datetime.timedelta(days=1)
+    channel_USD.save(update_fields=["delete_expired_orders_after"])
+
+    kept_orders = [order_generator(status=OrderStatus.UNFULFILLED) for _ in range(3)]
+    expired_orders = [order_generator(status=OrderStatus.EXPIRED) for _ in range(2)]
+    Order.objects.filter(pk__in=[o.pk for o in expired_orders]).update(
+        expired_at=timezone.now() - datetime.timedelta(days=5)
+    )
+    orders_total = len(kept_orders) + len(expired_orders)
+    customer_user.number_of_orders = orders_total
+    customer_user.save(update_fields=["number_of_orders"])
+
+    def second_run(*args, **kwargs):
+        delete_expired_orders_task()
+
+    # when: a second run starts while the first is between its reads and its DELETE
+    with RunBefore("saleor.order.tasks.allow_writer", second_run):
+        delete_expired_orders_task()
+
+    # then: exactly the two expired orders are gone
+    remaining = Order.objects.filter(user=customer_user).count()
+    assert remaining == len(kept_orders)
+
+    # BUG: the counter was decremented by 4 instead of 2 - the customer has 3
+    # orders but the back office shows 1
+    customer_user.refresh_from_db(fields=("number_of_orders",))
+    print(
+        f"orders in DB={remaining} "
+        f"user.number_of_orders={customer_user.number_of_orders}"
+    )
+    assert customer_user.number_of_orders == orders_total - 2 * len(expired_orders)
+    assert customer_user.number_of_orders != remaining
diff --git a/_repro/tasks/test_disconnect_vouchers_deletes_all_line_discounts.py b/_repro/tasks/test_disconnect_vouchers_deletes_all_line_discounts.py
new file mode 100644
index 0000000000..f882dbbb3b
--- /dev/null
+++ b/_repro/tasks/test_disconnect_vouchers_deletes_all_line_discounts.py
@@ -0,0 +1,103 @@
+"""Turning on "include draft orders in voucher usage" for ONE channel deletes the
+voucher line discounts of EVERY order in the shop (placed orders, other channels).
+
+`channelUpdate(orderSettings: {includeDraftOrderInVoucherUsage: true})` schedules
+`disconnect_voucher_codes_from_draft_orders_task(draft_order_ids)`. The task is
+meant to strip vouchers from that channel's draft orders, but its line-discount
+cleanup is
+
+    OrderLineDiscount.objects.filter(
+        Exists(OrderLine.objects.filter(order_id__in=order_ids))   # no OuterRef!
+    ).filter(type=VOUCHER).delete()
+
+The EXISTS subquery is not correlated with the outer row, so as soon as any of
+the draft orders has a line it is TRUE for every row and all voucher-type
+`OrderLineDiscount` rows in the database are deleted.
+"""
+
+from decimal import Decimal
+
+import graphene
+import pytest
+
+from saleor.discount import DiscountType, DiscountValueType
+from saleor.discount.models import OrderLineDiscount
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderStatus
+
+CHANNEL_UPDATE_MUTATION = """
+mutation UpdateChannel($id: ID!, $input: ChannelUpdateInput!) {
+  channelUpdate(id: $id, input: $input) {
+    channel { orderSettings { includeDraftOrderInVoucherUsage } }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db
+def test_enabling_flag_on_one_channel_wipes_voucher_line_discounts_everywhere(
+    staff_api_client,
+    permission_manage_orders,
+    channel_USD,
+    channel_PLN,
+    draft_order,
+    order_with_lines_channel_PLN,
+    voucher_multiple_use,
+):
+    # given: USD channel has a draft order that uses a voucher code
+    channel_USD.include_draft_order_in_voucher_usage = False
+    channel_USD.save(update_fields=["include_draft_order_in_voucher_usage"])
+    assert draft_order.channel_id == channel_USD.pk
+    assert draft_order.status == OrderStatus.DRAFT
+    assert draft_order.lines.count() == 2
+    draft_order.voucher_code = voucher_multiple_use.codes.first().code
+    draft_order.save(update_fields=["voucher_code"])
+
+    # and: an unrelated, already PLACED order in the PLN channel whose line
+    # carries a voucher discount
+    placed_order = order_with_lines_channel_PLN
+    assert placed_order.channel_id == channel_PLN.pk
+    assert placed_order.status == OrderStatus.UNFULFILLED
+    placed_line = placed_order.lines.first()
+    discount_amount = Decimal("5.00")
+    placed_line_discount = OrderLineDiscount.objects.create(
+        line=placed_line,
+        type=DiscountType.VOUCHER,
+        value_type=DiscountValueType.FIXED,
+        value=discount_amount,
+        amount_value=discount_amount,
+        currency=placed_order.currency,
+        voucher=voucher_multiple_use,
+        voucher_code="PLACED-ORDER-CODE",
+    )
+
+    # when: staff enable the flag for the USD channel only
+    response = staff_api_client.post_graphql(
+        CHANNEL_UPDATE_MUTATION,
+        variables={
+            "id": graphene.Node.to_global_id("Channel", channel_USD.pk),
+            "input": {"orderSettings": {"includeDraftOrderInVoucherUsage": True}},
+        },
+        permissions=(permission_manage_orders,),
+    )
+
+    # then: the mutation succeeds and the draft order is disconnected (intended)
+    data = get_graphql_content(response)["data"]["channelUpdate"]
+    assert data["errors"] == []
+    assert data["channel"]["orderSettings"]["includeDraftOrderInVoucherUsage"] is True
+    draft_order.refresh_from_db(fields=("voucher_code",))
+    assert draft_order.voucher_code is None
+
+    # BUG: the placed order in the OTHER channel lost its voucher line discount
+    placed_order.refresh_from_db(fields=("status", "channel_id"))
+    assert placed_order.status == OrderStatus.UNFULFILLED
+    assert placed_order.channel_id == channel_PLN.pk
+    assert (
+        OrderLineDiscount.objects.filter(pk=placed_line_discount.pk).exists() is False
+    )
+    assert OrderLineDiscount.objects.filter(type=DiscountType.VOUCHER).exists() is False
+    print(
+        "voucher line discount of placed PLN order still exists:",
+        OrderLineDiscount.objects.filter(pk=placed_line_discount.pk).exists(),
+    )
diff --git a/_repro/tasks/test_draft_bulk_delete_releases_voucher_of_undeleted_order.py b/_repro/tasks/test_draft_bulk_delete_releases_voucher_of_undeleted_order.py
new file mode 100644
index 0000000000..02fc32f7e5
--- /dev/null
+++ b/_repro/tasks/test_draft_bulk_delete_releases_voucher_of_undeleted_order.py
@@ -0,0 +1,113 @@
+"""`draftOrderBulkDelete` releases the voucher usage of orders it REFUSES to delete.
+
+`DraftOrderBulkDelete.clean_input` collects `(voucher_code, email)` for every
+requested order - including the ones that failed validation (not a draft, or a
+draft with a payment/transaction attached) - and
+`release_voucher_code_usage_of_draft_orders.delay(...)` is then called
+unconditionally. The task decrements `VoucherCode.used`, re-activates
+single-use codes and deletes the `VoucherCustomer` row, although the order that
+consumed the voucher still exists and still carries the code.
+
+Result: a limited / single-use voucher can be redeemed again while the first
+order keeps its discount.
+"""
+
+import graphene
+import pytest
+
+from saleor.discount.models import VoucherCode, VoucherCustomer
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderStatus
+from saleor.order.error_codes import OrderErrorCode
+from saleor.order.models import Order
+
+DRAFT_ORDER_BULK_DELETE = """
+mutation ($ids: [ID!]!) {
+  draftOrderBulkDelete(ids: $ids) {
+    count
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize(
+    ("_case", "status", "with_transaction", "expected_message"),
+    [
+        (
+            "draft order that has a transaction attached",
+            OrderStatus.DRAFT,
+            True,
+            "Cannot delete order with payments or transactions attached to it.",
+        ),
+        (
+            "already placed (non-draft) order",
+            OrderStatus.UNFULFILLED,
+            False,
+            "Cannot delete non-draft orders.",
+        ),
+    ],
+)
+def test_voucher_usage_released_although_order_was_not_deleted(
+    _case,
+    status,
+    with_transaction,
+    expected_message,
+    staff_api_client,
+    permission_group_manage_orders,
+    order_with_lines,
+    voucher,
+    transaction_item_generator,
+):
+    # given: an order that consumed the single allowed use of a voucher code
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    channel = order.channel
+    channel.include_draft_order_in_voucher_usage = True
+    channel.save(update_fields=["include_draft_order_in_voucher_usage"])
+
+    usage_limit = 1
+    voucher.usage_limit = usage_limit
+    voucher.single_use = True
+    voucher.apply_once_per_customer = True
+    voucher.save(update_fields=["usage_limit", "single_use", "apply_once_per_customer"])
+    code = voucher.codes.first()
+    code.used = usage_limit
+    code.is_active = False
+    code.save(update_fields=["used", "is_active"])
+    VoucherCustomer.objects.create(voucher_code=code, customer_email=order.user_email)
+
+    order.status = status
+    order.voucher = voucher
+    order.voucher_code = code.code
+    order.save(update_fields=["status", "voucher", "voucher_code"])
+    if with_transaction:
+        transaction_item_generator(order_id=order.pk, charged_value=order.total.gross.amount)
+
+    # when: staff bulk-delete "drafts" and this order is among the selected ids
+    response = staff_api_client.post_graphql(
+        DRAFT_ORDER_BULK_DELETE,
+        {"ids": [graphene.Node.to_global_id("Order", order.pk)]},
+    )
+
+    # then: the order is rejected and NOT deleted
+    data = get_graphql_content(response)["data"]["draftOrderBulkDelete"]
+    assert data["count"] == 0
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["message"] == expected_message
+    assert data["errors"][0]["code"] == OrderErrorCode.INVALID.name
+    order = Order.objects.get(pk=order.pk)
+    assert order.voucher_code == code.code
+
+    # BUG: ... but its voucher usage has been released
+    code = VoucherCode.objects.get(pk=code.pk)
+    customer_usage_exists = VoucherCustomer.objects.filter(voucher_code=code).exists()
+    print(
+        f"{_case}: order still exists with code={order.voucher_code}, "
+        f"code.used={code.used} (was {usage_limit}), is_active={code.is_active} "
+        f"(was False), VoucherCustomer exists={customer_usage_exists} (was True)"
+    )
+    assert code.used == 0
+    assert code.is_active is True
+    assert customer_usage_exists is False
diff --git a/_repro/tasks/test_expire_orders_age_miscalculated.py b/_repro/tasks/test_expire_orders_age_miscalculated.py
new file mode 100644
index 0000000000..47861d842b
--- /dev/null
+++ b/_repro/tasks/test_expire_orders_age_miscalculated.py
@@ -0,0 +1,119 @@
+"""`expire_orders_task` computes an order's age in minutes as day*24 + hour*60 + min.
+
+The day part is multiplied by 24 (hours) instead of 24*60 (minutes), so every
+full day of age only counts as 24 minutes. Unconfirmed, unpaid orders therefore
+do NOT expire once they are more than a day old unless the channel TTL is tiny:
+
+    TTL 1 day   (1440 min) -> expires after ~1 day 23 h 36 min
+    TTL 2 days  (2880 min) -> expires after ~61 days 23 h 36 min
+    TTL 5 days  (7200 min) -> expires after ~241 days
+
+Until then the order stays UNCONFIRMED and keeps its stock allocation (and
+voucher usage), i.e. stock is never released.
+"""
+
+import datetime
+
+import pytest
+from django.db.models import Sum
+from django.utils import timezone
+
+from saleor.order import OrderStatus
+from saleor.order.models import OrderEvent
+from saleor.order.tasks import expire_orders_task
+from saleor.warehouse.models import Allocation, Stock
+
+MINUTES_IN_DAY = 24 * 60
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize(
+    ("_case", "ttl_minutes", "age", "expected_status"),
+    [
+        (
+            "control: TTL 1h, order 2h old -> expired (task works below one day)",
+            60,
+            datetime.timedelta(hours=2),
+            OrderStatus.EXPIRED,
+        ),
+        (
+            "BUG: TTL 1 day, order 1.5 days old -> still unconfirmed",
+            MINUTES_IN_DAY,
+            datetime.timedelta(days=1, hours=12),
+            OrderStatus.UNCONFIRMED,
+        ),
+        (
+            "BUG: TTL 2 days, order 3 days old -> still unconfirmed",
+            2 * MINUTES_IN_DAY,
+            datetime.timedelta(days=3),
+            OrderStatus.UNCONFIRMED,
+        ),
+        (
+            "BUG: TTL 2 days, order 60 days old -> still unconfirmed",
+            2 * MINUTES_IN_DAY,
+            datetime.timedelta(days=60),
+            OrderStatus.UNCONFIRMED,
+        ),
+        (
+            "BUG: TTL 5 days, order 200 days old -> still unconfirmed",
+            5 * MINUTES_IN_DAY,
+            datetime.timedelta(days=200),
+            OrderStatus.UNCONFIRMED,
+        ),
+        (
+            "BUG: TTL 1h (e.g. just enabled), order 1 day 10 min old -> unconfirmed",
+            60,
+            datetime.timedelta(days=1, minutes=10),
+            OrderStatus.UNCONFIRMED,
+        ),
+    ],
+)
+def test_order_older_than_ttl_is_not_expired(
+    _case, ttl_minutes, age, expected_status, order_list, allocations, channel_USD
+):
+    # given: an unpaid UNCONFIRMED order older than the channel's expiry TTL
+    channel_USD.expire_orders_after = ttl_minutes
+    channel_USD.save(update_fields=["expire_orders_after"])
+
+    order = order_list[0]
+    order.status = OrderStatus.UNCONFIRMED
+    order.created_at = timezone.now() - age
+    order.save(update_fields=["status", "created_at"])
+    assert age > datetime.timedelta(minutes=ttl_minutes)
+    assert order.payments.exists() is False
+    assert order.payment_transactions.exists() is False
+
+    allocation = Allocation.objects.get(order_line__order=order)
+    allocated_quantity = allocation.quantity_allocated
+    assert allocated_quantity > 0
+    # make the stock counter consistent with the fixture's allocation rows
+    Stock.objects.filter(pk=allocation.stock_id).update(
+        quantity_allocated=Allocation.objects.filter(
+            stock_id=allocation.stock_id
+        ).aggregate(total=Sum("quantity_allocated"))["total"]
+    )
+    stock_allocated_before = Stock.objects.get(pk=allocation.stock_id).quantity_allocated
+
+    # when
+    expire_orders_task()
+
+    # then
+    order.refresh_from_db(fields=("status", "expired_at"))
+    allocation.refresh_from_db(fields=("quantity_allocated",))
+    stock_allocated_after = Stock.objects.get(pk=allocation.stock_id).quantity_allocated
+    print(
+        f"{_case}: status={order.status} "
+        f"allocation={allocation.quantity_allocated} "
+        f"stock.quantity_allocated {stock_allocated_before}->{stock_allocated_after}"
+    )
+    assert order.status == expected_status
+
+    if expected_status == OrderStatus.EXPIRED:
+        assert allocation.quantity_allocated == 0
+        assert stock_allocated_after == stock_allocated_before - allocated_quantity
+    else:
+        # BUG: order is past its TTL but was not expired; its stock stays allocated
+        assert order.expired_at is None
+        assert allocation.quantity_allocated == allocated_quantity
+        assert stock_allocated_after == stock_allocated_before
+        assert OrderEvent.objects.filter(order=order, type="expired").exists() is False
diff --git a/_repro/tasks/test_expire_orders_expires_order_paid_meanwhile.py b/_repro/tasks/test_expire_orders_expires_order_paid_meanwhile.py
new file mode 100644
index 0000000000..8469a8bce7
--- /dev/null
+++ b/_repro/tasks/test_expire_orders_expires_order_paid_meanwhile.py
@@ -0,0 +1,122 @@
+"""`expire_orders_task` expires an order that got paid / confirmed in the meantime.
+
+`_expire_orders` picks candidate ids with one query against the *read replica*
+("UNCONFIRMED, no payment, no transaction, older than TTL") and then, on the
+writer, runs
+
+    Order.objects.filter(id__in=ids_batch).update(status=EXPIRED, expired_at=now)
+
+without re-checking any of those conditions and without locking the orders. An
+order that is paid or confirmed between the two statements (or whose payment has
+simply not reached the replica yet) is flipped to EXPIRED anyway and its stock
+is deallocated.
+
+Concurrency: reproduced deterministically with the repo helper
+`saleor.tests.race_condition.RunBefore` (the "other request" runs right after
+the candidate SELECT and before the UPDATE transaction opens). No threads.
+"""
+
+import datetime
+from decimal import Decimal
+
+import graphene
+import pytest
+from django.utils import timezone
+
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderStatus
+from saleor.order.tasks import expire_orders_task
+from saleor.payment.models import TransactionItem
+from saleor.tests.race_condition import RunBefore
+from saleor.warehouse.models import Allocation
+
+ORDER_CONFIRM_MUTATION = """
+mutation ($id: ID!) {
+  orderConfirm(id: $id) {
+    order { status }
+    errors { field code message }
+  }
+}
+"""
+
+
+def _unconfirmed_order_past_ttl(order_list, channel_USD):
+    channel_USD.expire_orders_after = 60
+    channel_USD.save(update_fields=["expire_orders_after"])
+    order = order_list[0]
+    order.status = OrderStatus.UNCONFIRMED
+    order.created_at = timezone.now() - datetime.timedelta(hours=2)
+    order.save(update_fields=["status", "created_at"])
+    return order
+
+
+@pytest.mark.django_db
+def test_order_paid_between_select_and_update_is_expired(
+    order_list, allocations, channel_USD, transaction_item_generator
+):
+    # given
+    order = _unconfirmed_order_past_ttl(order_list, channel_USD)
+    allocation = Allocation.objects.get(order_line__order=order)
+    assert allocation.quantity_allocated == 1
+    paid_amount = Decimal("10.00")
+
+    def customer_pays(*args, **kwargs):
+        transaction_item_generator(order_id=order.pk, charged_value=paid_amount)
+
+    # when: the payment lands right after the task selected its candidates
+    with RunBefore("saleor.order.tasks.traced_atomic_transaction", customer_pays):
+        expire_orders_task()
+
+    # then: the payment is there ...
+    transaction = TransactionItem.objects.get(order_id=order.pk)
+    assert transaction.charged_value == paid_amount
+
+    # BUG: ... but the paid order was expired and its stock released
+    order.refresh_from_db(fields=("status", "expired_at"))
+    allocation.refresh_from_db(fields=("quantity_allocated",))
+    print(
+        f"paid={transaction.charged_value} status={order.status} "
+        f"allocation={allocation.quantity_allocated}"
+    )
+    assert order.status == OrderStatus.EXPIRED
+    assert allocation.quantity_allocated == 0
+
+
+@pytest.mark.django_db
+def test_order_confirmed_by_staff_between_select_and_update_is_expired(
+    order_list,
+    allocations,
+    channel_USD,
+    staff_api_client,
+    permission_group_manage_orders,
+):
+    # given
+    order = _unconfirmed_order_past_ttl(order_list, channel_USD)
+    allocation = Allocation.objects.get(order_line__order=order)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    confirm_result = {}
+
+    def staff_confirms_order(*args, **kwargs):
+        response = staff_api_client.post_graphql(
+            ORDER_CONFIRM_MUTATION,
+            {"id": graphene.Node.to_global_id("Order", order.pk)},
+        )
+        confirm_result.update(get_graphql_content(response)["data"]["orderConfirm"])
+
+    # when: staff click "Confirm" right after the task selected its candidates
+    with RunBefore("saleor.order.tasks.traced_atomic_transaction", staff_confirms_order):
+        expire_orders_task()
+
+    # then: staff were told the order is confirmed ...
+    assert confirm_result["errors"] == []
+    assert confirm_result["order"]["status"] == OrderStatus.UNFULFILLED.upper()
+
+    # BUG: ... but it ends up EXPIRED with its stock released
+    order.refresh_from_db(fields=("status",))
+    allocation.refresh_from_db(fields=("quantity_allocated",))
+    print(
+        f"mutation said={confirm_result['order']['status']} "
+        f"db status={order.status} allocation={allocation.quantity_allocated}"
+    )
+    assert order.status == OrderStatus.EXPIRED
+    assert allocation.quantity_allocated == 0
diff --git a/_repro/tasks/test_export_products_xlsx_with_channel_fails.py b/_repro/tasks/test_export_products_xlsx_with_channel_fails.py
new file mode 100644
index 0000000000..de8cb5aec3
--- /dev/null
+++ b/_repro/tasks/test_export_products_xlsx_with_channel_fails.py
@@ -0,0 +1,120 @@
+"""`exportProducts` to XLSX fails whenever channel columns are requested for a
+product that has a publication / available-for-purchase date.
+
+Selecting a channel in the export adds the "<channel> (channel published at)"
+and "<channel> (channel available for purchase)" columns. Their values are
+timezone-aware `datetime` objects taken straight from `ProductChannelListing`;
+`export_products_task` hands them to petl/openpyxl, which raises
+
+    TypeError: Excel does not support timezones in datetimes.
+
+`ExportTask.on_failure` then marks the export FAILED. The same export as CSV
+works. Any published product has `published_at` set, so in practice every XLSX
+product export that includes a channel fails.
+"""
+
+import datetime
+
+import graphene
+import pytest
+
+from saleor.core import JobStatus
+from saleor.csv import ExportEvents, FileTypes
+from saleor.csv.models import ExportFile
+from saleor.graphql.csv.enums import FileTypeEnum
+from saleor.graphql.tests.utils import get_graphql_content
+
+NOW = datetime.datetime(2026, 11, 1, 12, 0, tzinfo=datetime.UTC)
+
+EXPORT_PRODUCTS_MUTATION = """
+mutation ExportProducts($input: ExportProductsInput!) {
+  exportProducts(input: $input) {
+    exportFile { id status }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize(
+    ("_case", "file_type", "listing_dates", "expected_status"),
+    [
+        (
+            "control: CSV export succeeds",
+            FileTypes.CSV,
+            {"published_at": NOW, "available_for_purchase_at": NOW},
+            JobStatus.SUCCESS,
+        ),
+        (
+            "control: XLSX succeeds when the listing has no dates at all",
+            FileTypes.XLSX,
+            {"published_at": None, "available_for_purchase_at": None},
+            JobStatus.SUCCESS,
+        ),
+        (
+            "BUG: XLSX fails when the product has a published-at date",
+            FileTypes.XLSX,
+            {"published_at": NOW, "available_for_purchase_at": None},
+            JobStatus.FAILED,
+        ),
+        (
+            "BUG: XLSX fails when the product has an available-for-purchase date",
+            FileTypes.XLSX,
+            {"published_at": None, "available_for_purchase_at": NOW},
+            JobStatus.FAILED,
+        ),
+    ],
+)
+def test_xlsx_export_with_channel_columns(
+    _case,
+    file_type,
+    listing_dates,
+    expected_status,
+    staff_api_client,
+    permission_manage_products,
+    permission_manage_apps,
+    product,
+    channel_USD,
+    media_root,
+):
+    # given: an ordinary product listed in the channel
+    product.channel_listings.filter(channel=channel_USD).update(**listing_dates)
+
+    # when: staff export all products including that channel's columns
+    response = staff_api_client.post_graphql(
+        EXPORT_PRODUCTS_MUTATION,
+        {
+            "input": {
+                "scope": "ALL",
+                "exportInfo": {
+                    "fields": ["NAME", "VARIANT_SKU"],
+                    "channels": [graphene.Node.to_global_id("Channel", channel_USD.pk)],
+                },
+                "fileType": FileTypeEnum.get(file_type).name,
+            }
+        },
+        permissions=[permission_manage_products, permission_manage_apps],
+    )
+
+    # then: the mutation itself reports no error ...
+    data = get_graphql_content(response)["data"]["exportProducts"]
+    assert data["errors"] == []
+
+    export_file = ExportFile.objects.get()
+    events = list(export_file.events.order_by("pk").values_list("type", "parameters"))
+    print(f"{_case}: status={export_file.status} events={events}")
+    assert export_file.status == expected_status
+
+    if expected_status == JobStatus.FAILED:
+        # BUG: ... but the background export crashed and produced no file
+        assert bool(export_file.content_file) is False
+        assert len(events) == 2
+        failed_type, failed_parameters = events[1]
+        assert failed_type == ExportEvents.EXPORT_FAILED
+        assert failed_parameters["message"] == (
+            "Excel does not support timezones in datetimes. The tzinfo in the "
+            "datetime/time object must be set to None."
+        )
+    else:
+        assert export_file.content_file.name.endswith(f".{file_type}")
diff --git a/_repro/tasks/test_gift_card_search_task_loads_all_dirty_cards.py b/_repro/tasks/test_gift_card_search_task_loads_all_dirty_cards.py
new file mode 100644
index 0000000000..1eef411888
--- /dev/null
+++ b/_repro/tasks/test_gift_card_search_task_loads_all_dirty_cards.py
@@ -0,0 +1,118 @@
+"""`update_gift_cards_search_vector_task` (beat, every ~60 s) loads EVERY dirty gift
+card into memory although it only indexes 300 per run, and then runs one extra
+query per card for its tags.
+
+    gift_cards = GiftCard.objects.using(replica).filter(search_index_dirty=True)
+    if not gift_cards:            # <- evaluates the whole, unsliced queryset
+        return
+    gift_cards_batch = list(gift_cards[:GIFT_CARD_BATCH_SIZE])  # slices the cache
+
+After a bulk import, or after the 3.22 data migration that marks all gift cards
+dirty, every run pulls the full remaining backlog (all columns) from the DB into
+the worker, so the cost of each run grows with the backlog instead of the batch.
+"""
+
+import tracemalloc
+from decimal import Decimal
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from saleor.giftcard.models import GiftCard
+from saleor.giftcard.tasks import (
+    GIFT_CARD_BATCH_SIZE,
+    update_gift_cards_search_vector_task,
+)
+
+
+def _create_dirty_gift_cards(count):
+    GiftCard.objects.bulk_create(
+        [
+            GiftCard(
+                code=f"REPRO-{i:06d}",
+                currency="USD",
+                initial_balance_amount=Decimal(10),
+                current_balance_amount=Decimal(10),
+                created_by_email=f"staff{i}@example.com",
+                search_index_dirty=True,
+            )
+            for i in range(count)
+        ],
+        batch_size=2000,
+    )
+
+
+def _run_task_measured():
+    tracemalloc.start()
+    with CaptureQueriesContext(connection) as ctx:
+        update_gift_cards_search_vector_task()
+    _current, peak = tracemalloc.get_traced_memory()
+    tracemalloc.stop()
+    return ctx.captured_queries, peak
+
+
+@pytest.mark.django_db
+def test_one_run_fetches_whole_backlog_but_indexes_only_one_batch():
+    # given: a backlog of dirty gift cards 20x larger than the batch size
+    backlog = 20 * GIFT_CARD_BATCH_SIZE
+    _create_dirty_gift_cards(backlog)
+
+    # when: one beat run
+    queries, _peak = _run_task_measured()
+
+    # then: only one batch got indexed ...
+    still_dirty = GiftCard.objects.filter(search_index_dirty=True).count()
+    assert still_dirty == backlog - GIFT_CARD_BATCH_SIZE
+
+    # BUG: ... but the SELECT that loads the cards has no LIMIT - the whole backlog
+    # (6000 full rows) is fetched and instantiated to process 300 of them
+    card_selects = [
+        q["sql"]
+        for q in queries
+        if q["sql"].startswith("SELECT")
+        and 'FROM "giftcard_giftcard"' in q["sql"]
+        and '"search_index_dirty"' in q["sql"].split("WHERE")[-1]
+    ]
+    assert len(card_selects) == 1
+    assert "LIMIT" not in card_selects[0]
+    with connection.cursor() as cursor:
+        cursor.execute(
+            "SELECT count(*) FROM giftcard_giftcard WHERE search_index_dirty"
+        )
+        assert cursor.fetchone()[0] == still_dirty
+    print("gift card SELECT (tail):", card_selects[0][-90:])
+
+    # BUG: one extra query per indexed card for its tags (N+1)
+    tag_queries = [q for q in queries if 'FROM "giftcard_giftcardtag"' in q["sql"]]
+    print("tag queries in one run:", len(tag_queries), "total:", len(queries))
+    assert len(tag_queries) == GIFT_CARD_BATCH_SIZE
+
+
+@pytest.mark.django_db
+def test_peak_memory_of_one_run_grows_with_backlog():
+    # given / when: same task, same batch size (300 cards indexed per run), with a
+    # backlog of 1, 20 and 40 batches
+    peaks = {}
+    for batches in (1, 20, 40):
+        GiftCard.objects.all().delete()
+        backlog = batches * GIFT_CARD_BATCH_SIZE
+        _create_dirty_gift_cards(backlog)
+        _queries, peaks[backlog] = _run_task_measured()
+        assert (
+            GiftCard.objects.filter(search_index_dirty=True).count()
+            == backlog - GIFT_CARD_BATCH_SIZE
+        )
+
+    # then
+    small, medium, large = (peaks[b * GIFT_CARD_BATCH_SIZE] for b in (1, 20, 40))
+    per_row = (large - small) / (39 * GIFT_CARD_BATCH_SIZE)
+    print(
+        "peak traced memory per run: "
+        + ", ".join(f"backlog={b} -> {p / 1e6:.1f} MB" for b, p in peaks.items())
+        + f"  (~{per_row:.0f} bytes per backlog row)"
+    )
+    # BUG: every run indexes exactly 300 cards, yet memory grows with the backlog
+    # (roughly +1 KB per extra dirty row: linear, unbounded)
+    assert medium - small > 4_000_000
+    assert large - medium > 4_000_000
diff --git a/_repro/tasks/test_preorder_end_queries_per_allocation.py b/_repro/tasks/test_preorder_end_queries_per_allocation.py
new file mode 100644
index 0000000000..04f64dbfb8
--- /dev/null
+++ b/_repro/tasks/test_preorder_end_queries_per_allocation.py
@@ -0,0 +1,108 @@
+"""Ending a preorder runs 3 extra queries per preorder allocation (N+1) while it
+holds `FOR UPDATE` locks on the preorder allocations and the stock row.
+
+`deactivate_preorder_for_variant` calls `_get_stock_for_preorder_allocation` once
+per allocation; each call loads the order's shipping method, picks a warehouse
+and re-selects (and re-locks) the same Stock row. A popular preorder with a few
+thousand orders therefore issues thousands of queries inside one transaction of
+the hourly `deactivate_preorder_for_variants_task`.
+"""
+
+import datetime
+from decimal import Decimal
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+from django.utils import timezone
+from prices import Money, TaxedMoney
+
+from saleor.product.models import ProductVariant, ProductVariantChannelListing
+from saleor.product.tasks import deactivate_preorder_for_variants_task
+from saleor.warehouse.models import PreorderAllocation, Stock
+
+
+def _preorder_variant(product, channel, sku):
+    variant = ProductVariant.objects.create(
+        product=product,
+        sku=sku,
+        is_preorder=True,
+        preorder_global_threshold=1000,
+        preorder_end_date=timezone.now() - datetime.timedelta(hours=2),
+    )
+    listing = ProductVariantChannelListing.objects.create(
+        variant=variant,
+        channel=channel,
+        price_amount=Decimal(10),
+        discounted_price_amount=Decimal(10),
+        cost_price_amount=Decimal(1),
+        currency=channel.currency_code,
+    )
+    return variant, listing
+
+
+def _preorder_line(order, variant, listing, quantity):
+    unit_price = TaxedMoney(
+        net=Money(Decimal(10), order.currency), gross=Money(Decimal(10), order.currency)
+    )
+    line = order.lines.create(
+        product_name=str(variant.product),
+        variant_name=str(variant),
+        product_sku=variant.sku,
+        is_shipping_required=True,
+        is_gift_card=False,
+        quantity=quantity,
+        variant=variant,
+        unit_price=unit_price,
+        total_price=unit_price * quantity,
+        undiscounted_unit_price=unit_price,
+        undiscounted_total_price=unit_price * quantity,
+        base_unit_price=unit_price.gross,
+        undiscounted_base_unit_price=unit_price.gross,
+        tax_rate=Decimal(0),
+    )
+    PreorderAllocation.objects.create(
+        order_line=line, product_variant_channel_listing=listing, quantity=quantity
+    )
+    return line
+
+
+def _orders_with_preorder(order_generator, shipping_method, variant, listing, qtys):
+    for quantity in qtys:
+        order = order_generator()
+        order.shipping_method = shipping_method
+        order.save(update_fields=["shipping_method"])
+        _preorder_line(order, variant, listing, quantity)
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize("orders_count", [2, 10, 40])
+def test_queries_grow_per_preorder_allocation(
+    orders_count, order_generator, product, channel_USD, shipping_zone, warehouse
+):
+    # given
+    shipping_method = shipping_zone.shipping_methods.first()
+    variant, listing = _preorder_variant(product, channel_USD, "A_PREORDER")
+    Stock.objects.create(warehouse=warehouse, product_variant=variant, quantity=1000)
+    _orders_with_preorder(
+        order_generator, shipping_method, variant, listing, [1] * orders_count
+    )
+
+    # when
+    with CaptureQueriesContext(connection) as ctx:
+        deactivate_preorder_for_variants_task()
+
+    # then
+    per_allocation = [
+        q
+        for q in ctx.captured_queries
+        if 'FROM "warehouse_warehouse"' in q["sql"]
+        or ('FROM "warehouse_stock"' in q["sql"] and "FOR UPDATE" in q["sql"])
+        or 'FROM "shipping_shippingmethod"' in q["sql"]
+    ]
+    print(
+        f"orders={orders_count} total_queries={len(ctx.captured_queries)} "
+        f"per-allocation queries={len(per_allocation)}"
+    )
+    # BUG: 3 extra queries for every preorder allocation (N+1), inside the lock
+    assert len(per_allocation) == 3 * orders_count
diff --git a/_repro/tasks/test_preorder_end_two_orders_existing_stock.py b/_repro/tasks/test_preorder_end_two_orders_existing_stock.py
new file mode 100644
index 0000000000..50c5ae15c8
--- /dev/null
+++ b/_repro/tasks/test_preorder_end_two_orders_existing_stock.py
@@ -0,0 +1,139 @@
+"""Ending a preorder that 2+ orders bought under-counts Stock.quantity_allocated.
+
+When a Stock row already exists for the target warehouse,
+`deactivate_preorder_for_variant` fetches a *separate* Stock instance per
+preorder allocation and sets `quantity_allocated = F(...) + qty` on each. Both
+instances are the same DB row; `bulk_update` turns them into one
+`CASE WHEN id=X THEN qa+3 WHEN id=X THEN qa+2 END`, so only the first increment
+is applied. Allocation rows are created for both orders, but the stock counter
+only reflects one of them -> staff (and every other reader of the counter) see
+more free stock than exists, until the nightly
+`update_stocks_quantity_allocated_task` repairs it.
+"""
+
+import datetime
+from decimal import Decimal
+
+import graphene
+import pytest
+from django.db.models import Sum
+from django.utils import timezone
+from prices import Money, TaxedMoney
+
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.product.models import ProductVariant, ProductVariantChannelListing
+from saleor.product.tasks import deactivate_preorder_for_variants_task
+from saleor.warehouse.models import Allocation, PreorderAllocation, Stock
+
+STOCK_QUERY = """
+query ($id: ID!) {
+  stock(id: $id) { quantity quantityAllocated }
+}
+"""
+
+
+def _preorder_variant(product, channel, sku):
+    variant = ProductVariant.objects.create(
+        product=product,
+        sku=sku,
+        is_preorder=True,
+        preorder_global_threshold=1000,
+        preorder_end_date=timezone.now() - datetime.timedelta(hours=2),
+    )
+    listing = ProductVariantChannelListing.objects.create(
+        variant=variant,
+        channel=channel,
+        price_amount=Decimal(10),
+        discounted_price_amount=Decimal(10),
+        cost_price_amount=Decimal(1),
+        currency=channel.currency_code,
+    )
+    return variant, listing
+
+
+def _preorder_line(order, variant, listing, quantity):
+    unit_price = TaxedMoney(
+        net=Money(Decimal(10), order.currency), gross=Money(Decimal(10), order.currency)
+    )
+    line = order.lines.create(
+        product_name=str(variant.product),
+        variant_name=str(variant),
+        product_sku=variant.sku,
+        is_shipping_required=True,
+        is_gift_card=False,
+        quantity=quantity,
+        variant=variant,
+        unit_price=unit_price,
+        total_price=unit_price * quantity,
+        undiscounted_unit_price=unit_price,
+        undiscounted_total_price=unit_price * quantity,
+        base_unit_price=unit_price.gross,
+        undiscounted_base_unit_price=unit_price.gross,
+        tax_rate=Decimal(0),
+    )
+    PreorderAllocation.objects.create(
+        order_line=line, product_variant_channel_listing=listing, quantity=quantity
+    )
+    return line
+
+
+def _orders_with_preorder(order_generator, shipping_method, variant, listing, qtys):
+    for quantity in qtys:
+        order = order_generator()
+        order.shipping_method = shipping_method
+        order.save(update_fields=["shipping_method"])
+        _preorder_line(order, variant, listing, quantity)
+
+
+@pytest.mark.django_db
+def test_two_preorders_with_existing_stock_row_lose_an_allocation(
+    order_generator,
+    product,
+    channel_USD,
+    shipping_zone,
+    warehouse,
+    staff_api_client,
+    permission_manage_products,
+):
+    # given: stock of 5 already received for the preorder variant, and two orders
+    # that pre-ordered 3 + 2 = 5 units (i.e. everything is spoken for)
+    stock_quantity = 5
+    quantities = (3, 2)
+    shipping_method = shipping_zone.shipping_methods.first()
+    variant, listing = _preorder_variant(product, channel_USD, "A_PREORDER")
+    stock = Stock.objects.create(
+        warehouse=warehouse, product_variant=variant, quantity=stock_quantity
+    )
+    _orders_with_preorder(order_generator, shipping_method, variant, listing, quantities)
+
+    # when: the hourly beat task ends the preorder
+    deactivate_preorder_for_variants_task()
+
+    # then: the preorder ended and both orders got an Allocation row ...
+    variant.refresh_from_db(fields=("is_preorder",))
+    assert variant.is_preorder is False
+    allocated_by_rows = Allocation.objects.filter(stock=stock).aggregate(
+        total=Sum("quantity_allocated")
+    )["total"]
+    assert allocated_by_rows == sum(quantities)
+
+    # BUG: ... but the stock counter only got the FIRST order's quantity
+    stock.refresh_from_db(fields=("quantity_allocated",))
+    print(
+        f"allocation rows sum={allocated_by_rows}, "
+        f"stock.quantity_allocated={stock.quantity_allocated}"
+    )
+    assert stock.quantity_allocated == quantities[0]
+    assert stock.quantity_allocated != allocated_by_rows
+
+    # BUG: staff looking at the variant's stock in the dashboard (Stock.quantity /
+    # Stock.quantityAllocated) see 2 of the 5 units as free although all 5 are sold
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        STOCK_QUERY, {"id": graphene.Node.to_global_id("Stock", stock.pk)}
+    )
