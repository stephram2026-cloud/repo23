+    # BUG: a 0.00 granted refund paid out the whole payment
+    assert granted_refund.amount_value == Decimal(0)
+    assert granted_refund.status == OrderGrantedRefundStatus.SUCCESS
+    assert transaction.refunded_value == charged
+    assert transaction.charged_value == Decimal(0)
+    assert gift_card.current_balance_amount == charged
