@@ -0,0 +1,127 @@
+"""Staff restricted to one channel can ship / return lines of another channel's order.
+
+Passes when the problem is present. Uses the repo's own fixtures and the real
+GraphQL endpoint (no mocks).
+"""
+
+import graphene
+
+from saleor.graphql.tests.utils import assert_no_permission, get_graphql_content
+from saleor.order import FulfillmentStatus
+from saleor.order.models import Fulfillment
+
+ORDER_FULFILL = """
+mutation($order: ID, $input: OrderFulfillInput!){
+  orderFulfill(order:$order, input:$input){ fulfillments{ id } errors{ field code message } }
+}"""
+
+RETURN = """
+mutation($order: ID!, $input: OrderReturnProductsInput!){
+  orderFulfillmentReturnProducts(order:$order, input:$input){
+    returnFulfillment{ id } errors{ field code message }
+  }
+}"""
+
+
+def _fulfill_variables(order, line, warehouse):
+    return {
+        "order": graphene.Node.to_global_id("Order", order.pk),
+        "input": {
+            "notifyCustomer": False,
+            "lines": [
+                {
+                    "orderLineId": graphene.Node.to_global_id("OrderLine", line.pk),
+                    "stocks": [
+                        {
+                            "quantity": line.quantity,
+                            "warehouse": graphene.Node.to_global_id(
+                                "Warehouse", warehouse.pk
+                            ),
+                        }
+                    ],
+                }
+            ],
+        },
+    }
+
+
+def test_usd_only_staff_ships_pln_order_line(
+    staff_api_client,
+    permission_group_all_perms_channel_USD_only,
+    order_with_lines,
+    order_with_lines_channel_PLN,
+    warehouse,
+    site_settings,
+):
+    # given: staff member who may only work on the USD channel
+    permission_group_all_perms_channel_USD_only.user_set.add(staff_api_client.user)
+    site_settings.fulfillment_allow_unpaid = True
+    site_settings.save(update_fields=["fulfillment_allow_unpaid"])
+    usd_order, pln_order = order_with_lines, order_with_lines_channel_PLN
+    pln_line = pln_order.lines.first()
+    assert pln_line.quantity_fulfilled == 0
+
+    # control: addressing the PLN order directly is refused
+    response = staff_api_client.post_graphql(
+        ORDER_FULFILL, _fulfill_variables(pln_order, pln_line, warehouse)
+    )
+    assert_no_permission(response)
+    assert Fulfillment.objects.exists() is False
+
+    # when: the same PLN line is sent under the USD order's id
+    response = staff_api_client.post_graphql(
+        ORDER_FULFILL, _fulfill_variables(usd_order, pln_line, warehouse)
+    )
+    content = get_graphql_content(response)
+
+    # then
+    assert content["data"]["orderFulfill"]["errors"] == []
+    pln_line.refresh_from_db(fields=("quantity_fulfilled",))
+    # BUG: a line of an order in a channel this user has no access to was fulfilled
+    assert pln_line.quantity_fulfilled == pln_line.quantity
+    fulfillment = Fulfillment.objects.get()
+    # BUG: ...and the fulfillment record sits on the USD order
+    assert fulfillment.order_id == usd_order.pk
+    assert fulfillment.lines.get().order_line_id == pln_line.pk
+
+
+def test_usd_only_staff_returns_pln_order_line(
+    staff_api_client,
+    permission_group_all_perms_channel_USD_only,
+    order_with_lines,
+    order_with_lines_channel_PLN,
+):
+    # given
+    permission_group_all_perms_channel_USD_only.user_set.add(staff_api_client.user)
+    usd_order, pln_order = order_with_lines, order_with_lines_channel_PLN
+    pln_line = pln_order.lines.first()
+    pln_line_id = graphene.Node.to_global_id("OrderLine", pln_line.pk)
+
+    # control: addressing the PLN order directly is refused
+    response = staff_api_client.post_graphql(
+        RETURN,
+        {
+            "order": graphene.Node.to_global_id("Order", pln_order.pk),
+            "input": {"orderLines": [{"orderLineId": pln_line_id, "quantity": 1}]},
+        },
+    )
+    assert_no_permission(response)
+
+    # when
+    response = staff_api_client.post_graphql(
+        RETURN,
+        {
+            "order": graphene.Node.to_global_id("Order", usd_order.pk),
+            "input": {"orderLines": [{"orderLineId": pln_line_id, "quantity": 1}]},
+        },
+    )
+    content = get_graphql_content(response)
+
+    # then
+    assert content["data"]["orderFulfillmentReturnProducts"]["errors"] == []
+    pln_line.refresh_from_db(fields=("quantity_fulfilled",))
+    # BUG: the PLN order's line was marked as returned by a USD-only user
+    assert pln_line.quantity_fulfilled == 1
+    returned = Fulfillment.objects.get(status=FulfillmentStatus.RETURNED)
+    assert returned.order_id == usd_order.pk
+    assert returned.lines.get().order_line_id == pln_line.pk
