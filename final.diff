+"""orderFulfillmentApprove sent twice at once -> stock taken twice."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, fulfillment_approve, new_order, shop_settings, verdict
+
+shop_settings(fulfillmentAutoApprove=False)
+try:
+    attempts, hits = 5, 0
+    for attempt in range(attempts):
+        variant, stock = make_variant(stock_qty=10)
+        order = new_order([(variant, 4)])
+        res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+        assert not errors_of(res, "orderFulfill"), res
+        order = get_order(order["id"])
+        fulfillment = order["fulfillments"][0]
+        assert fulfillment["status"] == "WAITING_FOR_APPROVAL", fulfillment
+
+        results = fire_concurrently([lambda: fulfillment_approve(fulfillment["id"])] * 2)
+        errs = [errors_of(r, "orderFulfillmentApprove") for r in results]
+        stock_now = get_stocks(variant)[0]
+        bad = stock_now["quantity"] != 6
+        hits += bad
+        print(
+            f"  attempt {attempt + 1}: errors={[e[0]['message'][:60] if e else None for e in errs]} "
+            f"stock 10 -> {stock_now['quantity']} (4 shipped, expected 6) "
+            f"allocated={stock_now['quantityAllocated']} -> {'DOUBLE DEDUCTION' if bad else 'ok'}"
+        )
+    verdict(hits > 0, f"{hits}/{attempts} double approvals deducted stock twice.")
+finally:
+    shop_settings(fulfillmentAutoApprove=True)
