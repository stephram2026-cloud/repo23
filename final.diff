+"""Follow-ups: does the phantom 'allocated' figure block sales? can a leaked allocation be freed?"""
+
+from live import *  # noqa: F403
+from live import DRAFT_COMPLETE, brief, cancel_order, errors_of, new_order, return_products, shop_settings, verdict
+
+# (a) phantom allocated figure from duplicate-variant lines
+variant, stock = make_variant(stock_qty=20)
+order = new_order([(variant, 3), (variant, 2)], force_new_line=True)
+fulfill(order["id"], [(order["lines"][0]["id"], 3), (order["lines"][1]["id"], 2)], stock.warehouse)
+st = get_stocks(variant)[0]
+show("(a) after shipping 5 of 20", st)
+draft = create_draft([(variant, st["quantity"])])
+res = gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False)
+errs = errors_of(res, "draftOrderComplete")
+show(f"(a) ordering all {st['quantity']} remaining units", "accepted" if not errs else errs)
+verdict(not errs, "the phantom figure is display-only: the units can still be sold.")
+
+# (b) leaked allocation after returning an unapproved fulfillment
+shop_settings(fulfillmentAutoApprove=False)
+try:
+    variant, stock = make_variant(stock_qty=10)
+    order = new_order([(variant, 4)])
+    fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+    order = get_order(order["id"])
+    return_products(order["id"], fulfillment_lines=[(order["fulfillments"][0]["lines"][0]["id"], 4)])
+finally:
+    shop_settings(fulfillmentAutoApprove=True)
+show("(b) stock after returning the unapproved shipment", get_stocks(variant)[0])
+draft = create_draft([(variant, 10)])
+res = gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False)
+errs = errors_of(res, "draftOrderComplete")
+show("(b) another order for all 10 units", "accepted" if not errs else [e["message"] for e in errs])
+verdict(bool(errs), "the leaked allocation really blocks sales of those units.")
+res = cancel_order(order["id"])
+show("(b) cancelling the returned order", errors_of(res, "orderCancel") or "ok")
+show("(b) stock after that", get_stocks(variant)[0])
