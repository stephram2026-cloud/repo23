@@ -0,0 +1,34 @@
+"""fulfillmentCancel works on RETURNED fulfillments: restocks + reopens the line."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, fulfillment_cancel, new_order, return_products, verdict
+
+variant, stock = make_variant(stock_qty=10)
+order = new_order([(variant, 4)])
+res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+assert not errors_of(res, "orderFulfill"), res
+order = get_order(order["id"])
+res = return_products(order["id"], fulfillment_lines=[(order["fulfillments"][0]["lines"][0]["id"], 4)])
+assert not errors_of(res, "orderFulfillmentReturnProducts"), res
+order = get_order(order["id"])
+show("after ship + return", brief(order))
+show("stock after ship + return", get_stocks(variant))
+
+returned = next(f for f in order["fulfillments"] if f["status"] == "RETURNED")
+res = fulfillment_cancel(returned["id"], warehouse=stock.warehouse)
+show("fulfillmentCancel(RETURNED) errors", errors_of(res, "orderFulfillmentCancel"))
+order = get_order(order["id"])
+show("after cancelling the return", brief(order))
+show("stock after cancelling the return", get_stocks(variant))
+
+res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], stock.warehouse)
+show("second orderFulfill errors", errors_of(res, "orderFulfill"))
+order = get_order(order["id"])
+show("after shipping again", brief(order))
+show("stock after shipping again", get_stocks(variant))
+verdict(
+    sum(1 for f in order["fulfillments"] if f["status"] == "FULFILLED") == 1
+    and any(f["status"] == "CANCELED" for f in order["fulfillments"]),
+    "a RETURNED fulfillment could be cancelled, which put the goods back in stock, "
+    "re-opened the order line and let the same 4 units be shipped a second time.",
+)
