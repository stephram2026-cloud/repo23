@@ -0,0 +1,157 @@
+from decimal import Decimal
+
+import graphene
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderGrantedRefundStatus
+from saleor.payment import TransactionAction, TransactionEventType
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } status }
+    errors { field code message }
+  }
+}
+"""
+
+GRANT_REFUND_UPDATE = """
+mutation Update($id: ID!, $input: OrderGrantRefundUpdateInput!) {
+  orderGrantRefundUpdate(id: $id, input: $input) {
+    grantedRefund { id transaction { id order { id } } }
+    order { id }
+    errors { field code message }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id order { id } chargedAmount { amount } refundedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_granted_refund_of_order_a_refunds_transaction_of_order_b(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    order_with_lines_for_cc,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """orderGrantRefundUpdate accepts a transaction that belongs to ANOTHER order.
+
+    orderGrantRefundCreate restricts `transactionId` to the order's own transactions,
+    but orderGrantRefundUpdate resolves any TransactionItem. Because the granted refund
+    then already has a transaction assigned, transactionRequestRefundForGrantedRefund
+    skips its "belongs to different order" check and refunds the other order's payment.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+
+    order_a = order_with_lines
+    order_b = order_with_lines_for_cc
+    assert order_a.pk != order_b.pk
+
+    refund_amount = Decimal("10.00")
+    transaction_a = transaction_item_generator(
+        order_id=order_a.pk, charged_value=order_a.total_gross_amount
+    )
+    # order B was paid with a gift card (built-in gateway, no payment app needed)
+    gift_card = gift_card_created_by_staff
+    gift_card.current_balance_amount = Decimal(0)
+    gift_card.save(update_fields=["current_balance_amount"])
+    transaction_b = transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order_b.pk,
+        gift_card=gift_card,
+        charged_value=refund_amount,
+        available_actions=[TransactionAction.REFUND],
+    )
+
+    # granted refund is created for order A (with order A's transaction)
+    response = staff_api_client.post_graphql(
+        GRANT_REFUND_CREATE,
+        {
+            "id": to_global_id_or_none(order_a),
+            "input": {
+                "amount": refund_amount,
+                "transactionId": graphene.Node.to_global_id(
+                    "TransactionItem", transaction_a.token
+                ),
+            },
+        },
+    )
+    data = get_graphql_content(response)["data"]["orderGrantRefundCreate"]
+    assert data["errors"] == []
+    granted_refund_id = data["grantedRefund"]["id"]
+    granted_refund = order_a.granted_refunds.get()
+
+    # when: the granted refund of order A is re-pointed to a transaction of order B
+    response = staff_api_client.post_graphql(
+        GRANT_REFUND_UPDATE,
+        {
+            "id": granted_refund_id,
+            "input": {
+                "transactionId": graphene.Node.to_global_id(
+                    "TransactionItem", transaction_b.token
+                ),
+            },
+        },
+    )
+    data = get_graphql_content(response)["data"]["orderGrantRefundUpdate"]
+
+    # then
+    # BUG: accepted without any error
+    assert data["errors"] == []
+    assert data["order"]["id"] == to_global_id_or_none(order_a)
+    assert data["grantedRefund"]["transaction"]["order"]["id"] == to_global_id_or_none(
+        order_b
+    )
+    granted_refund.refresh_from_db()
+    assert granted_refund.order_id == order_a.pk
+    assert granted_refund.transaction_item_id == transaction_b.pk
+    assert granted_refund.transaction_item.order_id == order_b.pk
+
+    # and when the refund is sent
+    response = staff_api_client.post_graphql(
+        REQUEST_REFUND_FOR_GRANTED_REFUND, {"grantedRefundID": granted_refund_id}
+    )
+    data = get_graphql_content(response)["data"][
+        "transactionRequestRefundForGrantedRefund"
+    ]
+
+    # BUG: no "belongs to different order" error; order B's payment is refunded
+    assert data["errors"] == []
+    assert data["transaction"]["order"]["id"] == to_global_id_or_none(order_b)
+
+    transaction_a.refresh_from_db()
+    transaction_b.refresh_from_db()
+    gift_card.refresh_from_db()
+    order_a.refresh_from_db()
+    order_b.refresh_from_db()
+    granted_refund.refresh_from_db()
+
+    # money went back to the payment method of ORDER B
+    assert transaction_b.refunded_value == refund_amount
+    assert transaction_b.charged_value == Decimal(0)
+    assert gift_card.current_balance_amount == refund_amount
+    assert order_b.total_charged_amount == Decimal(0)
+    assert transaction_b.events.filter(
+        type=TransactionEventType.REFUND_SUCCESS,
+        related_granted_refund=granted_refund,
+    ).exists()
+
+    # order A's payment is untouched, yet its granted refund is shown as done
+    assert transaction_a.charged_value == order_a.total_gross_amount
+    assert transaction_a.refunded_value == Decimal(0)
+    assert order_a.total_charged_amount == order_a.total_gross_amount
+    assert granted_refund.status == OrderGrantedRefundStatus.SUCCESS
diff --git a/_repro/transactions/test_grant_refund_update_resets_manual_amount.py b/_repro/transactions/test_grant_refund_update_resets_manual_amount.py
