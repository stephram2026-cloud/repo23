index 0000000000..1fe94c7856
--- /dev/null
+++ b/_repro/webhooks/test_transaction_request_retry_sends_empty_body.py
@@ -0,0 +1,160 @@
+"""After a 5xx from the payment app, the retried refund/charge/cancel request has an EMPTY body.
+
+`handle_transaction_request_task` sends the request through
+`_send_webhook_request_sync`. On a failed response that helper calls
+`save_unsuccessful_delivery_attempt()` -> `EventPayload.save_as_file()`, which
+assumes the payload still lives in the `payload` text column. For transaction
+requests the payload is already file-backed (`payload == ""`), so `save_as_file()`
+overwrites the stored payload with an empty file. The task then schedules its
+Celery retry (5xx is retryable), and the retry reads the wiped payload and POSTs
+zero bytes to the payment app.
+
+Real HTTP against a loopback server; Celery runs eagerly, so the retry scheduled by
+`handle_webhook_retry` is executed inline and its request is observable.
+"""
+
+from decimal import Decimal
+
+import graphene
+import pytest
+
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.payment import TransactionEventType
+from saleor.payment.models import TransactionEvent, TransactionItem
+from saleor.webhook.event_types import WebhookEventSyncType
+
+REQUEST_ACTION = """
+mutation($id: ID, $action_type: TransactionActionEnum!, $amount: PositiveDecimal) {
+  transactionRequestAction(id: $id, actionType: $action_type, amount: $amount) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+REFUND_SUBSCRIPTION = """
+subscription {
+  event {
+    ... on TransactionRefundRequested {
+      transaction { id pspReference }
+      action { actionType amount }
+    }
+  }
+}
+"""
+
+
+@pytest.mark.parametrize(
+    ("_case", "subscription_query"),
+    [
+        ("legacy_payload_webhook", None),
+        ("subscription_webhook", REFUND_SUBSCRIPTION),
+    ],
+)
+def test_retry_after_5xx_posts_empty_body(
+    _case,
+    subscription_query,
+    local_server,
+    staff_api_client,
+    permission_manage_payments,
+    permission_group_manage_orders,
+    order_with_lines,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_payments)
+    webhook = app.webhooks.create(
+        name="payment app",
+        is_active=True,
+        target_url=f"{local_server.url}/pay",
+        subscription_query=subscription_query,
+    )
+    webhook.events.create(
+        event_type=WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED
+    )
+    psp_reference = "PSP ref"
+    refund_amount = Decimal("10.00")
+    transaction = TransactionItem.objects.create(
+        name="Credit card",
+        psp_reference=psp_reference,
+        available_actions=["refund"],
+        currency="USD",
+        order_id=order_with_lines.pk,
+        charged_value=refund_amount,
+        app_identifier=app.identifier,
+        app=app,
+    )
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # The payment app is briefly unavailable (one 503) and healthy afterwards: it
+    # confirms the refund whenever it receives a request it can parse and answers
+    # 400 to a request without a body.
+    def healthy_app(handler):
+        body = local_server.requests[-1]["body"]
+        if body:
+            status = 200
+            payload = local_server.json(
+                {
+                    "pspReference": "refund-123",
+                    "result": TransactionEventType.REFUND_SUCCESS.upper(),
+                    "amount": str(refund_amount),
+                }
+            )
+        else:
+            status = 400
+            payload = b'{"error": "empty request body"}'
+        handler.send_response(status)
+        handler.send_header("Content-Type", "application/json")
+        handler.send_header("Content-Length", str(len(payload)))
+        handler.end_headers()
+        handler.wfile.write(payload)
+
+    local_server.responses.append((503, b'{"error": "unavailable"}', 0))
+    local_server.default = (200, healthy_app, 0)
+
+    # when
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            REQUEST_ACTION,
+            {
+                "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+                "action_type": TransactionActionEnum.REFUND.name,
+                "amount": refund_amount,
+            },
+        )
+    )
+
+    # then
+    assert content["data"]["transactionRequestAction"]["errors"] == []
+    # first attempt (503) + one Celery retry
+    assert len(local_server.requests) == 2
+    first, retry = local_server.requests
+    assert (
+        retry["headers"]["saleor-event"]
+        == WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED
+    )
+
+    # The first attempt carries the refund request.
+    assert psp_reference in first["body"].decode()
+
+    # BUG: the retry is a POST with no payload at all, so the payment app cannot
+    # know what to refund.
+    assert retry["body"] == b""
+    assert retry["headers"]["content-length"] == "0"
+
+    # BUG: a single transient 503 therefore ends in a failed refund, although the
+    # app was healthy again when the retry arrived.
+    event_types = sorted(
+        TransactionEvent.objects.filter(transaction=transaction).values_list(
+            "type", flat=True
+        )
+    )
+    assert event_types == [
+        TransactionEventType.REFUND_FAILURE,
+        TransactionEventType.REFUND_REQUEST,
+    ]
+    transaction.refresh_from_db(fields=("refunded_value",))
+    assert transaction.refunded_value == Decimal(0)
diff --git a/_repro/webhooks/test_w9_review_no_retry_rule.py b/_repro/webhooks/test_w9_review_no_retry_rule.py
new file mode 100644
index 0000000000..1964b17ca6
--- /dev/null
+++ b/_repro/webhooks/test_w9_review_no_retry_rule.py
@@ -0,0 +1,100 @@
+"""Review of W9: which answers from a webhook receiver are retried, and can a failed
+delivery still be sent again by hand?
+
+Real HTTP against a loopback server; Celery runs eagerly so a scheduled retry shows up
+as a second request.
+"""
+
+import graphene
+import pytest
+
+from saleor.core import EventDeliveryStatus
+from saleor.core.models import EventDelivery, EventPayload
+from saleor.core.telemetry import get_task_context
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.webhook.event_types import WebhookEventAsyncType
+from saleor.webhook.models import Webhook
+from saleor.webhook.transport.asynchronous.transport import send_webhook_request_async
+
+RETRY = """
+mutation Retry($id: ID!) {
+  eventDeliveryRetry(id: $id) { delivery { id } errors { field code message } }
+}
+"""
+
+
+def _delivery(app, local_server):
+    webhook = Webhook.objects.create(
+        name="erp", app=app, target_url=f"{local_server.url}/hook"
+    )
+    payload = EventPayload.objects.create_with_payload_file('{"order": "1"}')
+    return EventDelivery.objects.create(
+        event_type=WebhookEventAsyncType.ORDER_UPDATED, payload=payload, webhook=webhook
+    )
+
+
+def _send(delivery):
+    send_webhook_request_async.apply(
+        kwargs={
+            "event_delivery_id": delivery.pk,
+            "telemetry_context": get_task_context().to_dict(),
+        }
+    )
+
+
+@pytest.mark.parametrize(
+    ("status_code", "expected_requests"),
+    [
+        (302, 1),
+        (400, 1),
+        (401, 1),
+        (404, 1),
+        (408, 1),
+        (409, 1),
+        (429, 1),
+        (500, 2),
+        (502, 2),
+        (503, 2),
+    ],
+)
+def test_which_answers_are_retried(status_code, expected_requests, local_server, app):
+    # given: the first answer is the error, afterwards the receiver answers 200
+    delivery = _delivery(app, local_server)
+    local_server.responses.append((status_code, b"{}", 0))
+
+    # when
+    _send(delivery)
+
+    # then
+    print(f"first answer {status_code}: {len(local_server.requests)} request(s)")
+    assert len(local_server.requests) == expected_requests
+
+
+def test_failed_delivery_is_kept_and_can_be_resent_by_hand(
+    local_server, app, staff_api_client, permission_manage_apps, settings
+):
+    # given: a delivery failed for good on a 429
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    delivery = _delivery(app, local_server)
+    local_server.responses.append((429, b"{}", 0))
+    _send(delivery)
+    delivery.refresh_from_db(fields=("status",))
+    assert delivery.status == EventDeliveryStatus.FAILED
+    assert len(local_server.requests) == 1
+
+    # when: someone with app-management rights retries it
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            RETRY,
+            {"id": graphene.Node.to_global_id("EventDelivery", delivery.pk)},
+            permissions=[permission_manage_apps],
+        )
+    )
+
+    # then: it is sent again with the original body and accepted
+    assert content["data"]["eventDeliveryRetry"]["errors"] == []
+    assert len(local_server.requests) == 2
+    assert local_server.requests[1]["body"] == local_server.requests[0]["body"]
+    assert local_server.requests[1]["body"] == b'{"order": "1"}'
+    print("manual retry: second request sent with the same body:", local_server.requests[1]["body"])
+    print("delivery still stored after success:", EventDelivery.objects.filter(pk=delivery.pk).exists())
