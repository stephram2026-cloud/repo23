@@ -0,0 +1,126 @@
+"""Ending a preorder that 2+ orders bought crashes when no Stock row exists yet.
+
+`deactivate_preorder_for_variant` builds one *unsaved* `Stock(warehouse, variant)`
+per preorder allocation. With two orders that resolve to the same warehouse it
+bulk-creates two rows with the same (warehouse, product_variant) and violates the
+unique constraint. `deactivate_preorder_for_variants_task` (hourly beat) only
+catches `PreorderAllocationError`, so the whole task dies with `IntegrityError`:
+the preorder is never ended, and every other expired preorder that sorts after it
+is never processed either - on every hourly run, forever.
+
+(The `productVariantPreorderDeactivate` mutation no longer exists in this
+checkout - see CHANGELOG.md - so the task is the only way a preorder ends.)
+"""
+
+import datetime
+from decimal import Decimal
+
+import pytest
+from django.db import IntegrityError
+from django.utils import timezone
+from prices import Money, TaxedMoney
+
+from saleor.product.models import ProductVariant, ProductVariantChannelListing
+from saleor.product.tasks import deactivate_preorder_for_variants_task
+from saleor.warehouse.models import Allocation, PreorderAllocation, Stock
+
+
+def _preorder_variant(product, channel, sku):
+    variant = ProductVariant.objects.create(
+        product=product,
+        sku=sku,
+        is_preorder=True,
+        preorder_global_threshold=10,
+        preorder_end_date=timezone.now() - datetime.timedelta(hours=2),
+    )
+    listing = ProductVariantChannelListing.objects.create(
+        variant=variant,
+        channel=channel,
+        price_amount=Decimal(10),
+        discounted_price_amount=Decimal(10),
+        cost_price_amount=Decimal(1),
+        currency=channel.currency_code,
+    )
+    return variant, listing
+
+
+def _preorder_line(order, variant, listing, quantity):
+    unit_price = TaxedMoney(
+        net=Money(Decimal(10), order.currency), gross=Money(Decimal(10), order.currency)
+    )
+    line = order.lines.create(
+        product_name=str(variant.product),
+        variant_name=str(variant),
+        product_sku=variant.sku,
+        is_shipping_required=True,
+        is_gift_card=False,
+        quantity=quantity,
+        variant=variant,
+        unit_price=unit_price,
+        total_price=unit_price * quantity,
+        undiscounted_unit_price=unit_price,
+        undiscounted_total_price=unit_price * quantity,
+        base_unit_price=unit_price.gross,
+        undiscounted_base_unit_price=unit_price.gross,
+        tax_rate=Decimal(0),
+    )
+    PreorderAllocation.objects.create(
+        order_line=line, product_variant_channel_listing=listing, quantity=quantity
+    )
+    return line
+
+
+@pytest.mark.django_db
+def test_two_preorders_without_stock_row_crash_the_hourly_task(
+    order_generator, product, channel_USD, shipping_zone, warehouse
+):
+    # given: a preorder variant whose end date passed, bought by TWO orders
+    shipping_method = shipping_zone.shipping_methods.first()
+    variant_a, listing_a = _preorder_variant(product, channel_USD, "A_PREORDER")
+    for quantity in (3, 2):
+        order = order_generator()
+        order.shipping_method = shipping_method
+        order.save(update_fields=["shipping_method"])
+        _preorder_line(order, variant_a, listing_a, quantity)
+
+    # and: a second, perfectly healthy expired preorder (one order) that sorts
+    # after the first one (ProductVariant default ordering is sort_order, sku)
+    variant_b, listing_b = _preorder_variant(product, channel_USD, "B_PREORDER")
+    order_b = order_generator()
+    order_b.shipping_method = shipping_method
+    order_b.save(update_fields=["shipping_method"])
+    _preorder_line(order_b, variant_b, listing_b, 1)
+
+    assert Stock.objects.filter(product_variant=variant_a).exists() is False
+    assert list(
+        ProductVariant.objects.filter(is_preorder=True).values_list("sku", flat=True)
+    ) == ["A_PREORDER", "B_PREORDER"]
+
+    # when: the hourly beat task runs (three "hours" in a row)
+    errors = []
+    for _hour in range(3):
+        with pytest.raises(IntegrityError) as exc_info:
+            deactivate_preorder_for_variants_task()
+        errors.append(str(exc_info.value))
+
+    # then
+    # BUG: the task dies on the duplicate (warehouse, variant) Stock insert
+    assert all("warehouse_stock_warehouse_id_product_variant_id" in e for e in errors)
+    print("task error:", errors[0].splitlines()[0])
+
+    # BUG: the preorder is still active although its end date passed - nothing
+    # was converted to real stock allocations
+    variant_a.refresh_from_db(fields=("is_preorder",))
+    assert variant_a.is_preorder is True
+    assert PreorderAllocation.objects.filter(
+        product_variant_channel_listing=listing_a
+    ).count() == 2
+    assert Allocation.objects.filter(stock__product_variant=variant_a).exists() is False
+    assert Stock.objects.filter(product_variant=variant_a).exists() is False
+
+    # BUG: the unrelated healthy preorder behind it is starved on every run too
+    variant_b.refresh_from_db(fields=("is_preorder",))
+    assert variant_b.is_preorder is True
+    assert PreorderAllocation.objects.filter(
+        product_variant_channel_listing=listing_b
+    ).count() == 1
diff --git a/_repro/tasks/test_release_funds_overlap_requests_refund_twice.py b/_repro/tasks/test_release_funds_overlap_requests_refund_twice.py
