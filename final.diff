diff --git a/_repro/orders/06_double_fulfill_lost_update.py b/_repro/orders/06_double_fulfill_lost_update.py
new file mode 100644
index 0000000000..25a8592d0c
--- /dev/null
+++ b/_repro/orders/06_double_fulfill_lost_update.py
@@ -0,0 +1,38 @@
+"""Two staff fulfil parts of the same line at once -> fulfilled count is lost."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, new_order, verdict
+
+attempts, hits = 5, 0
+for attempt in range(attempts):
+    variant, stock = make_variant(stock_qty=100)
+    order = new_order([(variant, 10)])
+    line_id = order["lines"][0]["id"]
+
+    # Two people each ship 3 of the 10 units at the same moment.
+    results = fire_concurrently(
+        [lambda: fulfill(order["id"], [(line_id, 3)], stock.warehouse)] * 2
+    )
+    errs = [errors_of(r, "orderFulfill") for r in results]
+    after = get_order(order["id"])
+    shipped = sum(sum(q) for s, q in brief(after)["fulfillments"] if s == "FULFILLED")
+    recorded = after["lines"][0]["quantityFulfilled"]
+    stock_now = get_stocks(variant)[0]
+    lost = shipped != recorded
+    hits += lost
+    print(
+        f"  attempt {attempt + 1}: errors={errs} shipped_in_fulfillments={shipped} "
+        f"line.quantityFulfilled={recorded} stock={stock_now['quantity']} "
+        f"allocated={stock_now['quantityAllocated']} -> {'LOST UPDATE' if lost else 'ok'}"
+    )
+    if lost and hits == 1:
+        # Show the consequence: the "remaining" quantity can now be over-shipped.
+        res = fulfill(order["id"], [(line_id, 10 - recorded)], stock.warehouse)
+        final = get_order(order["id"])
+        total = sum(sum(q) for s, q in brief(final)["fulfillments"] if s == "FULFILLED")
+        show("then shipping the 'remaining' units -> errors", errors_of(res, "orderFulfill"))
+        show("final order", brief(final))
+        show("units shipped vs ordered", f"{total} vs {final['lines'][0]['quantity']}")
+        show("final stock", get_stocks(variant))
+
+verdict(hits > 0, f"{hits}/{attempts} concurrent attempts lost a fulfilled-quantity update.")
diff --git a/_repro/orders/07_double_draft_complete.py b/_repro/orders/07_double_draft_complete.py
new file mode 100644
index 0000000000..1c4a2fc054
--- /dev/null
+++ b/_repro/orders/07_double_draft_complete.py
@@ -0,0 +1,32 @@
+"""draftOrderComplete sent twice at once (double click / two tabs)."""
+
+from live import *  # noqa: F403
+from live import DRAFT_COMPLETE, brief, verdict
+
+attempts, hits = 5, 0
+for attempt in range(attempts):
+    variant, stock = make_variant(stock_qty=100)
+    draft = create_draft([(variant, 4)])
+    results = fire_concurrently(
+        [lambda: gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False)] * 2
+    )
+    outcomes = []
+    for r in results:
+        if "errors" in r:
+            outcomes.append("SERVER ERROR: " + r["errors"][0]["message"][:110])
+        elif r.get("http_status"):
+            outcomes.append(f"HTTP {r['http_status']}")
+        else:
+            errs = r["data"]["draftOrderComplete"]["errors"]
+            outcomes.append("ok" if not errs else f"rejected: {errs[0]['message']}")
+    after = get_order(draft["id"])
+    events = [e["type"] for e in after["events"]]
+    placed = events.count("PLACED_FROM_DRAFT")
+    stock_now = get_stocks(variant)[0]
+    bad = outcomes.count("ok") > 1 or placed > 1 or any("SERVER" in o for o in outcomes) or stock_now["quantityAllocated"] != 4
+    hits += bad
+    print(
+        f"  attempt {attempt + 1}: outcomes={outcomes} PLACED_FROM_DRAFT events={placed} "
+        f"allocated={stock_now['quantityAllocated']} (ordered 4) db_allocations={db_allocations(variant)}"
+    )
+verdict(hits > 0, f"{hits}/{attempts} double submissions were not handled cleanly.")
