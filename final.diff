@@ -0,0 +1,151 @@
+"""Review of P9: which edits of a granted refund change its amount?
+
+Start: a granted refund of 25.00 entered by hand (no lines, shipping not included).
+Each case sends one update and prints the amount afterwards.
+"""
+
+from decimal import Decimal
+
+import graphene
+import pytest
+
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+
+CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+UPDATE = """
+mutation Update($id: ID!, $input: OrderGrantRefundUpdateInput!) {
+  orderGrantRefundUpdate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } reason shippingCostsIncluded }
+    errors { field code message }
+  }
+}
+"""
+
+MANUAL_AMOUNT = Decimal("25.00")
+
+
+def _create(client, order, transaction, **extra):
+    content = get_graphql_content(
+        client.post_graphql(
+            CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {
+                    "reason": "damaged",
+                    "transactionId": graphene.Node.to_global_id(
+                        "TransactionItem", transaction.token
+                    ),
+                    **extra,
+                },
+            },
+        )
+    )
+    data = content["data"]["orderGrantRefundCreate"]
+    assert data["errors"] == []
+    return data["grantedRefund"]["id"]
+
+
+@pytest.mark.parametrize(
+    ("_case", "update_input", "amount_kept"),
+    [
+        ("reason only", {"reason": "damaged in transit"}, True),
+        ("reason, shipping flag null", {"reason": "x", "grantRefundForShipping": None}, True),
+        ("reason and amount repeated, shipping flag false", {"reason": "x", "amount": "25.00", "grantRefundForShipping": False}, True),
+        ("transaction only", {"transactionId": "SAME"}, True),
+        ("reason, shipping flag false, no amount", {"reason": "x", "grantRefundForShipping": False}, False),
+        ("shipping flag true, no amount", {"grantRefundForShipping": True}, False),
+    ],
+)
+def test_manual_amount_after_update(
+    _case,
+    update_input,
+    amount_kept,
+    staff_api_client,
+    permission_group_manage_orders,
+    order_with_lines,
+    transaction_item_generator,
+):
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    transaction = transaction_item_generator(
+        order_id=order.pk, charged_value=order.total_gross_amount
+    )
+    refund_id = _create(staff_api_client, order, transaction, amount=MANUAL_AMOUNT)
+    granted_refund = order.granted_refunds.get()
+    assert granted_refund.amount_value == MANUAL_AMOUNT
+    update_input = dict(update_input)
+    if update_input.get("transactionId") == "SAME":
+        update_input["transactionId"] = graphene.Node.to_global_id(
+            "TransactionItem", transaction.token
+        )
+
+    # when
+    content = get_graphql_content(
+        staff_api_client.post_graphql(UPDATE, {"id": refund_id, "input": update_input})
+    )
+
+    # then
+    assert content["data"]["orderGrantRefundUpdate"]["errors"] == []
+    granted_refund.refresh_from_db()
+    print(
+        f"manual 25.00 | update: {_case} -> amount {granted_refund.amount_value} "
+        f"(order shipping {order.shipping_price_gross_amount})"
+    )
+    assert (granted_refund.amount_value == MANUAL_AMOUNT) is amount_kept
+
+
+def test_hand_adjusted_amount_on_line_based_refund(
+    staff_api_client,
+    permission_group_manage_orders,
+    order_with_lines,
+    transaction_item_generator,
+):
+    # given: one unit of a line granted, amount lowered by hand to 5.00
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    transaction = transaction_item_generator(
+        order_id=order.pk, charged_value=order.total_gross_amount
+    )
+    line = order.lines.first()
+    refund_id = _create(
+        staff_api_client,
+        order,
+        transaction,
+        amount=Decimal("5.00"),
+        lines=[{"id": graphene.Node.to_global_id("OrderLine", line.pk), "quantity": 1}],
+    )
+    granted_refund = order.granted_refunds.get()
+    assert granted_refund.amount_value == Decimal("5.00")
+
+    # when: reason only
+    get_graphql_content(
+        staff_api_client.post_graphql(UPDATE, {"id": refund_id, "input": {"reason": "y"}})
+    )
+    granted_refund.refresh_from_db()
+    after_reason_only = granted_refund.amount_value
+
+    # when: shipping flag false, no amount
+    get_graphql_content(
+        staff_api_client.post_graphql(
+            UPDATE, {"id": refund_id, "input": {"reason": "z", "grantRefundForShipping": False}}
+        )
+    )
+    granted_refund.refresh_from_db()
+
+    # then
+    print(
+        f"line-based, lowered by hand to 5.00 (line unit price {line.unit_price_gross_amount}) | "
+        f"reason only -> {after_reason_only} | shipping flag false, no amount -> {granted_refund.amount_value}"
+    )
+    assert after_reason_only == Decimal("5.00")
+    assert granted_refund.amount_value == line.unit_price_gross_amount
diff --git a/_repro/transactions/test_race_event_report_stale_recalculation.py b/_repro/transactions/test_race_event_report_stale_recalculation.py
new file mode 100644
index 0000000000..0e6f1e02a7
--- /dev/null
+++ b/_repro/transactions/test_race_event_report_stale_recalculation.py
@@ -0,0 +1,103 @@
+from decimal import Decimal
+
+import graphene
+
+from saleor.graphql.payment.enums import TransactionEventTypeEnum
+from saleor.graphql.tests.fixtures import ApiClient
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus
+from saleor.payment import TransactionEventType
+from saleor.tests.race_condition import RunAfter
+
+EVENT_REPORT = """
+mutation Report(
+  $id: ID, $type: TransactionEventTypeEnum!, $amount: PositiveDecimal,
+  $pspReference: String!
+) {
+  transactionEventReport(
+    id: $id, type: $type, amount: $amount, pspReference: $pspReference
+  ) {
+    alreadyProcessed
+    transaction { id chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_second_charge_report_lost_when_two_reports_interleave(
+    app,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """Two transactionEventReport calls for one transaction can lose one charge.
+
+    The row lock in transactionEventReport only covers inserting the event. The
+    amounts are recalculated from the events and written back AFTER the lock is
+    released, from an object loaded before it. If request B (another event) completes
+    between request A's recalculation and A's save, A overwrites B's result.
+
+    Deterministic interleaving (saleor.tests.race_condition.RunAfter on the
+    recalculation step of request A). NOTE: the window is narrow - 400 attempts with
+    two real threads reporting simultaneously (no patching) never hit it.
+    """
+    # given
+    app.permissions.add(permission_manage_payments)
+    order = order_with_lines
+    total = order.total_gross_amount
+    first_part = Decimal("50.00")
+    second_part = total - first_part
+    transaction = transaction_item_generator(order_id=order.pk, app=app)
+    transaction_id = graphene.Node.to_global_id("TransactionItem", transaction.token)
+
+    def report(amount, psp_reference):
+        response = ApiClient(app=app).post_graphql(
+            EVENT_REPORT,
+            {
+                "id": transaction_id,
+                "type": TransactionEventTypeEnum.CHARGE_SUCCESS.name,
+                "amount": amount,
+                "pspReference": psp_reference,
+            },
+        )
+        content = get_graphql_content(response)
+        assert content["data"]["transactionEventReport"]["errors"] == []
+        return content
+
+    def request_b(*args, **kwargs):
+        report(second_part, "psp-charge-2")
+        order.refresh_from_db()
+        transaction.refresh_from_db()
+        # sanity: after request B everything is correct
+        assert transaction.charged_value == total
+        assert order.charge_status == OrderChargeStatus.FULL
+
+    # when
+    with RunAfter(
+        "saleor.graphql.payment.mutations.transaction.transaction_event_report."
+        "recalculate_transaction_amounts",
+        request_b,
+    ):
+        report(first_part, "psp-charge-1")
+
+    # then
+    transaction.refresh_from_db()
+    order.refresh_from_db()
+    charge_events = transaction.events.filter(type=TransactionEventType.CHARGE_SUCCESS)
+    print(
+        "charge events:",
+        sorted(e.amount_value for e in charge_events),
+        "| tx charged:",
+        transaction.charged_value,
+        "| order total_charged:",
+        order.total_charged_amount,
+        "| charge_status:",
+        order.charge_status,
+    )
+    assert sum(e.amount_value for e in charge_events) == total
+    # BUG: only the first charge is reflected; the order looks partially paid
+    assert transaction.charged_value == first_part
+    assert order.total_charged_amount == first_part
+    assert order.charge_status == OrderChargeStatus.PARTIAL
+
