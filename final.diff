@@ -0,0 +1,50 @@
+"""Shared helpers for the transaction/payment repro tests (not a test module)."""
+
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+from django.conf import settings
+from django.db import connections
+
+from saleor.graphql.tests.fixtures import ApiClient
+from saleor.tests.utils import FakeDbReplicaConnection
+
+
+def _prepare_thread_connections():
+    """Give the thread the same DB setup the test main thread has.
+
+    The root conftest replaces the "replica" alias with a wrapper around the writer
+    connection, but only for the main thread (connections are thread-local). Without
+    this a worker thread would try to connect to the non-test replica database.
+    """
+    replica = settings.DATABASE_CONNECTION_REPLICA_NAME
+    connections[replica] = FakeDbReplicaConnection(connections[replica])
+
+
+def run_concurrently(*callables):
+    """Run callables in real threads, released together by a barrier.
+
+    Each thread uses its own DB connection (closed at the end of the thread).
+    Returns the list of results in the order of the callables.
+    """
+    barrier = threading.Barrier(len(callables))
+
+    def _wrap(fn):
+        def _inner():
+            try:
+                _prepare_thread_connections()
+                barrier.wait(timeout=30)
+                return fn()
+            finally:
+                connections.close_all()
+
+        return _inner
+
+    with ThreadPoolExecutor(max_workers=len(callables)) as pool:
+        futures = [pool.submit(_wrap(fn)) for fn in callables]
+        return [f.result(timeout=120) for f in futures]
+
+
+def new_client(user=None, app=None):
+    """Create a separate API client (one per thread, like one per HTTP request)."""
+    return ApiClient(user=user, app=app)
