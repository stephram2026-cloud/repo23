+++ b/_repro/orders/13_return_duplicate_line_ids.py
@@ -0,0 +1,31 @@
+"""Same fulfillment line listed twice in a return -> quantities shift to other lines."""
+
+from live import *  # noqa: F403
+from live import brief, errors_of, new_order, return_products, verdict
+
+variant_a, stock_a = make_variant(stock_qty=10)
+variant_b, stock_b = make_variant(stock_qty=10)
+order = new_order([(variant_a, 2), (variant_b, 5)])
+res = fulfill(
+    order["id"], [(order["lines"][0]["id"], 2), (order["lines"][1]["id"], 5)], stock_a.warehouse
+)
+assert not errors_of(res, "orderFulfill"), res
+order = get_order(order["id"])
+show("order", brief(order))
+by_order_line = {fl["orderLine"]["id"]: fl["id"] for fl in order["fulfillments"][0]["lines"]}
+fl_a = by_order_line[order["lines"][0]["id"]]
+fl_b = by_order_line[order["lines"][1]["id"]]
+
+# Request: return 1 x A, 1 x A (listed twice), 5 x B
+res = return_products(order["id"], fulfillment_lines=[(fl_a, 1), (fl_a, 1), (fl_b, 5)])
+show("return errors", errors_of(res, "orderFulfillmentReturnProducts"))
+after = get_order(order["id"])
+show("order after return", brief(after))
+returned = {
+    fl["orderLine"]["id"]: fl["quantity"]
+    for f in after["fulfillments"] if f["status"] == "RETURNED" for fl in f["lines"]
+}
+got_a, got_b = returned.get(order["lines"][0]["id"], 0), returned.get(order["lines"][1]["id"], 0)
+show("asked to return", "A=2 (1+1), B=5")
+show("actually returned", f"A={got_a}, B={got_b}")
