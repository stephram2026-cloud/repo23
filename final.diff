@@ -0,0 +1,45 @@
+"""Do double-submitted cancel / confirm actions queue duplicate customer emails?"""
+
+import time
+
+from live import *  # noqa: F403
+from live import ORDER_CONFIRM, auto_confirm, cancel_order, new_order, verdict
+
+LOG = "/tmp/celery.log"
+
+
+def received(task):
+    return sum(1 for line in open(LOG, errors="ignore") if f"{task}[" in line and "received" in line)
+
+
+def measure(task, action):
+    before = received(task)
+    action()
+    time.sleep(6)
+    return received(task) - before
+
+
+variant, stock = make_variant(stock_qty=50)
+order = new_order([(variant, 1)])
+single = measure("send_order_canceled_email_task", lambda: cancel_order(order["id"]))
+order = new_order([(variant, 1)])
+double = measure(
+    "send_order_canceled_email_task",
+    lambda: fire_concurrently([lambda: cancel_order(order["id"])] * 2),
+)
+show("cancellation emails queued: one click / double click", f"{single} / {double}")
+
+auto_confirm(False)
+try:
+    order = create_draft([(variant, 1)], complete=True)
+    c_single = measure("send_order_confirmed_email_task", lambda: gql(ORDER_CONFIRM, {"id": order["id"]}))
+    order = create_draft([(variant, 1)], complete=True)
+    c_double = measure(
+        "send_order_confirmed_email_task",
+        lambda: fire_concurrently([lambda: gql(ORDER_CONFIRM, {"id": order["id"]}, check=False)] * 2),
+    )
+finally:
+    auto_confirm(True)
+show("confirmation emails queued: one click / double click", f"{c_single} / {c_double}")
+verdict(double == 2 * single and single > 0, "a double-clicked cancel emails the customer twice.")
+verdict(c_double == 2 * c_single and c_single > 0, "a double-clicked confirm emails the customer twice.")
