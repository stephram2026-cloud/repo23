+++ b/_repro/orders/36_six_checkouts_one_unit.py
@@ -0,0 +1,17 @@
+"""Six paid storefront checkouts completed at once for ONE unit. Reservations OFF."""
+
+from checkout_live import assert_reservations_off, complete_checkout, create_paid_checkout, outcome
+from live import db_allocations, db_stock, fire_concurrently, make_variant
+
+assert_reservations_off()
+for attempt in range(5):
+    variant, _stock = make_variant(stock_qty=1)
+    checkouts = [create_paid_checkout([(variant, 1)]) for _ in range(6)]
+    outcomes = fire_concurrently(
+        [lambda c=c: outcome(complete_checkout(c), "checkoutComplete") for c in checkouts]
+    )
+    stock = db_stock(variant)[0]
+    print(
+        f"  round {attempt + 1}: {outcomes.count('placed')} of 6 orders placed, "
+        f"in stock {stock['quantity']}, allocated {sum(q for _, q in db_allocations(variant))}"
+    )
diff --git a/_repro/orders/checkout_live.py b/_repro/orders/checkout_live.py
new file mode 100644
index 0000000000..393e7b2c03
--- /dev/null
+++ b/_repro/orders/checkout_live.py
@@ -0,0 +1,125 @@
+"""Helpers for placing an order through the storefront checkout API on the live server.
+
+The checkout is paid by recording a charged transaction on it (what a payment app
+does), then completed with checkoutComplete.
+"""
+
+from live import ADDRESS, CHANNEL_SLUG, gid, gql, shipping_method_id
+
+CHECKOUT_CREATE = """
+mutation($input: CheckoutCreateInput!){
+  checkoutCreate(input:$input){
+    checkout{ id totalPrice{ gross{ amount currency } } lines{ id quantity } }
+    errors{ field code message }
+  }
+}"""
+
+CHECKOUT_DELIVERY = """
+mutation($id: ID!, $method: ID!){
+  checkoutDeliveryMethodUpdate(id:$id, deliveryMethodId:$method){
+    checkout{ id totalPrice{ gross{ amount currency } } }
+    errors{ field code message }
+  }
+}"""
+
+CHECKOUT_PAY = """
+mutation($id: ID!, $amount: PositiveDecimal!, $currency: String!){
+  transactionCreate(id:$id, transaction:{name:"repro", pspReference:"", amountCharged:{amount:$amount, currency:$currency}}){
+    transaction{ id }
+    errors{ field code message }
+  }
+}"""
+
+CHECKOUT_COMPLETE = """
+mutation($id: ID!){
+  checkoutComplete(id:$id){
+    order{ id number status }
+    errors{ field code message }
+  }
+}"""
+
+SHOP_RESERVATION = """
+query{ shop{ reserveStockDurationAnonymousUser reserveStockDurationAuthenticatedUser } }"""
+
+RESERVE = """
+mutation($input: ShopSettingsInput!){
+  shopSettingsUpdate(input:$input){
+    shop{ reserveStockDurationAuthenticatedUser reserveStockDurationAnonymousUser }
+    errors{ message }
+  }
+}"""
+
+
+def reservation_setting():
+    return gql(SHOP_RESERVATION)["data"]["shop"]
+
+
+def set_reservation(minutes):
+    gql(
+        RESERVE,
+        {
+            "input": {
+                "reserveStockDurationAuthenticatedUser": minutes,
+                "reserveStockDurationAnonymousUser": minutes,
+            }
+        },
+    )
+
+
+def assert_reservations_off():
+    setting = reservation_setting()
+    assert setting == {
+        "reserveStockDurationAnonymousUser": None,
+        "reserveStockDurationAuthenticatedUser": None,
+    }, setting
+    return setting
+
+
+def create_paid_checkout(lines, force_new_line=False):
+    """`lines` is a list of (variant, quantity). Returns the checkout id, ready to complete."""
+    data = gql(
+        CHECKOUT_CREATE,
+        {
+            "input": {
+                "channel": CHANNEL_SLUG,
+                "email": "customer@example.com",
+                "lines": [
+                    {
+                        "variantId": gid("ProductVariant", v.pk),
+                        "quantity": q,
+                        **({"forceNewLine": True} if force_new_line else {}),
+                    }
+                    for v, q in lines
+                ],
+                "shippingAddress": ADDRESS,
+                "billingAddress": ADDRESS,
+            }
+        },
+    )["data"]["checkoutCreate"]
+    assert not data["errors"], data["errors"]
+    checkout_id = data["checkout"]["id"]
+    data = gql(CHECKOUT_DELIVERY, {"id": checkout_id, "method": shipping_method_id()})[
+        "data"
+    ]["checkoutDeliveryMethodUpdate"]
+    assert not data["errors"], data["errors"]
+    total = data["checkout"]["totalPrice"]["gross"]
+    data = gql(
+        CHECKOUT_PAY,
+        {"id": checkout_id, "amount": total["amount"], "currency": total["currency"]},
+    )["data"]["transactionCreate"]
+    assert not data["errors"], data["errors"]
+    return checkout_id
+
+
+def complete_checkout(checkout_id):
+    return gql(CHECKOUT_COMPLETE, {"id": checkout_id}, check=False)
+
+
+def outcome(response, mutation):
+    """'placed' or the first error code/message of a completion response."""
+    if "errors" in response:
+        return "ERROR " + response["errors"][0]["message"][:70]
+    errors = response["data"][mutation]["errors"]
+    if errors:
+        return errors[0].get("code") or errors[0]["message"][:70]
+    return "placed"
diff --git a/_repro/orders/live.py b/_repro/orders/live.py
new file mode 100644
index 0000000000..94150e0b18
--- /dev/null
+++ b/_repro/orders/live.py
@@ -0,0 +1,479 @@
+"""Helpers for driving the *running* Saleor API server (http://localhost:8000).
+
+Setup data (a throw-away variant with a known stock level) is created through the
+ORM; every operation under test goes over HTTP to the real multi-worker server,
+exactly like the dashboard or an integration would do it.
+"""
+
+import os
+import sys
+import uuid
+from concurrent.futures import ThreadPoolExecutor
+from decimal import Decimal
+from threading import Barrier
+
+import django
+import requests
+
+sys.path.insert(0, "/app")
+os.environ.setdefault("DJANGO_SETTINGS_MODULE", "saleor.settings")
+django.setup()
+
+import graphene  # noqa: E402
+
+from saleor.channel.models import Channel  # noqa: E402
+from saleor.order.models import Order  # noqa: E402
+from saleor.product.models import (  # noqa: E402
+    Product,
+    ProductVariant,
+    ProductVariantChannelListing,
+)
+from saleor.shipping.models import ShippingMethod  # noqa: E402
+from saleor.warehouse.models import Allocation, Stock, Warehouse  # noqa: E402
+
+API = os.environ.get("SALEOR_API", "http://localhost:8000/graphql/")
+CHANNEL_SLUG = "default-channel"
+
+_token = None
+
+
+def token():
+    global _token
+    if _token is None:
+        r = requests.post(
+            API,
+            json={
+                "query": 'mutation{tokenCreate(email:"admin@example.com",password:"admin"){token errors{message}}}'
+            },
+            timeout=30,
+        )
+        _token = r.json()["data"]["tokenCreate"]["token"]
+        assert _token, r.text
+    return _token
+
+
+def gql(query, variables=None, check=True):
+    r = requests.post(
+        API,
+        json={"query": query, "variables": variables or {}},
+        headers={"Authorization": f"Bearer {token()}"},
+        timeout=120,
+    )
+    try:
+        body = r.json()
+    except ValueError:
+        return {"http_status": r.status_code, "text": r.text[:500]}
+    if check and "errors" in body:
+        raise AssertionError(f"GraphQL errors: {body['errors']}")
+    return body
+
+
+def gid(type_name, pk):
+    return graphene.Node.to_global_id(type_name, pk)
+
+
+def channel():
+    return Channel.objects.get(slug=CHANNEL_SLUG)
+
+
+def warehouses():
+    """Warehouses that serve the default channel."""
+    return list(
+        Warehouse.objects.filter(
+            channels__slug=CHANNEL_SLUG, shipping_zones__countries__contains="US"
+        )
+        .distinct()
+        .order_by("pk")
+    )
+
+
+def make_variant(stock_qty, price="10.00", warehouse=None, sku=None):
+    """Create a throw-away variant with `stock_qty` units in one warehouse."""
+    ch = channel()
+    product = (
+        Product.objects.filter(
+            channel_listings__channel=ch,
+            channel_listings__is_published=True,
+            product_type__is_shipping_required=True,
+        )
+        .exclude(product_type__kind="gift_card")
+        .order_by("pk")
+        .first()
+    )
+    sku = sku or f"REPRO-{uuid.uuid4().hex[:10]}"
+    variant = ProductVariant.objects.create(
+        product=product, sku=sku, name=sku, track_inventory=True
+    )
+    ProductVariantChannelListing.objects.create(
+        variant=variant,
+        channel=ch,
+        price_amount=Decimal(price),
+        discounted_price_amount=Decimal(price),
+        currency=ch.currency_code,
+    )
+    wh = warehouse or warehouses()[0]
+    stock = Stock.objects.create(
+        warehouse=wh, product_variant=variant, quantity=stock_qty
+    )
+    return variant, stock
+
+
+ADDRESS = {
+    "firstName": "Repro",
+    "lastName": "Tester",
+    "streetAddress1": "8559 Lake Avenue",
+    "city": "New York",
+    "postalCode": "10001",
+    "country": "US",
+    "countryArea": "NY",
+}
+
+DRAFT_CREATE = """
+mutation($input: DraftOrderCreateInput!){
+  draftOrderCreate(input:$input){
+    order{ id status lines{ id quantity variant{ id sku } } }
+    errors{ field code message }
+  }
+}"""
+
+DRAFT_COMPLETE = """
+mutation($id: ID!){
+  draftOrderComplete(id:$id){
+    order{ id status number }
+    errors{ field code message }
+  }
+}"""
+
+ORDER_QUERY = """
+query($id: ID!){
+  order(id:$id){
+    id number status paymentStatus chargeStatus
+    total{ gross{ amount } } totalCharged{ amount } totalBalance{ amount }
+    lines{ id quantity quantityFulfilled quantityToFulfill variant{ sku }
+           allocations{ quantity warehouse{ id name } } }
+    fulfillments{ id status lines{ id quantity orderLine{ id } } }
+    events{ type }
+    transactions{ id chargedAmount{ amount } }
+  }
+}"""
+
+STOCK_QUERY = """
+query($id: ID!){
+  productVariant(id:$id){
+    sku
+    stocks{ quantity quantityAllocated warehouse{ id name } }
+  }
+}"""
+
+FULFILL = """
+mutation($order: ID, $input: OrderFulfillInput!){
+  orderFulfill(order:$order, input:$input){
+    fulfillments{ id status lines{ id quantity } }
+    errors{ field code message }
+  }
+}"""
+
+
+def shipping_method_id():
+    method = (
+        ShippingMethod.objects.filter(
+            channel_listings__channel__slug=CHANNEL_SLUG,
+            shipping_zone__countries__contains="US",
+            shipping_zone__channels__slug=CHANNEL_SLUG,
+        )
+        .order_by("pk")
+        .first()
+    )
+    return gid("ShippingMethod", method.pk) if method else None
+
+
+def create_draft(lines, complete=False, force_new_line=False):
+    """`lines` is a list of (variant, quantity). Returns the order dict."""
+    line_input = [
+        {
+            "variantId": gid("ProductVariant", v.pk),
+            "quantity": q,
+            **({"forceNewLine": True} if force_new_line else {}),
+        }
+        for v, q in lines
+    ]
+    data = gql(
+        DRAFT_CREATE,
+        {
+            "input": {
+                "channelId": gid("Channel", channel().pk),
+                "userEmail": "customer@example.com",
+                "lines": line_input,
+                "shippingAddress": ADDRESS,
+                "billingAddress": ADDRESS,
+                "shippingMethod": shipping_method_id(),
+            }
+        },
+    )["data"]["draftOrderCreate"]
+    assert not data["errors"], data["errors"]
+    order = data["order"]
+    if complete:
+        done = gql(DRAFT_COMPLETE, {"id": order["id"]})["data"]["draftOrderComplete"]
+        assert not done["errors"], done["errors"]
+    return get_order(order["id"])
+
+
+def get_order(order_id):
+    return gql(ORDER_QUERY, {"id": order_id})["data"]["order"]
+
+
+def get_stocks(variant):
+    data = gql(STOCK_QUERY, {"id": gid("ProductVariant", variant.pk)})
+    return data["data"]["productVariant"]["stocks"]
+
+
+def fulfill(order_id, line_quantities, warehouse, **extra):
+    """`line_quantities` is a list of (order_line_global_id, quantity)."""
+    return gql(
+        FULFILL,
+        {
+            "order": order_id,
+            "input": {
+                "lines": [
+                    {
+                        "orderLineId": line_id,
+                        "stocks": [
+                            {
+                                "quantity": qty,
+                                "warehouse": gid("Warehouse", warehouse.pk),
+                            }
+                        ],
+                    }
+                    for line_id, qty in line_quantities
+                ],
+                "notifyCustomer": False,
+                **extra,
+            },
+        },
+        check=False,
+    )
+
+
+def order_pk(order_id):
+    return graphene.Node.from_global_id(order_id)[1]
+
+
+def db_allocations(variant):
+    """Raw allocation rows for a variant: [(order_number, quantity_allocated)]."""
+    return list(
+        Allocation.objects.filter(stock__product_variant=variant)
+        .order_by("pk")
+        .values_list("order_line__order__number", "quantity_allocated")
+    )
+
+
+def db_stock(variant):
+    return list(
+        Stock.objects.filter(product_variant=variant)
+        .order_by("pk")
+        .values("quantity", "quantity_allocated")
+    )
+
+
+def fire_concurrently(calls):
+    """Run the given zero-arg callables at the same instant; return their results."""
+    barrier = Barrier(len(calls))
+
+    def run(fn):
+        barrier.wait()
+        return fn()
+
+    with ThreadPoolExecutor(max_workers=len(calls)) as pool:
+        return list(pool.map(run, calls))
+
+
+def show(title, value):
+    print(f"  {title}: {value}")
+
+
+__all__ = [
+    "Order",
+    "Allocation",
+    "Stock",
+    "gql",
+    "gid",
+    "make_variant",
+    "create_draft",
+    "get_order",
+    "get_stocks",
+    "fulfill",
+    "fire_concurrently",
+    "show",
+    "warehouses",
+    "db_allocations",
+    "db_stock",
+    "order_pk",
+    "channel",
+]
+
+
+MARK_PAID = """
+mutation($id: ID!){
+  orderMarkAsPaid(id:$id){ order{ id chargeStatus totalCharged{ amount } } errors{ field code message } }
+}"""
+
+ORDER_CANCEL = """
+mutation($id: ID!){ orderCancel(id:$id){ order{ id status } errors{ field code message } } }"""
+
+RETURN = """
+mutation($order: ID!, $input: OrderReturnProductsInput!){
+  orderFulfillmentReturnProducts(order:$order, input:$input){
+    returnFulfillment{ id status lines{ id quantity orderLine{ id } } }
+    replaceOrder{ id status number total{ gross{ amount } } lines{ quantity unitPrice{ gross{ amount } } } }
+    order{ id status }
+    errors{ field code message }
+  }
+}"""
+
+FULFILLMENT_CANCEL = """
+mutation($id: ID!, $input: FulfillmentCancelInput){
+  orderFulfillmentCancel(id:$id, input:$input){
+    fulfillment{ id status } order{ id status } errors{ field code message }
+  }
+}"""
+
+FULFILLMENT_APPROVE = """
+mutation($id: ID!){
+  orderFulfillmentApprove(id:$id, notifyCustomer:false){
+    fulfillment{ id status } order{ id status } errors{ field code message }
+  }
+}"""
+
+SHOP_SETTINGS = """
+mutation($input: ShopSettingsInput!){
+  shopSettingsUpdate(input:$input){
+    shop{ fulfillmentAutoApprove fulfillmentAllowUnpaid } errors{ field code message }
+  }
+}"""
+
+
+def mark_paid(order_id):
+    return gql(MARK_PAID, {"id": order_id}, check=False)
+
+
+def cancel_order(order_id):
+    return gql(ORDER_CANCEL, {"id": order_id}, check=False)
+
+
+def return_products(order_id, order_lines=(), fulfillment_lines=(), **extra):
+    payload = dict(extra)
+    if order_lines:
+        payload["orderLines"] = [
+            {"orderLineId": i, "quantity": q, **opts} for i, q, *rest in order_lines
+            for opts in [rest[0] if rest else {}]
+        ]
+    if fulfillment_lines:
+        payload["fulfillmentLines"] = [
+            {"fulfillmentLineId": i, "quantity": q, **opts}
+            for i, q, *rest in fulfillment_lines
+            for opts in [rest[0] if rest else {}]
+        ]
+    return gql(RETURN, {"order": order_id, "input": payload}, check=False)
+
+
+def fulfillment_cancel(fulfillment_id, warehouse=None):
+    variables = {"id": fulfillment_id}
+    if warehouse is not None:
+        variables["input"] = {"warehouseId": gid("Warehouse", warehouse.pk)}
+    return gql(FULFILLMENT_CANCEL, variables, check=False)
+
+
+def fulfillment_approve(fulfillment_id):
+    return gql(FULFILLMENT_APPROVE, {"id": fulfillment_id}, check=False)
+
+
+def shop_settings(**settings):
+    res = gql(SHOP_SETTINGS, {"input": settings})["data"]["shopSettingsUpdate"]
+    assert not res["errors"], res["errors"]
+    return res["shop"]
+
+
+def new_order(lines, paid=True, **kwargs):
+    """Draft order -> completed (-> marked as paid), all through the API."""
+    order = create_draft(lines, complete=True, **kwargs)
+    if paid:
+        res = mark_paid(order["id"])["data"]["orderMarkAsPaid"]
+        assert not res["errors"], res["errors"]
+    return get_order(order["id"])
+
+
+def brief(order):
+    """Compact one-line view of an order as the dashboard would show it."""
+    return {
+        "number": order["number"],
+        "status": order["status"],
+        "charge": order["chargeStatus"],
+        "lines": [
+            (l["variant"]["sku"] if l["variant"] else None, l["quantity"], l["quantityFulfilled"])
+            for l in order["lines"]
+        ],
+        "fulfillments": [
+            (f["status"], [fl["quantity"] for fl in f["lines"]])
+            for f in order["fulfillments"]
+        ],
+    }
+
+
+def errors_of(response, mutation):
+    if "errors" in response:
+        return response["errors"]
+    return response["data"][mutation]["errors"]
+
+
+def verdict(reproduced, text):
+    print(("REPRODUCED: " if reproduced else "NOT REPRODUCED: ") + text)
+
+
+CHANNEL_SETTINGS = """
+mutation($id: ID!, $input: ChannelUpdateInput!){
+  channelUpdate(id:$id, input:$input){ channel{ orderSettings{ automaticallyConfirmAllNewOrders } } errors{ field message } }
+}"""
+
+LINE_UPDATE = """
+mutation($id: ID!, $quantity: Int!){
+  orderLineUpdate(id:$id, input:{quantity:$quantity}){ orderLine{ id quantity } errors{ field code message } }
+}"""
+
+LINES_CREATE = """
+mutation($id: ID!, $input: [OrderLineCreateInput!]!){
+  orderLinesCreate(id:$id, input:$input){ orderLines{ id quantity } errors{ field code message } }
+}"""
+
+LINE_DELETE = """
+mutation($id: ID!){ orderLineDelete(id:$id){ order{ id } errors{ field code message } } }"""
+
+ORDER_CONFIRM = """
+mutation($id: ID!){ orderConfirm(id:$id){ order{ id status } errors{ field code message } } }"""
+
+
+def auto_confirm(enabled):
+    res = gql(
+        CHANNEL_SETTINGS,
+        {
+            "id": gid("Channel", channel().pk),
+            "input": {"orderSettings": {"automaticallyConfirmAllNewOrders": enabled}},
+        },
+    )["data"]["channelUpdate"]
+    assert not res["errors"], res["errors"]
+
+
+def line_update(line_id, quantity):
+    return gql(LINE_UPDATE, {"id": line_id, "quantity": quantity}, check=False)
+
+
+def lines_create(order_id, variant, quantity, **opts):
+    return gql(
+        LINES_CREATE,
+        {
+            "id": order_id,
+            "input": [
+                {"variantId": gid("ProductVariant", variant.pk), "quantity": quantity, **opts}
+            ],
+        },
+        check=False,
+    )
