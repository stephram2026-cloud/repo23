--- /dev/null
+++ b/_repro/transactions/test_grant_refund_update_resets_manual_amount.py
@@ -0,0 +1,102 @@
+from decimal import Decimal
+
+import graphene
+
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } }
+    order { chargeStatus }
+    errors { field code message }
+  }
+}
+"""
+
+GRANT_REFUND_UPDATE = """
+mutation Update($id: ID!, $input: OrderGrantRefundUpdateInput!) {
+  orderGrantRefundUpdate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } reason shippingCostsIncluded }
+    order { chargeStatus }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_manual_amount_reset_to_zero_when_shipping_flag_is_sent_as_false(
+    staff_api_client,
+    permission_group_manage_orders,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """Reason edit sent together with grantRefundForShipping: false zeroes the amount.
+
+    Reviewed: a reason-only edit does NOT change the amount, and this recalculation is
+    what the API description states. See test_p9_review_grant_refund_update_amount.py.
+
+    A granted refund created with a manual amount (no lines) loses its amount when an
+    update carries `grantRefundForShipping: false` without `amount`: the amount is
+    recomputed from the (empty) lines.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    transaction = transaction_item_generator(
+        order_id=order.pk, charged_value=order.total_gross_amount
+    )
+    manual_amount = Decimal("25.00")
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            GRANT_REFUND_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {
+                    "amount": manual_amount,
+                    "reason": "damaged",
+                    "transactionId": graphene.Node.to_global_id(
+                        "TransactionItem", transaction.token
+                    ),
+                },
+            },
+        )
+    )
+    data = content["data"]["orderGrantRefundCreate"]
+    assert data["errors"] == []
+    granted_refund = order.granted_refunds.get()
+    assert granted_refund.amount_value == manual_amount
+    assert granted_refund.shipping_costs_included is False
+    order.refresh_from_db()
+    assert order.charge_status == OrderChargeStatus.OVERCHARGED
+
+    # when
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            GRANT_REFUND_UPDATE,
+            {
+                "id": data["grantedRefund"]["id"],
+                "input": {"reason": "damaged in transit", "grantRefundForShipping": False},
+            },
+        )
+    )
+
+    # then
+    data = content["data"]["orderGrantRefundUpdate"]
+    assert data["errors"] == []
+    granted_refund.refresh_from_db()
+    order.refresh_from_db()
+    print(
+        "amount before:",
+        manual_amount,
+        "| amount after:",
+        granted_refund.amount_value,
+        "| charge_status:",
+        order.charge_status,
+    )
+    assert granted_refund.reason == "damaged in transit"
+    # the 25.00 granted refund became 0 (recalculated from no lines, shipping off)
+    assert granted_refund.amount_value == Decimal(0)
+    assert order.charge_status == OrderChargeStatus.FULL
diff --git a/_repro/transactions/test_mark_as_paid_transaction_cannot_be_refunded.py b/_repro/transactions/test_mark_as_paid_transaction_cannot_be_refunded.py
