+res = gql(REFUND_PRODUCTS, {"order": order["id"], "input": {"orderLines": [{"orderLineId": order["lines"][0]["id"], "quantity": 1}]}}, check=False)
+show("orderFulfillmentRefundProducts", res.get("errors") or res["data"]["orderFulfillmentRefundProducts"])
+res = return_products(order["id"], order_lines=[(order["lines"][0]["id"], 1)], refund=True)
