+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.channel import MarkAsPaidStrategy
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus, OrderEvents
+
+MARK_ORDER_AS_PAID_MUTATION = """
+mutation markPaid($id: ID!, $transaction: String) {
+  orderMarkAsPaid(id: $id, transactionReference: $transaction) {
+    errors { field message code }
+    order { isPaid }
+  }
+}
+"""
+
+
+@pytest.mark.django_db(transaction=True)
+@pytest.mark.parametrize(
+    ("_case", "strategy"),
+    [
+        ("transaction flow", MarkAsPaidStrategy.TRANSACTION_FLOW),
+        ("legacy payment flow", MarkAsPaidStrategy.PAYMENT_FLOW),
+    ],
+)
+def test_two_concurrent_mark_as_paid_record_payment_twice(
+    _case,
+    strategy,
+    staff_user,
+    permission_group_manage_orders,
+    order_with_lines,
+):
+    """Two concurrent orderMarkAsPaid calls both pass the "has no payments" check.
+
+    Real threads, two independent requests (double click / two staff members).
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_user)
+    order = order_with_lines
+    channel = order.channel
+    channel.order_mark_as_paid_strategy = strategy
+    channel.save(update_fields=["order_mark_as_paid_strategy"])
+    assert order.payments.exists() is False
+    assert order.payment_transactions.exists() is False
+    total = order.total_gross_amount
+
+    variables = {"id": graphene.Node.to_global_id("Order", order.pk)}
+
+    def mark_as_paid():
+        client = new_client(user=staff_user)
+        return get_graphql_content(
+            client.post_graphql(MARK_ORDER_AS_PAID_MUTATION, variables)
+        )
+
+    # when
+    results = run_concurrently(mark_as_paid, mark_as_paid)
+
+    # then
+    errors = [r["data"]["orderMarkAsPaid"]["errors"] for r in results]
+    order.refresh_from_db()
+    payment_count = order.payments.count()
+    transaction_count = order.payment_transactions.count()
+    print(
+        _case,
+        "| errors:",
+        errors,
+        "| payments:",
+        payment_count,
+        "| transactions:",
+        transaction_count,
+        "| total:",
+        total,
+        "| total_charged:",
+        order.total_charged_amount,
+        "| charge_status:",
+        order.charge_status,
+    )
+
+    # BUG: both requests succeeded
+    assert errors == [[], []]
+    # BUG: the order holds two manual payments / transactions for the full total
+    assert payment_count + transaction_count == 2
+    assert (
+        order.events.filter(type=OrderEvents.ORDER_MARKED_AS_PAID).count() == 2
+    )
+    if strategy == MarkAsPaidStrategy.TRANSACTION_FLOW:
+        charged = sum(t.charged_value for t in order.payment_transactions.all())
+    else:
+        charged = sum(p.captured_amount for p in order.payments.all())
+    assert charged == 2 * total
+    # The order row itself ends up as either 1x (stale write of the slower request)
+    # or 2x the total - in both cases it is wrong for one of the two views.
+    assert order.total_charged_amount in (total, 2 * total)
+    assert order.charge_status in (OrderChargeStatus.FULL, OrderChargeStatus.OVERCHARGED)
