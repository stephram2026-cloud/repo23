@@ -0,0 +1,89 @@
+"""Cause check for the last-unit double sale, no timing involved.
+
+`allocate_stocks` is the locked step that is supposed to refuse an order when the
+stock is already promised to other orders. Checkout completion always calls it with
+`check_reservations=True`, whatever the shop's reservation setting is.
+"""
+
+import pytest
+
+from saleor.core.exceptions import InsufficientStock
+from saleor.warehouse.management import allocate_stocks
+from saleor.warehouse.models import Allocation
+from saleor.warehouse.reservations import is_reservation_enabled
+from saleor.order.fetch import OrderLineInfo
+
+COUNTRY_CODE = "US"
+
+
+@pytest.fixture
+def last_unit_taken(order_line, stock):
+    """One unit in stock, already allocated to another order line."""
+    stock.quantity = 1
+    stock.quantity_allocated = 1
+    stock.save(update_fields=["quantity", "quantity_allocated"])
+    Allocation.objects.filter(stock=stock).delete()
+    Allocation.objects.create(order_line=order_line, stock=stock, quantity_allocated=1)
+    return stock
+
+
+def _second_line(order_line):
+    second = order_line
+    first_pk = order_line.pk
+    second.pk = None
+    second.save()
+    assert second.pk != first_pk
+    return second
+
+
+def test_draft_path_refuses_when_unit_already_allocated(
+    order_line, last_unit_taken, channel_USD, site_settings
+):
+    # given: reservations off, the only unit is allocated to another line
+    assert is_reservation_enabled(site_settings) is False
+    stock = last_unit_taken
+    line = _second_line(order_line)
+    line_info = OrderLineInfo(line=line, variant=line.variant, quantity=1)
+
+    # when: allocating the way draft completion does with reservations off
+    with pytest.raises(InsufficientStock):
+        allocate_stocks(
+            [line_info],
+            COUNTRY_CODE,
+            channel_USD,
+            site_settings=site_settings,
+            requestor=None,
+            calculate_stocks_with_shipping_zones=True,
+            check_reservations=False,
+        )
+
+    # then: nothing extra was allocated
+    stock.refresh_from_db(fields=("quantity", "quantity_allocated"))
+    assert (stock.quantity, stock.quantity_allocated) == (1, 1)
+
+
+def test_checkout_path_allocates_unit_that_is_already_allocated(
+    order_line, last_unit_taken, channel_USD, site_settings
+):
+    # given: reservations off, the only unit is allocated to another line
+    assert is_reservation_enabled(site_settings) is False
+    stock = last_unit_taken
+    line = _second_line(order_line)
+    line_info = OrderLineInfo(line=line, variant=line.variant, quantity=1)
+
+    # when: allocating the way checkout completion does (flag is always True there)
+    allocate_stocks(
+        [line_info],
+        COUNTRY_CODE,
+        channel_USD,
+        site_settings=site_settings,
+        requestor=None,
+        calculate_stocks_with_shipping_zones=True,
+        check_reservations=True,
+        checkout_lines=[],
+    )
+
+    # then: no InsufficientStock; two units are now allocated against one in stock
+    stock.refresh_from_db(fields=("quantity", "quantity_allocated"))
+    assert (stock.quantity, stock.quantity_allocated) == (1, 2)
+    assert Allocation.objects.filter(stock=stock).count() == 2
