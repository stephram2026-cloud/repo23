+"""Sanity check (NOT a bug repro): is an order findable right after staff create/edit it?
+
+There is no background task for the order search index - mutations update
+`Order.search_vector` synchronously. This checks the staff-facing happy paths.
+"""
+
+import graphene
+import pytest
+
+from saleor.graphql.tests.utils import get_graphql_content
+
+ORDERS_SEARCH = """
+query ($search: String!) {
+  orders(first: 10, search: $search) { edges { node { id } } }
+}
+"""
+DRAFTS_SEARCH = """
+query ($search: String!) {
+  draftOrders(first: 10, search: $search) { edges { node { id } } }
+}
+"""
+DRAFT_CREATE = """
+mutation ($input: DraftOrderCreateInput!) {
+  draftOrderCreate(input: $input) { order { id } errors { field message } }
+}
+"""
+ORDER_UPDATE = """
+mutation ($id: ID!, $input: OrderUpdateInput!) {
+  orderUpdate(id: $id, input: $input) { order { id } errors { field message } }
+}
+"""
+LINES_CREATE = """
+mutation ($id: ID!, $variantId: ID!) {
+  orderLinesCreate(id: $id, input: [{variantId: $variantId, quantity: 1}]) {
+    orderLines { id } errors { field message }
+  }
+}
+"""
+NOTE_ADD = """
+mutation ($id: ID!, $message: String!) {
+  orderNoteAdd(order: $id, input: {message: $message}) {
+    order { id } errors { field message }
+  }
+}
+"""
+
+
+def _found(client, query, key, search):
+    content = get_graphql_content(client.post_graphql(query, {"search": search}))
+    return [edge["node"]["id"] for edge in content["data"][key]["edges"]]
+
+
+@pytest.mark.django_db
+def test_created_and_edited_orders_are_findable(
+    staff_api_client,
+    permission_group_manage_orders,
+    channel_USD,
+    order_with_lines,
+    draft_order_list,
+    product_with_single_variant,
+    graphql_address_data,
+):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # newly created draft is findable by customer email
+    new_email = "brand.new.customer@example.com"
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            DRAFT_CREATE,
+            {
+                "input": {
+                    "channelId": graphene.Node.to_global_id("Channel", channel_USD.pk),
+                    "userEmail": new_email,
+                }
+            },
+        )
+    )
+    assert content["data"]["draftOrderCreate"]["errors"] == []
+    draft_id = content["data"]["draftOrderCreate"]["order"]["id"]
+    assert _found(staff_api_client, DRAFTS_SEARCH, "draftOrders", new_email) == [
+        draft_id
+    ]
+
+    # edited order: new email + new address
+    order_id = graphene.Node.to_global_id("Order", order_with_lines.pk)
+    edited_email = "edited.address@example.com"
+    address = {**graphql_address_data, "lastName": "Zzyzxsurname"}
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            ORDER_UPDATE,
+            {
+                "id": order_id,
+                "input": {"userEmail": edited_email, "shippingAddress": address},
+            },
+        )
+    )
+    assert content["data"]["orderUpdate"]["errors"] == []
+    assert _found(staff_api_client, ORDERS_SEARCH, "orders", edited_email) == [order_id]
+    assert _found(staff_api_client, ORDERS_SEARCH, "orders", "Zzyzxsurname") == [
+        order_id
+    ]
+
+    # note added
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            NOTE_ADD, {"id": order_id, "message": "quokkafragile handle with care"}
+        )
+    )
+    assert content["data"]["orderNoteAdd"]["errors"] == []
+    assert _found(staff_api_client, ORDERS_SEARCH, "orders", "quokkafragile") == [
+        order_id
+    ]
+
+    # line added to the new draft -> findable by SKU
+    variant = product_with_single_variant.variants.get()
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            LINES_CREATE,
+            {
+                "id": draft_id,
+                "variantId": graphene.Node.to_global_id("ProductVariant", variant.pk),
+            },
+        )
+    )
+    assert content["data"]["orderLinesCreate"]["errors"] == []
+    assert draft_id in _found(staff_api_client, DRAFTS_SEARCH, "draftOrders", variant.sku)
