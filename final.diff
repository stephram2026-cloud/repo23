+
+attempts, hits = 8, 0
+for attempt in range(attempts):
+    variant, stock = make_variant(stock_qty=50)
+    draft = create_draft([(variant, 2)])
+    line_id = draft["lines"][0]["id"]
+    r_complete, r_update = fire_concurrently(
+        [
+            lambda: gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False),
+            lambda: line_update(line_id, 9),
+        ]
+    )
+    e_complete = errors_of(r_complete, "draftOrderComplete")
+    e_update = errors_of(r_update, "orderLineUpdate")
+    after = get_order(draft["id"])
