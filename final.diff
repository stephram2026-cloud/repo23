diff --git a/_repro/orders/33_last_unit_reservations_off.py b/_repro/orders/33_last_unit_reservations_off.py
new file mode 100644
index 0000000000..407048e485
--- /dev/null
+++ b/_repro/orders/33_last_unit_reservations_off.py
@@ -0,0 +1,95 @@
+"""Can the last unit be sold twice while stock reservation is switched OFF?
+
+Every scenario starts from a fresh product with exactly ONE unit in stock and checks
+the shop's reservation setting is off before it runs. "Sold twice" is judged from the
+database: more units allocated to placed orders than the warehouse holds.
+"""
+
+import sys
+
+from checkout_live import (
+    assert_reservations_off,
+    complete_checkout,
+    create_paid_checkout,
+    outcome,
+)
+from live import (
+    DRAFT_COMPLETE,
+    create_draft,
+    db_allocations,
+    db_stock,
+    fire_concurrently,
+    gql,
+    make_variant,
+)
+
+ROUNDS = int(sys.argv[1]) if len(sys.argv) > 1 else 20
+
+
+def complete_draft(draft):
+    return outcome(gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False), "draftOrderComplete")
+
+
+def finish_checkout(checkout_id):
+    return outcome(complete_checkout(checkout_id), "checkoutComplete")
+
+
+def state(variant):
+    stock = db_stock(variant)[0]
+    allocations = db_allocations(variant)
+    allocated = sum(q for _, q in allocations)
+    return stock["quantity"], allocated, allocations
+
+
+def race(label, build, rounds=ROUNDS):
+    """`build(variant)` returns the callables to fire at the same instant."""
+    assert_reservations_off()
+    oversold = 0
+    samples = []
+    for _ in range(rounds):
+        variant, _stock = make_variant(stock_qty=1)
+        outcomes = fire_concurrently(build(variant))
+        in_stock, allocated, allocations = state(variant)
+        over = allocated > in_stock
+        oversold += over
+        if over and len(samples) < 2:
+            samples.append(
+                f"      e.g. {outcomes} -> in stock {in_stock}, allocated {allocated}, "
+                f"orders holding it: {[n for n, _ in allocations]}"
+            )
+        if not over and not samples and _ == rounds - 1:
+            samples.append(f"      e.g. {outcomes} -> in stock {in_stock}, allocated {allocated}")
+    print(f"  {label}: sold twice in {oversold} of {rounds} rounds")
+    for sample in samples:
+        print(sample)
+    return oversold
+
+
+def two_drafts(variant):
+    drafts = [create_draft([(variant, 1)]) for _ in range(2)]
+    return [lambda d=d: complete_draft(d) for d in drafts]
+
+
+def six_drafts(variant):
+    drafts = [create_draft([(variant, 1)]) for _ in range(6)]
+    return [lambda d=d: complete_draft(d) for d in drafts]
+
+
+def two_checkouts(variant):
+    checkouts = [create_paid_checkout([(variant, 1)]) for _ in range(2)]
+    return [lambda c=c: finish_checkout(c) for c in checkouts]
+
+
+def checkout_and_draft(variant):
+    checkout_id = create_paid_checkout([(variant, 1)])
+    draft = create_draft([(variant, 1)])
+    return [lambda: finish_checkout(checkout_id), lambda: complete_draft(draft)]
+
+
+results = {
+    "draft_vs_draft": race("two draft orders finalized at once       ", two_drafts),
+    "six_drafts": race("six draft orders finalized at once       ", six_drafts, max(ROUNDS // 2, 1)),
+    "checkout_vs_checkout": race("two storefront checkouts at once         ", two_checkouts),
+    "checkout_vs_draft": race("storefront checkout + draft order at once", checkout_and_draft),
+}
+print("  RESULT", results)
diff --git a/_repro/orders/34_last_unit_followups.py b/_repro/orders/34_last_unit_followups.py
new file mode 100644
index 0000000000..3afbed438b
--- /dev/null
+++ b/_repro/orders/34_last_unit_followups.py
@@ -0,0 +1,152 @@
+"""Follow-ups for the last-unit question, all with stock reservation switched OFF.
+
+A. How simultaneous do two checkouts have to be?  (second one delayed by N ms)
+B. Controls with no race: a second buyer arriving after the unit is taken.
+C. One order carrying the same product on two lines (no race at all).
+D. Editing an unconfirmed order while another order takes the unit.
+E. What staff see when they try to ship both orders.
+F. Staff lowering the stock figure below what is already allocated.
+"""
+
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+from checkout_live import (
+    assert_reservations_off,
+    complete_checkout,
+    create_paid_checkout,
+    outcome,
+)
+from live import (
+    DRAFT_COMPLETE,
+    auto_confirm,
+    brief,
+    create_draft,
+    db_allocations,
+    db_stock,
+    errors_of,
+    fire_concurrently,
+    fulfill,
+    get_order,
+    gid,
+    gql,
+    line_update,
+    lines_create,
+    make_variant,
+    warehouses,
+)
+
+
+def complete_draft(draft):
+    return outcome(gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False), "draftOrderComplete")
+
+
+def finish_checkout(checkout_id):
+    return outcome(complete_checkout(checkout_id), "checkoutComplete")
+
+
+def state(variant):
+    stock = db_stock(variant)[0]
+    allocations = db_allocations(variant)
+    return stock["quantity"], sum(q for _, q in allocations), allocations
+
+
+assert_reservations_off()
+
+print("A. second checkout delayed")
+for delay_ms in (0, 10, 25, 50, 100, 250, 1000):
+    rounds, oversold = 10, 0
+    for _ in range(rounds):
+        variant, _stock = make_variant(stock_qty=1)
+        first, second = (create_paid_checkout([(variant, 1)]) for _ in range(2))
+
+        def late(checkout_id=second):
+            time.sleep(delay_ms / 1000)
+            return finish_checkout(checkout_id)
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            futures = [pool.submit(finish_checkout, first), pool.submit(late)]
+            [f.result() for f in futures]
+        in_stock, allocated, _ = state(variant)
+        oversold += allocated > in_stock
+    print(f"  second checkout {delay_ms:>4} ms later: sold twice in {oversold} of {rounds}")
+
+print("B. controls, one after the other")
+variant, _stock = make_variant(stock_qty=1)
+first, second = (create_paid_checkout([(variant, 1)]) for _ in range(2))
+print("  checkout, then checkout:", finish_checkout(first), "/", finish_checkout(second), state(variant)[:2])
+variant, _stock = make_variant(stock_qty=1)
+draft = create_draft([(variant, 1)])
+checkout_id = create_paid_checkout([(variant, 1)])
+print("  draft, then checkout:   ", complete_draft(draft), "/", finish_checkout(checkout_id), state(variant)[:2])
+variant, _stock = make_variant(stock_qty=1)
+draft = create_draft([(variant, 1)])
+checkout_id = create_paid_checkout([(variant, 1)])
+print("  checkout, then draft:   ", finish_checkout(checkout_id), "/", complete_draft(draft), state(variant)[:2])
+
+print("C. same product on two lines of one order, 1 in stock")
+variant, _stock = make_variant(stock_qty=1)
+try:
+    checkout_id = create_paid_checkout([(variant, 1), (variant, 1)], force_new_line=True)
+    print("  checkout with two lines:", finish_checkout(checkout_id), state(variant))
+except AssertionError as exc:
+    print("  checkout with two lines refused when building it:", str(exc)[:160])
+variant, _stock = make_variant(stock_qty=1)
+draft = create_draft([(variant, 1), (variant, 1)], force_new_line=True)
+print("  draft with two lines:   ", complete_draft(draft), state(variant))
+
+print("D. editing an unconfirmed order while another order takes the unit")
+auto_confirm(False)
+try:
+    for label in ("add line", "raise quantity"):
+        rounds, oversold, sample = 10, 0, None
+        for _ in range(rounds):
+            if label == "add line":
+                other, _s = make_variant(stock_qty=50)
+                variant, _stock = make_variant(stock_qty=1)
+                order = create_draft([(other, 1)], complete=True)
+                edit = lambda o=order, v=variant: outcome(lines_create(o["id"], v, 1), "orderLinesCreate")  # noqa: E731
+            else:
+                variant, _stock = make_variant(stock_qty=2)
+                order = create_draft([(variant, 1)], complete=True)
+                line_id = order["lines"][0]["id"]
+                edit = lambda l=line_id: outcome(line_update(l, 2), "orderLineUpdate")  # noqa: E731
+            assert order["status"] == "UNCONFIRMED", order["status"]
+            draft = create_draft([(variant, 1)])
+            outcomes = fire_concurrently([edit, lambda d=draft: complete_draft(d)])
+            in_stock, allocated, _ = state(variant)
+            oversold += allocated > in_stock
+            sample = (outcomes, in_stock, allocated)
+        print(f"  {label} vs draft finalize: sold twice in {oversold} of {rounds}; last round {sample}")
+finally:
+    auto_confirm(True)
+
+print("E. shipping both orders after a double sale")
+variant, _stock = make_variant(stock_qty=1)
+checkouts = [create_paid_checkout([(variant, 1)]) for _ in range(2)]
+responses = fire_concurrently([lambda c=c: complete_checkout(c) for c in checkouts])
+orders = [r["data"]["checkoutComplete"]["order"] for r in responses if r.get("data") and r["data"]["checkoutComplete"]["order"]]
+print("  orders placed:", [o["number"] for o in orders], "stock/allocated:", state(variant)[:2])
+stocks = gql(
+    "query($id: ID!){ productVariant(id:$id){ stocks{ quantity quantityAllocated } quantityAvailable: stocks{ quantity } } }",
+    {"id": gid("ProductVariant", variant.pk)},
+)["data"]["productVariant"]["stocks"]
+print("  stock as the dashboard reads it:", stocks)
+for order in orders:
+    full = get_order(order["id"])
+    res = fulfill(full["id"], [(full["lines"][0]["id"], 1)], warehouses()[0])
+    errs = errors_of(res, "orderFulfill")
+    print(f"  ship order {full['number']}:", "shipped" if not errs else [(e.get('code'), e['message']) for e in errs])
+    print("   ", brief(get_order(order["id"])), "stock/allocated:", state(variant)[:2])
+
+print("F. staff lower the stock figure below what is allocated")
+variant, _stock = make_variant(stock_qty=3)
+create_draft([(variant, 3)], complete=True)
+res = gql(
+    """mutation($id: ID!, $stocks: [StockInput!]!){
+      productVariantStocksUpdate(variantId:$id, stocks:$stocks){
+        productVariant{ stocks{ quantity quantityAllocated } } errors{ field code message } } }""",
+    {"id": gid("ProductVariant", variant.pk), "stocks": [{"warehouse": gid("Warehouse", warehouses()[0].pk), "quantity": 1}]},
+    check=False,
+)
+print("  set quantity 1 while 3 allocated:", res.get("data") or res)
diff --git a/_repro/orders/35_order_import_last_unit.py b/_repro/orders/35_order_import_last_unit.py
new file mode 100644
index 0000000000..6007a4eb3b
--- /dev/null
+++ b/_repro/orders/35_order_import_last_unit.py
@@ -0,0 +1,124 @@
+"""Does an order brought in with orderBulkCreate hold its stock? Reservations OFF, no race.
+
+One unit in stock. Import an unfulfilled order for it with the default stock policy
+(UPDATE = "fail when stock is insufficient"), then try to sell the same unit again.
+"""
+
+from datetime import UTC, datetime
+
+from checkout_live import assert_reservations_off, outcome
+from live import (
+    ADDRESS,
+    CHANNEL_SLUG,
+    DRAFT_COMPLETE,
+    brief,
+    create_draft,
+    db_allocations,
+    db_stock,
+    errors_of,
+    fulfill,
+    get_order,
+    gid,
+    gql,
+    make_variant,
+    mark_paid,
+    shipping_method_id,
+    warehouses,
+)
+
+from saleor.tax.models import TaxClass  # noqa: E402
+
+BULK_CREATE = """
+mutation($orders: [OrderBulkCreateInput!]!, $stockUpdatePolicy: StockUpdatePolicyEnum){
+  orderBulkCreate(orders:$orders, stockUpdatePolicy:$stockUpdatePolicy){
+    count
+    results{ order{ id number status lines{ id quantity } } errors{ path code message } }
+    errors{ code message }
+  }
+}"""
+
+
+def import_order(variant, quantity, policy=None):
+    now = datetime.now(UTC).isoformat()
+    tax_class = gid("TaxClass", TaxClass.objects.order_by("pk").first().pk)
+    order = {
+        "channel": CHANNEL_SLUG,
+        "createdAt": now,
+        "status": "UNFULFILLED",
+        "user": {"email": "customer@example.com"},
+        "billingAddress": ADDRESS,
+        "shippingAddress": ADDRESS,
+        "currency": "USD",
+        "languageCode": "EN",
+        "deliveryMethod": {
+            "shippingMethodId": shipping_method_id(),
+            "shippingPrice": {"gross": 0, "net": 0},
+            "shippingTaxRate": 0,
+            "shippingTaxClassId": tax_class,
+        },
+        "lines": [
+            {
+                "variantId": gid("ProductVariant", variant.pk),
+                "createdAt": now,
+                "productName": "Imported product",
+                "variantName": variant.sku,
+                "isShippingRequired": True,
+                "isGiftCard": False,
+                "quantity": quantity,
+                "totalPrice": {"gross": 10 * quantity, "net": 10 * quantity},
+                "undiscountedTotalPrice": {"gross": 10 * quantity, "net": 10 * quantity},
+                "warehouse": gid("Warehouse", warehouses()[0].pk),
+                "taxRate": 0,
+                "taxClassId": tax_class,
+            }
+        ],
+    }
+    variables = {"orders": [order]}
+    if policy:
+        variables["stockUpdatePolicy"] = policy
+    return gql(BULK_CREATE, variables, check=False)
+
+
+def show_import(response):
+    if "errors" in response:
+        return response["errors"]
+    data = response["data"]["orderBulkCreate"]
+    result = data["results"][0]
+    return {
+        "count": data["count"],
+        "order": result["order"] and (result["order"]["number"], result["order"]["status"]),
+        "errors": result["errors"] or data["errors"],
+    }
+
+
+assert_reservations_off()
+
+variant, _stock = make_variant(stock_qty=1)
+first = import_order(variant, 1)
+print("  import order for the last unit:", show_import(first))
+print("    stock:", db_stock(variant), "allocations:", db_allocations(variant))
+
+second = import_order(variant, 1)
+print("  import a second order for it:  ", show_import(second))
+print("    stock:", db_stock(variant), "allocations:", db_allocations(variant))
+
+draft = create_draft([(variant, 1)])
+done = gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False)
+print("  then a draft order for it:     ", outcome(done, "draftOrderComplete"))
+print("    stock:", db_stock(variant), "allocations:", db_allocations(variant))
+
+too_many = import_order(variant, 5)
+print("  import an order for 5 (1 in stock):", show_import(too_many))
+
+print("  shipping, in order of arrival:")
+imported = [r["data"]["orderBulkCreate"]["results"][0]["order"] for r in (first, second)]
+for order_id in [o["id"] for o in imported if o] + [draft["id"]]:
+    mark_paid(order_id)
+    full = get_order(order_id)
+    res = fulfill(full["id"], [(full["lines"][0]["id"], 1)], warehouses()[0])
+    errs = errors_of(res, "orderFulfill")
+    print(
+        f"    order {full['number']} ({full['status']}, charge {full['chargeStatus']}):",
+        "shipped" if not errs else [(e.get("code"), e["message"]) for e in errs],
+        "-> stock", db_stock(variant),
+    )
