@@ -0,0 +1,96 @@
+from decimal import Decimal
+
+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus
+from saleor.payment import TransactionEventType
+
+TRANSACTION_UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { id chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db(transaction=True)
+def test_two_identical_concurrent_updates_double_the_charged_amount(
+    staff_user,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """Two identical concurrent transactionUpdate calls double the charged amount.
+
+    transactionUpdate turns "set charged amount to X" into a delta event
+    (X - current). Two requests computing the delta from the same starting point both
+    add it. Real threads, two independent requests (retry / double submit), nothing
+    patched. The window is a few milliseconds, so the scenario is attempted 40 times
+    (each time on a fresh transaction) and the hit rate is printed.
+    """
+    # given
+    staff_user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    amount = Decimal("10.00")
+    attempts = 40
+    doubled = 0
+
+    for attempt in range(attempts):
+        transaction = transaction_item_generator(
+            order_id=order.pk, user=staff_user, psp_reference=f"tx-{attempt}"
+        )
+        assert transaction.charged_value == Decimal(0)
+        variables = {
+            "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+            "transaction": {
+                "amountCharged": {"amount": amount, "currency": order.currency},
+            },
+        }
+
+        def update(variables=variables):
+            client = new_client(user=staff_user)
+            return get_graphql_content(
+                client.post_graphql(TRANSACTION_UPDATE, variables)
+            )
+
+        # when
+        results = run_concurrently(update, update)
+
+        # then
+        for content in results:
+            assert content["data"]["transactionUpdate"]["errors"] == []
+        transaction.refresh_from_db()
+        charge_events = [
+            e.amount_value
+            for e in transaction.events.filter(
+                type=TransactionEventType.CHARGE_SUCCESS
+            )
+        ]
+        if transaction.charged_value == 2 * amount:
+            # both requests asked for "charged = 10", two +10 events were created
+            assert charge_events == [amount, amount]
+            doubled += 1
+        else:
+            assert transaction.charged_value == amount
+            assert charge_events == [amount]
+
+    order.refresh_from_db()
+    requested_total = attempts * amount
+    print(
+        f"doubled transactions: {doubled}/{attempts}",
+        "| requested in total:",
+        requested_total,
+        "| order total_charged:",
+        order.total_charged_amount,
+        "| charge_status:",
+        order.charge_status,
+    )
+    # BUG: at least one transaction ended with twice the requested charged amount
+    assert doubled >= 1
+    assert order.total_charged_amount == requested_total + doubled * amount
+    assert order.charge_status == OrderChargeStatus.OVERCHARGED
diff --git a/_repro/transactions/test_race_transaction_update_overwrites_reported_charge.py b/_repro/transactions/test_race_transaction_update_overwrites_reported_charge.py
new file mode 100644
index 0000000000..091eb01792
--- /dev/null
+++ b/_repro/transactions/test_race_transaction_update_overwrites_reported_charge.py
@@ -0,0 +1,200 @@
+import random
+import time
+from decimal import Decimal
+
+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.graphql.payment.enums import TransactionEventTypeEnum
+from saleor.graphql.tests.fixtures import ApiClient
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus
+from saleor.payment import TransactionEventType
+from saleor.tests.race_condition import RunBefore
+
+TRANSACTION_UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { id name chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+EVENT_REPORT = """
+mutation Report(
+  $id: ID, $type: TransactionEventTypeEnum!, $amount: PositiveDecimal,
+  $pspReference: String!
+) {
+  transactionEventReport(
+    id: $id, type: $type, amount: $amount, pspReference: $pspReference
+  ) {
+    alreadyProcessed
+    transaction { id chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_non_money_transaction_update_erases_concurrently_reported_charge(
+    app,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """A transactionUpdate that only renames a transaction wipes a just-reported charge.
+
+    transactionUpdate loads the TransactionItem, and later writes the WHOLE row back
+    (`instance.save()` without update_fields). A CHARGE_SUCCESS reported by the payment
+    app in between is overwritten with the stale zero amounts, and the order is then
+    recalculated from that stale row.
+
+    Deterministic interleaving (saleor.tests.race_condition.RunBefore): the complete
+    transactionEventReport request is executed right before transactionUpdate writes the
+    transaction, i.e. after it has loaded it - what happens when a PSP notification is
+    handled by another pod while this request is in flight.
+    """
+    # given
+    app.permissions.add(permission_manage_payments)
+    order = order_with_lines
+    total = order.total_gross_amount
+    transaction = transaction_item_generator(order_id=order.pk, app=app)
+    assert transaction.charged_value == Decimal(0)
+    transaction_id = graphene.Node.to_global_id("TransactionItem", transaction.token)
+    reports = []
+
+    def report_charge(*args, **kwargs):
+        response = ApiClient(app=app).post_graphql(
+            EVENT_REPORT,
+            {
+                "id": transaction_id,
+                "type": TransactionEventTypeEnum.CHARGE_SUCCESS.name,
+                "amount": total,
+                "pspReference": "psp-charge-1",
+            },
+        )
+        reports.append(get_graphql_content(response))
+        # sanity: at this point the charge is correctly recorded everywhere
+        order.refresh_from_db()
+        transaction.refresh_from_db()
+        assert transaction.charged_value == total
+        assert order.total_charged_amount == total
+        assert order.charge_status == OrderChargeStatus.FULL
+
+    # when
+    with RunBefore(
+        "saleor.graphql.payment.mutations.transaction.transaction_update."
+        "TransactionUpdate.update_transaction",
+        report_charge,
+    ):
+        response = ApiClient(app=app).post_graphql(
+            TRANSACTION_UPDATE,
+            {"id": transaction_id, "transaction": {"name": "Card payment"}},
+        )
+    content = get_graphql_content(response)
+
+    # then
+    assert content["data"]["transactionUpdate"]["errors"] == []
+    assert len(reports) == 1
+    assert reports[0]["data"]["transactionEventReport"]["errors"] == []
+
+    transaction.refresh_from_db()
+    order.refresh_from_db()
+    print(
+        "tx charged:",
+        transaction.charged_value,
+        "| order total_charged:",
+        order.total_charged_amount,
+        "| charge_status:",
+        order.charge_status,
+        "| authorize_status:",
+        order.authorize_status,
+    )
+    # the charge event is there...
+    charge_event = transaction.events.get(type=TransactionEventType.CHARGE_SUCCESS)
+    assert charge_event.amount_value == total
+    assert transaction.name == "Card payment"
+    # BUG: ...but the transaction and the order say nothing was paid
+    assert transaction.charged_value == Decimal(0)
+    assert order.total_charged_amount == Decimal(0)
+    assert order.charge_status == OrderChargeStatus.NONE
+
+
+@pytest.mark.django_db(transaction=True)
+def test_real_threads_frequency(
+    app,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """Same problem with real threads and no patched code (frequency measurement).
+
+    For each attempt a fresh transaction is created; one thread reports CHARGE_SUCCESS,
+    the other one renames the transaction a few milliseconds later (random 0-25 ms).
+    """
+    # given
+    app.permissions.add(permission_manage_payments)
+    order = order_with_lines
+    amount = Decimal("10.00")
+    attempts = 40
+    lost = 0
+    rng = random.Random(1)
+
+    for attempt in range(attempts):
+        transaction = transaction_item_generator(
+            order_id=order.pk, app=app, psp_reference=f"tx-{attempt}"
+        )
+        transaction_id = graphene.Node.to_global_id(
+            "TransactionItem", transaction.token
+        )
+        delay = rng.uniform(0, 0.025)
+
+        def report(transaction_id=transaction_id, attempt=attempt):
+            return get_graphql_content(
+                new_client(app=app).post_graphql(
+                    EVENT_REPORT,
+                    {
+                        "id": transaction_id,
+                        "type": TransactionEventTypeEnum.CHARGE_SUCCESS.name,
+                        "amount": amount,
+                        "pspReference": f"psp-charge-{attempt}",
+                    },
+                )
+            )
+
+        def rename(transaction_id=transaction_id, delay=delay):
+            time.sleep(delay)
+            return get_graphql_content(
+                new_client(app=app).post_graphql(
+                    TRANSACTION_UPDATE,
+                    {"id": transaction_id, "transaction": {"name": "Card payment"}},
+                )
+            )
+
+        # when
+        report_result, rename_result = run_concurrently(report, rename)
+
+        # then
+        assert report_result["data"]["transactionEventReport"]["errors"] == []
+        assert rename_result["data"]["transactionUpdate"]["errors"] == []
+        transaction.refresh_from_db()
+        assert transaction.events.filter(
+            type=TransactionEventType.CHARGE_SUCCESS, amount_value=amount
+        ).exists()
+        if transaction.charged_value == Decimal(0):
+            lost += 1
+
+    order.refresh_from_db()
+    reported_total = attempts * amount
+    print(
+        f"lost charges: {lost}/{attempts}",
+        "| reported in total:",
+        reported_total,
+        "| order total_charged:",
+        order.total_charged_amount,
+    )
+    # BUG: at least one reported charge vanished from its transaction
+    assert lost >= 1
+    assert order.total_charged_amount < reported_total
