+"""orderFulfill does not look at the order status (canceled / draft)."""
+
+from live import *  # noqa: F403
+from live import brief, cancel_order, errors_of, new_order, verdict, shop_settings
+
+shop_settings(fulfillmentAllowUnpaid=True)
+variant, stock = make_variant(stock_qty=20)
+
+# --- canceled order
+order = new_order([(variant, 3)])
+res = cancel_order(order["id"])
+assert not errors_of(res, "orderCancel"), res
+show("canceled order", brief(get_order(order["id"])))
+show("stock after cancel", get_stocks(variant))
+res = fulfill(order["id"], [(order["lines"][0]["id"], 3)], stock.warehouse)
+show("orderFulfill on CANCELED errors", errors_of(res, "orderFulfill"))
+canceled_after = get_order(order["id"])
+show("canceled order after fulfill", brief(canceled_after))
+show("stock after fulfill", get_stocks(variant))
+
+# --- draft order (never completed)
+draft = create_draft([(variant, 2)])
+res = fulfill(draft["id"], [(draft["lines"][0]["id"], 2)], stock.warehouse)
+show("orderFulfill on DRAFT errors", errors_of(res, "orderFulfill"))
+draft_after = get_order(draft["id"])
+show("draft after fulfill", brief(draft_after))
+show("stock after fulfill", get_stocks(variant))
+shop_settings(fulfillmentAllowUnpaid=False)
+
+verdict(
+    canceled_after["status"] != "CANCELED" and bool(canceled_after["fulfillments"]),
+    f"a CANCELED order was shipped and its status became {canceled_after['status']}.",
+)
+verdict(
+    bool(draft_after["fulfillments"]),
+    f"a DRAFT order was shipped (status now {draft_after['status']}).",
+)
