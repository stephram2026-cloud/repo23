+from decimal import Decimal
+from unittest.mock import patch
+
+import graphene
+
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.payment import TransactionEventType
+from saleor.webhook.event_types import WebhookEventSyncType
+
+REQUEST_ACTION = """
+mutation Action($id: ID, $action_type: TransactionActionEnum!, $amount: PositiveDecimal) {
+  transactionRequestAction(id: $id, actionType: $action_type, amount: $amount) {
+    transaction { id chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+@patch("saleor.plugins.manager.PluginsManager.transaction_refund_requested")
+def test_second_full_refund_request_is_sent_while_first_is_still_pending(
+    mocked_refund_requested,
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    app,
+):
+    """Clicking "refund" twice sends two full-amount refund requests to the payment app.
+
+    The requested amount is only capped by `transaction.charged_value`, which is not
+    reduced until the payment app answers the TRANSACTION_REFUND_REQUESTED webhook
+    (a background task). Until then nothing stops a second request for the same money.
+
+    Only the outbound webhook dispatch (PluginsManager.transaction_refund_requested)
+    is mocked - it stands for "the payment app has not answered yet".
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    app.permissions.add(permission_manage_payments)
+    webhook = app.webhooks.create(
+        name="Request", is_active=True, target_url="http://app.example.com/endpoint/"
+    )
+    webhook.events.create(event_type=WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED)
+    charged = order.total_gross_amount
+    transaction = transaction_item_generator(
+        order_id=order.pk, charged_value=charged, app=app
+    )
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.REFUND.name,
+    }
+
+    # when: staff member double-clicks "refund" (two sequential requests)
+    first = get_graphql_content(staff_api_client.post_graphql(REQUEST_ACTION, variables))
+    second = get_graphql_content(
+        staff_api_client.post_graphql(REQUEST_ACTION, variables)
+    )
+
+    # then
+    assert first["data"]["transactionRequestAction"]["errors"] == []
+    # BUG: the second request is accepted as well
+    assert second["data"]["transactionRequestAction"]["errors"] == []
+
+    # BUG: the payment app was asked twice to refund the full charged amount
+    assert mocked_refund_requested.call_count == 2
+    requested_amounts = [
+        call.args[0].action_value for call in mocked_refund_requested.call_args_list
+    ]
+    assert requested_amounts == [charged, charged]
+    assert sum(requested_amounts) == 2 * charged
+
+    request_events = transaction.events.filter(type=TransactionEventType.REFUND_REQUEST)
+    assert [event.amount_value for event in request_events] == [charged, charged]
+    transaction.refresh_from_db()
+    assert transaction.charged_value == charged
+    assert transaction.refund_pending_value == Decimal(0)
