+from decimal import Decimal
+
+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderGrantedRefundStatus
+from saleor.payment import TransactionAction, TransactionEventType
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db(transaction=True)
+def test_one_granted_refund_is_paid_out_twice(
+    staff_user,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """Two concurrent "send refund" requests for one granted refund both pay out.
+
+    The PENDING / SUCCESS status guard in transactionRequestRefundForGrantedRefund is a
+    plain read of `granted_refund.status`; the status is only written after the refund
+    was requested. Real threads, two independent requests (double click).
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_user)
+    staff_user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    gift_card = gift_card_created_by_staff
+    gift_card.current_balance_amount = Decimal(0)
+    gift_card.save(update_fields=["current_balance_amount"])
+    charged = order.total_gross_amount
+    transaction = transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order.pk,
+        gift_card=gift_card,
+        charged_value=charged,
+        available_actions=[TransactionAction.REFUND],
+    )
+    granted_amount = Decimal("10.00")
+    content = get_graphql_content(
+        new_client(user=staff_user).post_graphql(
+            GRANT_REFUND_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {
+                    "amount": granted_amount,
+                    "transactionId": graphene.Node.to_global_id(
+                        "TransactionItem", transaction.token
+                    ),
+                },
+            },
+        )
+    )
+    assert content["data"]["orderGrantRefundCreate"]["errors"] == []
+    granted_refund = order.granted_refunds.get()
+    variables = {"grantedRefundID": to_global_id_or_none(granted_refund)}
+
+    def send_refund():
+        client = new_client(user=staff_user)
+        return get_graphql_content(
+            client.post_graphql(REQUEST_REFUND_FOR_GRANTED_REFUND, variables)
+        )
+
+    # when
+    results = run_concurrently(send_refund, send_refund)
+
+    # then
+    errors = [
+        r["data"]["transactionRequestRefundForGrantedRefund"]["errors"] for r in results
+    ]
+    transaction.refresh_from_db()
+    gift_card.refresh_from_db()
+    granted_refund.refresh_from_db()
+    order.refresh_from_db()
+    success_events = granted_refund.transaction_events.filter(
+        type=TransactionEventType.REFUND_SUCCESS
+    )
+    print(
+        "errors:",
+        errors,
+        "| granted:",
+        granted_amount,
+        "| refunded:",
+        transaction.refunded_value,
+        "| gift card balance:",
+        gift_card.current_balance_amount,
+        "| tx charged:",
+        transaction.charged_value,
+        "| order total_charged:",
+        order.total_charged_amount,
+        "| charge_status:",
+        order.charge_status,
+    )
+    # BUG: both requests accepted
+    assert errors == [[], []]
+    # BUG: a granted refund of 10 was paid out twice
+    assert [e.amount_value for e in success_events] == [granted_amount, granted_amount]
+    assert transaction.refunded_value == 2 * granted_amount
+    assert gift_card.current_balance_amount == 2 * granted_amount
+    assert transaction.charged_value == charged - 2 * granted_amount
+    assert granted_refund.status == OrderGrantedRefundStatus.SUCCESS
