+from decimal import Decimal
+from unittest.mock import patch
+
+import graphene
+import pytest
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus, OrderGrantedRefundStatus
+from saleor.payment import TransactionAction, TransactionEventType
+from saleor.webhook.event_types import WebhookEventSyncType
+
+REQUEST_ACTION = """
+mutation Action($id: ID, $action_type: TransactionActionEnum!, $amount: PositiveDecimal) {
+  transactionRequestAction(id: $id, actionType: $action_type, amount: $amount) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def _gift_card_paid_order(order, gift_card, transaction_item_generator):
+    gift_card.current_balance_amount = Decimal(0)
+    gift_card.save(update_fields=["current_balance_amount"])
+    return transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order.pk,
+        gift_card=gift_card,
+        charged_value=order.total_gross_amount,
+        available_actions=[TransactionAction.REFUND],
+    )
+
+
+def test_refund_request_with_amount_zero_refunds_everything(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """transactionRequestAction(REFUND, amount: 0) refunds the full charged amount.
+
+    `action_value = action_value or transaction.charged_value` treats an explicit 0 the
+    same as "amount not provided".
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    gift_card = gift_card_created_by_staff
+    transaction = _gift_card_paid_order(order, gift_card, transaction_item_generator)
+    charged = order.total_gross_amount
+    requested_amount = Decimal(0)
+
+    # when
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            REQUEST_ACTION,
+            {
+                "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+                "action_type": TransactionActionEnum.REFUND.name,
+                "amount": requested_amount,
+            },
+        )
+    )
+
+    # then
+    assert content["data"]["transactionRequestAction"]["errors"] == []
+    transaction.refresh_from_db()
+    gift_card.refresh_from_db()
+    order.refresh_from_db()
+    print(
+        "requested:",
+        requested_amount,
+        "| refunded:",
+        transaction.refunded_value,
+        "| gift card balance:",
+        gift_card.current_balance_amount,
+    )
+    # BUG: asked to refund 0, the whole payment was refunded
+    request_event = transaction.events.get(type=TransactionEventType.REFUND_REQUEST)
+    assert request_event.amount_value == charged
+    assert transaction.refunded_value == charged
+    assert transaction.charged_value == Decimal(0)
+    assert gift_card.current_balance_amount == charged
+    assert order.total_charged_amount == Decimal(0)
+    assert order.charge_status == OrderChargeStatus.NONE
+
+
+def test_granted_refund_with_amount_zero_refunds_everything(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """Sending a granted refund whose amount is 0 refunds the full charged amount.
+
+    `granted_refund.amount_value or transaction_item.charged_value` in
+    transactionRequestRefundForGrantedRefund. A zero granted refund can be created
+    directly (amount: 0) and is also what orderGrantRefundUpdate leaves behind in
+    test_grant_refund_update_resets_manual_amount.py.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    gift_card = gift_card_created_by_staff
+    transaction = _gift_card_paid_order(order, gift_card, transaction_item_generator)
+    charged = order.total_gross_amount
+    granted_amount = Decimal(0)
+
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            GRANT_REFUND_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {
+                    "amount": granted_amount,
+                    "transactionId": graphene.Node.to_global_id(
+                        "TransactionItem", transaction.token
+                    ),
+                },
+            },
+        )
+    )
+    assert content["data"]["orderGrantRefundCreate"]["errors"] == []
+    granted_refund = order.granted_refunds.get()
+    assert granted_refund.amount_value == granted_amount
+
+    # when
+    content = get_graphql_content(
