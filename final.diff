index 0000000000..2e0d218db1
--- /dev/null
+++ b/_repro/transactions/test_p15_review_authorized_amount.py
@@ -0,0 +1,143 @@
+"""Review of P15 (second half): what does transactionUpdate(amountAuthorized: X) store?
+
+Each case prints entered vs stored so the rule can be read off the output.
+"""
+
+from decimal import Decimal
+
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.payment.enums import TransactionEventTypeEnum
+from saleor.graphql.tests.utils import get_graphql_content
+
+CREATE = """
+mutation Create($id: ID!, $transaction: TransactionCreateInput!) {
+  transactionCreate(id: $id, transaction: $transaction) {
+    transaction { id authorizedAmount { amount } chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+REPORT = """
+mutation Report($id: ID, $type: TransactionEventTypeEnum!, $amount: PositiveDecimal, $pspReference: String!) {
+  transactionEventReport(id: $id, type: $type, amount: $amount, pspReference: $pspReference) {
+    transaction { authorizedAmount { amount } chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { authorizedAmount { amount } chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def _client(staff_api_client, permission_group_manage_orders, permission_manage_payments):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    return staff_api_client
+
+
+def _amounts(data):
+    return (
+        Decimal(str(data["authorizedAmount"]["amount"])),
+        Decimal(str(data["chargedAmount"]["amount"])),
+    )
+
+
+def _create(client, order, **amounts):
+    transaction = {"name": "Card"}
+    for field, value in amounts.items():
+        transaction[field] = {"amount": value, "currency": order.currency}
+    data = get_graphql_content(
+        client.post_graphql(CREATE, {"id": to_global_id_or_none(order), "transaction": transaction})
+    )["data"]["transactionCreate"]
+    assert data["errors"] == []
+    return data["transaction"]["id"]
+
+
+def _report(client, transaction_id, event_type, amount, psp_reference):
+    data = get_graphql_content(
+        client.post_graphql(
+            REPORT,
+            {"id": transaction_id, "type": event_type.name, "amount": amount, "pspReference": psp_reference},
+        )
+    )["data"]["transactionEventReport"]
+    assert data["errors"] == []
+    return _amounts(data["transaction"])
+
+
+def _update(client, order, transaction_id, **amounts):
+    transaction = {
+        field: {"amount": value, "currency": order.currency} for field, value in amounts.items()
+    }
+    data = get_graphql_content(
+        client.post_graphql(UPDATE, {"id": transaction_id, "transaction": transaction})
+    )["data"]["transactionUpdate"]
+    assert data["errors"] == []
+    return _amounts(data["transaction"])
+
+
+def _reported_90_charged_30(client, order):
+    transaction_id = _create(client, order)
+    _report(client, transaction_id, TransactionEventTypeEnum.AUTHORIZATION_SUCCESS, Decimal(90), "auth-1")
+    state = _report(client, transaction_id, TransactionEventTypeEnum.CHARGE_SUCCESS, Decimal(30), "charge-1")
+    assert state == (Decimal(60), Decimal(30))
+    return transaction_id
+
+
+def test_update_after_reported_charge(
+    staff_api_client, permission_group_manage_orders, permission_manage_payments, order_with_lines
+):
+    client = _client(staff_api_client, permission_group_manage_orders, permission_manage_payments)
+    order = order_with_lines
+    for entered in (Decimal(50), Decimal(60), Decimal(61), Decimal(80), Decimal(90), Decimal(20)):
+        transaction_id = _reported_90_charged_30(client, order)
+        stored = _update(client, order, transaction_id, amountAuthorized=entered)
+        print(f"A reported auth 90, reported charge 30 (shows 60/30) | update authorized={entered} -> authorized {stored[0]}, charged {stored[1]}")
+        order.refresh_from_db()
+
+
+def test_reported_adjustment_after_reported_charge(
+    staff_api_client, permission_group_manage_orders, permission_manage_payments, order_with_lines
+):
+    client = _client(staff_api_client, permission_group_manage_orders, permission_manage_payments)
+    order = order_with_lines
+    transaction_id = _reported_90_charged_30(client, order)
+    stored = _report(
+        client, transaction_id, TransactionEventTypeEnum.AUTHORIZATION_ADJUSTMENT, Decimal(50), "adjust-1"
+    )
+    print(f"B same start | REPORTED authorization adjustment 50 -> authorized {stored[0]}, charged {stored[1]}")
+
+
+def test_update_only_flow(
+    staff_api_client, permission_group_manage_orders, permission_manage_payments, order_with_lines
+):
+    client = _client(staff_api_client, permission_group_manage_orders, permission_manage_payments)
+    order = order_with_lines
+    transaction_id = _create(client, order, amountAuthorized=Decimal(90))
+    state = _update(client, order, transaction_id, amountAuthorized=Decimal(60), amountCharged=Decimal(30))
+    print(f"C created with authorized 90, then update authorized=60 charged=30 -> authorized {state[0]}, charged {state[1]}")
+    stored = _update(client, order, transaction_id, amountAuthorized=Decimal(50))
+    print(f"C then update authorized=50 -> authorized {stored[0]}, charged {stored[1]}")
+
+
+def test_update_then_reported_charge(
+    staff_api_client, permission_group_manage_orders, permission_manage_payments, order_with_lines
+):
+    client = _client(staff_api_client, permission_group_manage_orders, permission_manage_payments)
+    order = order_with_lines
+    transaction_id = _create(client, order, amountAuthorized=Decimal(90))
+    state = _report(client, transaction_id, TransactionEventTypeEnum.CHARGE_SUCCESS, Decimal(30), "charge-1")
+    print(f"D created with authorized 90, reported charge 30 -> authorized {state[0]}, charged {state[1]}")
+    stored = _update(client, order, transaction_id, amountAuthorized=Decimal(50))
+    print(f"D then update authorized=50 -> authorized {stored[0]}, charged {stored[1]}")
+    stored = _update(client, order, transaction_id, amountAuthorized=Decimal(50))
+    print(f"D same update again -> authorized {stored[0]}, charged {stored[1]}")
+    order.refresh_from_db()
+    print(f"D order totals: authorized {order.total_authorized_amount}, charged {order.total_charged_amount}")
