+from decimal import Decimal
+
+import graphene
+
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.order.enums import OrderAuthorizeStatusEnum, OrderChargeStatusEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderAuthorizeStatus, OrderChargeStatus
+
+TRANSACTION_CREATE = """
+mutation Create($id: ID!, $transaction: TransactionCreateInput!) {
+  transactionCreate(id: $id, transaction: $transaction) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+TRANSACTION_UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { id order { chargeStatus authorizeStatus } }
+    errors { field code message }
+  }
+}
+"""
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    order { chargeStatus authorizeStatus totalCharged { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_authorize_status_not_recalculated_when_refund_is_granted(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+):
+    """Granting a refund recalculates chargeStatus but not authorizeStatus.
+
+    Both statuses are defined relative to `order total - granted refunds`, but
+    orderGrantRefundCreate/Update only call update_order_charge_data(). The order is
+    left with chargeStatus=FULL and authorizeStatus=PARTIAL until some unrelated
+    transaction event happens to recalculate it.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    total = order.total_gross_amount
+    granted_amount = Decimal("28.40")
+    charged = total - granted_amount
+
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "transaction": {
+                    "name": "Card",
+                    "amountCharged": {"amount": charged, "currency": order.currency},
+                },
+            },
+        )
+    )
+    assert content["data"]["transactionCreate"]["errors"] == []
+    transaction_id = content["data"]["transactionCreate"]["transaction"]["id"]
+    order.refresh_from_db()
+    assert order.charge_status == OrderChargeStatus.PARTIAL
+    assert order.authorize_status == OrderAuthorizeStatus.PARTIAL
+
+    # when: a refund for the unpaid remainder is granted
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            GRANT_REFUND_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {"amount": granted_amount, "transactionId": transaction_id},
+            },
+        )
+    )
+    data = content["data"]["orderGrantRefundCreate"]
+
+    # then
+    assert data["errors"] == []
+    assert data["order"]["chargeStatus"] == OrderChargeStatusEnum.FULL.name
+    # BUG: still PARTIAL although charged funds cover (total - granted refunds)
+    assert data["order"]["authorizeStatus"] == OrderAuthorizeStatusEnum.PARTIAL.name
+    order.refresh_from_db()
+    assert order.authorize_status == OrderAuthorizeStatus.PARTIAL
+
+    # and: an update that changes no money at all flips it to FULL -> it was stale
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_UPDATE,
+            {"id": transaction_id, "transaction": {"name": "Card (renamed)"}},
+        )
+    )
+    data = content["data"]["transactionUpdate"]
+    assert data["errors"] == []
+    assert (
+        data["transaction"]["order"]["authorizeStatus"]
+        == OrderAuthorizeStatusEnum.FULL.name
+    )
+    assert data["transaction"]["order"]["chargeStatus"] == OrderChargeStatusEnum.FULL.name
