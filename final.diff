@@ -0,0 +1,140 @@
+import graphene
+
+from saleor.channel import MarkAsPaidStrategy
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderGrantedRefundStatus
+from saleor.payment import TransactionEventType
+from saleor.payment.error_codes import TransactionRequestActionErrorCode
+
+MARK_ORDER_AS_PAID_MUTATION = """
+mutation markPaid($id: ID!) {
+  orderMarkAsPaid(id: $id) {
+    errors { field message code }
+    order { isPaid transactions { id actions chargedAmount { amount } } }
+  }
+}
+"""
+
+REQUEST_ACTION = """
+mutation Action($id: ID, $action_type: TransactionActionEnum!) {
+  transactionRequestAction(id: $id, actionType: $action_type) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id }
+    errors { field code message }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_refund_action_advertised_on_mark_as_paid_transaction_always_fails(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+):
+    """A "mark as paid" transaction advertises REFUND but can never be refunded.
+
+    orderMarkAsPaid (TRANSACTION_FLOW) creates a transaction with actions=[REFUND].
+    The transaction has no payment app, so both refund entry points fail with a
+    "missing webhook" style error and leave failed refund events behind.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    channel = order.channel
+    channel.order_mark_as_paid_strategy = MarkAsPaidStrategy.TRANSACTION_FLOW
+    channel.save(update_fields=["order_mark_as_paid_strategy"])
+
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            MARK_ORDER_AS_PAID_MUTATION, {"id": to_global_id_or_none(order)}
+        )
+    )
+    data = content["data"]["orderMarkAsPaid"]
+    assert data["errors"] == []
+    transaction_data = data["order"]["transactions"][0]
+    # the API tells the dashboard that this transaction can be refunded
+    assert transaction_data["actions"] == [TransactionActionEnum.REFUND.name]
+    transaction = order.payment_transactions.get()
+
+    # when: plain refund
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            REQUEST_ACTION,
+            {
+                "id": transaction_data["id"],
+                "action_type": TransactionActionEnum.REFUND.name,
+            },
+        )
+    )
+
+    # then
+    errors = content["data"]["transactionRequestAction"]["errors"]
+    print("transactionRequestAction errors:", errors)
+    assert len(errors) == 1
+    assert (
+        errors[0]["code"]
+        == TransactionRequestActionErrorCode.MISSING_TRANSACTION_ACTION_REQUEST_WEBHOOK.name
+    )
+    assert (
+        errors[0]["message"]
+        == "No app or plugin is configured to handle payment action requests."
+    )
+    assert errors[0]["field"] is None
+
+    # when: refund through a granted refund
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            GRANT_REFUND_CREATE,
+            {
+                "id": to_global_id_or_none(order),
+                "input": {"amount": 10, "transactionId": transaction_data["id"]},
+            },
+        )
+    )
+    assert content["data"]["orderGrantRefundCreate"]["errors"] == []
+    granted_refund = order.granted_refunds.get()
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            REQUEST_REFUND_FOR_GRANTED_REFUND,
+            {"grantedRefundID": to_global_id_or_none(granted_refund)},
+        )
+    )
+    errors = content["data"]["transactionRequestRefundForGrantedRefund"]["errors"]
+    print("transactionRequestRefundForGrantedRefund errors:", errors)
+    assert len(errors) == 1
+    assert (
+        errors[0]["message"]
+        == "No app or plugin is configured to handle payment action requests."
+    )
+
+    # then: nothing refunded, two failed attempts recorded, granted refund is FAILURE
+    transaction.refresh_from_db()
+    granted_refund.refresh_from_db()
+    assert transaction.charged_value == order.total_gross_amount
+    assert transaction.refunded_value == 0
+    assert (
+        transaction.events.filter(type=TransactionEventType.REFUND_FAILURE).count() == 2
+    )
+    assert granted_refund.status == OrderGrantedRefundStatus.FAILURE
+    assert transaction.available_actions == ["refund"]
diff --git a/_repro/transactions/test_p15_review_authorized_amount.py b/_repro/transactions/test_p15_review_authorized_amount.py
