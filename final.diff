+from decimal import Decimal
+
+import graphene
+import pytest
+from _tx_helpers import new_client, run_concurrently
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderGrantedRefundStatus
+from saleor.order.models import OrderGrantedRefundLine
+from saleor.payment import TransactionAction
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } }
+    errors { field code message lines { lineId field code message } }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.mark.django_db(transaction=True)
+def test_same_line_and_shipping_granted_twice_and_both_refunded(
+    staff_user,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """Two concurrent orderGrantRefundCreate calls grant the same line + shipping twice.
+
+    The "quantity already granted" and "shipping costs already granted" validations are
+    plain reads followed by an insert (no lock, no constraint). Real threads, two
+    independent requests (double click / two staff members handling the same return).
+    Both granted refunds can then be paid out one after another.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_user)
+    staff_user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    line = order.lines.first()
+    gift_card = gift_card_created_by_staff
+    gift_card.current_balance_amount = Decimal(0)
+    gift_card.save(update_fields=["current_balance_amount"])
+    transaction = transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order.pk,
+        gift_card=gift_card,
+        charged_value=order.total_gross_amount,
+        available_actions=[TransactionAction.REFUND],
+    )
+    expected_single_amount = (
+        line.unit_price_gross_amount * line.quantity + order.shipping_price_gross_amount
+    )
+    assert 2 * expected_single_amount <= order.total_gross_amount
+    variables = {
+        "id": to_global_id_or_none(order),
+        "input": {
+            "lines": [{"id": to_global_id_or_none(line), "quantity": line.quantity}],
+            "grantRefundForShipping": True,
+            "transactionId": graphene.Node.to_global_id(
+                "TransactionItem", transaction.token
+            ),
+        },
+    }
+
+    def grant():
+        client = new_client(user=staff_user)
+        return get_graphql_content(client.post_graphql(GRANT_REFUND_CREATE, variables))
+
+    # when
+    results = run_concurrently(grant, grant)
+
+    # then
+    errors = [r["data"]["orderGrantRefundCreate"]["errors"] for r in results]
+    granted_refunds = list(order.granted_refunds.order_by("pk"))
+    granted_quantity = sum(
+        OrderGrantedRefundLine.objects.filter(
+            granted_refund__order=order, order_line=line
+        ).values_list("quantity", flat=True)
+    )
+    print(
+        "errors:",
+        errors,
+        "| granted refunds:",
+        [(g.amount_value, g.shipping_costs_included) for g in granted_refunds],
+        "| line quantity:",
+        line.quantity,
+        "| granted quantity:",
+        granted_quantity,
+    )
+    # BUG: both requests were accepted
+    assert errors == [[], []]
+    assert len(granted_refunds) == 2
+    # BUG: more units granted than the line has, shipping granted twice
+    assert granted_quantity == 2 * line.quantity
+    assert [g.shipping_costs_included for g in granted_refunds] == [True, True]
+    assert [g.amount_value for g in granted_refunds] == [
+        expected_single_amount,
+        expected_single_amount,
+    ]
+
+    # and when both granted refunds are sent (sequentially, no race needed any more)
+    client = new_client(user=staff_user)
+    for granted_refund in granted_refunds:
+        content = get_graphql_content(
+            client.post_graphql(
+                REQUEST_REFUND_FOR_GRANTED_REFUND,
+                {"grantedRefundID": to_global_id_or_none(granted_refund)},
+            )
+        )
+        assert content["data"]["transactionRequestRefundForGrantedRefund"]["errors"] == []
+
+    transaction.refresh_from_db()
+    gift_card.refresh_from_db()
+    statuses = [
+        status
+        for status in order.granted_refunds.order_by("pk").values_list(
+            "status", flat=True
+        )
+    ]
+    print(
+        "refunded:",
+        transaction.refunded_value,
+        "| gift card balance:",
+        gift_card.current_balance_amount,
+        "| statuses:",
+        statuses,
+    )
+    # BUG: the same line and the shipping were paid back twice
+    assert statuses == [OrderGrantedRefundStatus.SUCCESS] * 2
+    assert transaction.refunded_value == 2 * expected_single_amount
+    assert gift_card.current_balance_amount == 2 * expected_single_amount
