+"""Exploration of draft-order edge cases staff will hit: what does the API answer?"""
+
+from live import *  # noqa: F403
+from live import DRAFT_COMPLETE, LINE_DELETE, brief, errors_of
+
+from saleor.product.models import ProductVariant, ProductVariantChannelListing
+
+
+def complete(order_id):
+    r = gql(DRAFT_COMPLETE, {"id": order_id}, check=False)
+    if "errors" in r:
+        return "SERVER ERROR: " + r["errors"][0]["message"][:160]
+    errs = r["data"]["draftOrderComplete"]["errors"]
+    return "completed" if not errs else [(e["field"], e["code"], e["message"]) for e in errs]
+
+
+# 1. variant deleted while the draft is open
+v, s = make_variant(stock_qty=5)
+keep, _ = make_variant(stock_qty=5)
+draft = create_draft([(v, 1), (keep, 1)])
+ProductVariant.objects.filter(pk=v.pk).delete()
+show("1. complete after a product on the draft was deleted", complete(draft["id"]))
+show("   order now", brief(get_order(draft["id"])))
+
+# 2. variant removed from the channel while the draft is open
+v, s = make_variant(stock_qty=5)
+draft = create_draft([(v, 1)])
+ProductVariantChannelListing.objects.filter(variant=v).delete()
+show("2. complete after the product was unlisted from the channel", complete(draft["id"]))
+
+# 3. draft without lines
+v, s = make_variant(stock_qty=5)
+draft = create_draft([(v, 1)])
+gql(LINE_DELETE, {"id": draft["lines"][0]["id"]})
+show("3. complete with no lines", complete(draft["id"]))
+
+# 4. not enough stock
+v, s = make_variant(stock_qty=1)
+draft = create_draft([(v, 3)])
+show("4. complete with 3 ordered / 1 in stock", complete(draft["id"]))
+
+# 5. stock tracking disabled
+v, s = make_variant(stock_qty=0)
+ProductVariant.objects.filter(pk=v.pk).update(track_inventory=False)
+draft = create_draft([(v, 3)])
+show("5. complete, untracked product with 0 stock", complete(draft["id"]))
diff --git a/_repro/orders/29_unique_constraints_missing_in_db.py b/_repro/orders/29_unique_constraints_missing_in_db.py
new file mode 100644
index 0000000000..bf3fce7f9e
--- /dev/null
+++ b/_repro/orders/29_unique_constraints_missing_in_db.py
@@ -0,0 +1,39 @@
+"""Compare uniqueness declared on every model with what the database enforces."""
+
+import os
+import sys
+
+import django
+
+sys.path.insert(0, "/app")
+os.environ.setdefault("DJANGO_SETTINGS_MODULE", "saleor.settings")
+django.setup()
+
+from django.apps import apps  # noqa: E402
+from django.db import connection  # noqa: E402
+from django.db.models import UniqueConstraint  # noqa: E402
+
+missing = []
+with connection.cursor() as cursor:
+    for model in apps.get_models():
+        meta = model._meta
+        if not meta.managed or meta.proxy:
+            continue
+        constraints = connection.introspection.get_constraints(cursor, meta.db_table)
+        enforced = {
+            frozenset(c["columns"]) for c in constraints.values() if c["unique"] and c["columns"]
+        }
+        declared = [tuple(u) for u in meta.unique_together]
+        declared += [
+            tuple(c.fields)
+            for c in meta.constraints
+            if isinstance(c, UniqueConstraint) and c.fields and c.condition is None
+        ]
+        for fields in declared:
+            columns = frozenset(meta.get_field(f).column for f in fields)
+            if columns not in enforced:
+                missing.append((meta.label, fields))
+
+for label, fields in missing:
+    print(f"  {label}: declared unique on {fields} - NOT enforced by the database")
+print(("REPRODUCED: " if missing else "NOT REPRODUCED: ") + f"{len(missing)} declared uniqueness rule(s) missing in the database.")
