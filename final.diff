+):
+    """Same problem for a regular payment-app transaction (REFUND / CHARGE / CANCEL).
+
+    Only the outbound dispatch to the app (PluginsManager.<method>) is mocked.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    app.permissions.add(permission_manage_payments)
+    webhook = app.webhooks.create(
+        name="Request", is_active=True, target_url="http://app.example.com/endpoint/"
+    )
+    webhook.events.create(event_type=webhook_event)
+    order = order_with_lines
+    full_amount = order.total_gross_amount
+    transaction = transaction_item_generator(
+        order_id=order.pk, app=app, **{money_field: full_amount}
+    )
+
+    # when
+    with patch(f"saleor.plugins.manager.PluginsManager.{manager_method}") as mocked:
