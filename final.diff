+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderChargeStatus
+from saleor.payment.error_codes import TransactionUpdateErrorCode
+
+TRANSACTION_CREATE = """
+mutation Create($id: ID!, $transaction: TransactionCreateInput!) {
+  transactionCreate(id: $id, transaction: $transaction) {
+    transaction { id pspReference }
+    errors { field code message }
+  }
+}
+"""
+
+TRANSACTION_UPDATE = """
+mutation Update($id: ID, $transaction: TransactionUpdateInput) {
+  transactionUpdate(id: $id, transaction: $transaction) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_same_payment_can_be_recorded_twice_with_transaction_create(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+):
+    """transactionCreate accepts a pspReference that already exists (no dedup at all).
+
+    transactionUpdate refuses to reuse an existing pspReference ("already exists"),
+    transactionCreate does not check it, so a repeated submit / retry records the same
+    payment twice and the order becomes overcharged.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+    total = order.total_gross_amount
+    psp_reference = "PSP-12345"
+    variables = {
+        "id": to_global_id_or_none(order),
+        "transaction": {
+            "name": "Bank transfer",
+            "pspReference": psp_reference,
+            "amountCharged": {"amount": total, "currency": order.currency},
+        },
+    }
+
+    # when: the same request is submitted twice (sequentially)
+    first = get_graphql_content(
+        staff_api_client.post_graphql(TRANSACTION_CREATE, variables)
+    )
+    second = get_graphql_content(
+        staff_api_client.post_graphql(TRANSACTION_CREATE, variables)
+    )
+
+    # then
+    assert first["data"]["transactionCreate"]["errors"] == []
+    assert second["data"]["transactionCreate"]["errors"] == []  # BUG: accepted
+    order.refresh_from_db()
+    transactions = list(order.payment_transactions.all())
+    assert [t.psp_reference for t in transactions] == [psp_reference, psp_reference]
+    assert order.total_charged_amount == 2 * total
+    assert order.charge_status == OrderChargeStatus.OVERCHARGED
+
+    # for contrast: transactionUpdate enforces the uniqueness that create skipped
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_CREATE,
+            {"id": to_global_id_or_none(order), "transaction": {"name": "Other"}},
+        )
+    )
+    third_id = content["data"]["transactionCreate"]["transaction"]["id"]
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            TRANSACTION_UPDATE,
+            {"id": third_id, "transaction": {"pspReference": psp_reference}},
+        )
+    )
+    errors = content["data"]["transactionUpdate"]["errors"]
+    assert len(errors) == 1
+    assert errors[0]["code"] == TransactionUpdateErrorCode.UNIQUE.name
+    assert errors[0]["field"] == "transaction"
+    assert (
+        errors[0]["message"]
+        == "Transaction with provided `pspReference` already exists."
+    )
