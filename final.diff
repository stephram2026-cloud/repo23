+++ b/_repro/tasks/test_release_funds_overlap_requests_refund_twice.py
@@ -0,0 +1,87 @@
+"""Two overlapping runs of `transaction_release_funds_for_checkout_task` request the
+refund of the same abandoned-checkout payment twice.
+
+The task reads the candidate transactions from the *read replica*
+(`last_refund_success=True`, charged/authorized > 0), then re-fetches them on
+the writer by pk only (`pk__in=..., order_id=None`) - it neither re-checks
+`last_refund_success` nor locks the rows - creates a REFUND_REQUEST event per
+transaction with a fresh random idempotency key, flips `last_refund_success` to
+False and calls `request_refund_action`.
+
+The "mark as not refundable to avoid multiple automatic refund requests" guard
+therefore only works for runs that start after the previous one committed AND
+after the replica replayed that commit. A duplicate delivery of the beat
+message (or two beat runs overlapping) sends two independent refund requests
+for the full charged amount to the payment app.
+
+Concurrency: reproduced deterministically with the repo helper
+`saleor.tests.race_condition.RunBefore` (second run executes after the first
+run selected its transactions and before it writes anything). No threads.
+`request_refund_action` (the outbound call to the payment app) is replaced by
+a mock, exactly like the repo's own tests for this task do.
+"""
+
+import datetime
+from decimal import Decimal
+from unittest import mock
+
+import pytest
+from freezegun import freeze_time
+
+from saleor.checkout.actions import transaction_amounts_for_checkout_updated
+from saleor.payment import TransactionEventType
+from saleor.payment.tasks import transaction_release_funds_for_checkout_task
+from saleor.tests.race_condition import RunBefore
+
+
+@pytest.mark.django_db
+@mock.patch("saleor.payment.tasks.request_refund_action")
+@freeze_time("2021-03-18 12:00:00")
+def test_overlapping_runs_request_refund_twice(
+    mocked_refund_action, checkout, transaction_item_generator, plugins_manager
+):
+    # given: an abandoned checkout with a 100 USD charged transaction, past the TTL
+    charged_value = Decimal(100)
+    ttl_time = datetime.datetime.now(tz=datetime.UTC) - datetime.timedelta(hours=6)
+    with freeze_time(ttl_time - datetime.timedelta(seconds=1)):
+        transaction_item = transaction_item_generator(
+            checkout_id=checkout.pk, charged_value=charged_value
+        )
+        transaction_amounts_for_checkout_updated(
+            transaction_item, checkout, plugins_manager, user=None, app=None
+        )
+        checkout.automatically_refundable = True
+        checkout.save(update_fields=["automatically_refundable", "last_change"])
+    assert transaction_item.last_refund_success is True
+
+    def second_run(*args, **kwargs):
+        transaction_release_funds_for_checkout_task()
+
+    # when: a second delivery of the task runs while the first one is between
+    # selecting its transactions and marking them as handled
+    with RunBefore("saleor.payment.tasks.uuid.uuid4", second_run):
+        transaction_release_funds_for_checkout_task()
+
+    # then
+    # BUG: two REFUND_REQUEST events with different idempotency keys ...
+    refund_requests = list(
+        transaction_item.events.filter(type=TransactionEventType.REFUND_REQUEST)
+    )
+    assert len(refund_requests) == 2
+    assert all(event.amount_value == charged_value for event in refund_requests)
+    assert len({event.idempotency_key for event in refund_requests}) == 2
+
+    # BUG: ... and the payment app is asked twice to refund the full 100 USD
+    assert mocked_refund_action.call_count == 2
+    refunded_values = [
+        call.kwargs["refund_value"] for call in mocked_refund_action.call_args_list
+    ]
+    requested_for = {
+        call.kwargs["transaction"].pk for call in mocked_refund_action.call_args_list
+    }
+    print(
+        f"charged={charged_value} refund requests sent={refunded_values} "
+        f"for transaction pks={requested_for}"
+    )
+    assert refunded_values == [charged_value, charged_value]
+    assert requested_for == {transaction_item.pk}
