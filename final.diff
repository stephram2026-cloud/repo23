@@ -0,0 +1,93 @@
+"""A webhook subscribed to ANY_EVENTS never receives order events.
+
+Order events (ORDER_CREATED / UPDATED / CANCELLED / FULFILLED / PAID / ...,
+DRAFT_ORDER_*) are dispatched through `call_order_event(s)`, which resolves the
+subscribers with `get_webhooks_for_multiple_events()`. That helper files a webhook
+subscribed to `any_events` under the key "any_events" only, and the callers look
+the map up by the concrete event name, so the ANY subscriber is dropped.
+`get_webhooks_for_event()` (used by every other event) does include it.
+
+The outermost Celery scheduling call is patched only to keep the network out;
+the claim is about which deliveries Saleor creates.
+"""
+
+from unittest import mock
+
+import graphene
+
+from saleor.core.models import EventDelivery
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.order import OrderStatus
+from saleor.webhook.event_types import WebhookEventAsyncType
+from saleor.webhook.models import Webhook
+from saleor.webhook.utils import get_webhooks_for_event
+
+ORDER_CANCEL = """
+mutation cancelOrder($id: ID!) {
+  orderCancel(id: $id) {
+    order { status }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_any_events_webhook_gets_no_delivery_for_order_cancel(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_orders,
+    order_with_lines,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_orders)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    any_webhook = Webhook.objects.create(
+        name="any", app=app, target_url="http://www.example.com/any"
+    )
+    any_webhook.events.create(event_type=WebhookEventAsyncType.ANY)
+    explicit_webhook = Webhook.objects.create(
+        name="explicit", app=app, target_url="http://www.example.com/explicit"
+    )
+    explicit_webhook.events.create(event_type=WebhookEventAsyncType.ORDER_CANCELLED)
+    explicit_webhook.events.create(event_type=WebhookEventAsyncType.ORDER_UPDATED)
+
+    # The single-event lookup treats the ANY webhook as a valid subscriber.
+    single_lookup = set(get_webhooks_for_event(WebhookEventAsyncType.ORDER_CANCELLED))
+    assert single_lookup == {any_webhook, explicit_webhook}
+
+    # when
+    with mock.patch(
+        "saleor.webhook.transport.asynchronous.transport."
+        "send_webhook_request_async.apply_async"
+    ) as mocked_send:
+        response = staff_api_client.post_graphql(
+            ORDER_CANCEL,
+            {"id": graphene.Node.to_global_id("Order", order_with_lines.pk)},
+        )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["orderCancel"]["errors"] == []
+    assert (
+        content["data"]["orderCancel"]["order"]["status"]
+        == OrderStatus.CANCELED.upper()
+    )
+
+    explicit_events = sorted(
+        EventDelivery.objects.filter(webhook=explicit_webhook).values_list(
+            "event_type", flat=True
+        )
+    )
+    assert explicit_events == [
+        WebhookEventAsyncType.ORDER_CANCELLED,
+        WebhookEventAsyncType.ORDER_UPDATED,
+    ]
+    assert mocked_send.call_count == 2
+
+    # BUG: the ANY_EVENTS webhook got nothing at all for the cancelled order -
+    # neither ORDER_CANCELLED nor ORDER_UPDATED.
+    assert EventDelivery.objects.filter(webhook=any_webhook).exists() is False
diff --git a/_repro/webhooks/test_deferred_delivery_without_payload_stays_pending_forever.py b/_repro/webhooks/test_deferred_delivery_without_payload_stays_pending_forever.py
new file mode 100644
index 0000000000..d8c9c8a122
--- /dev/null
+++ b/_repro/webhooks/test_deferred_delivery_without_payload_stays_pending_forever.py
@@ -0,0 +1,124 @@
+"""Deferred deliveries that end up with no payload stay PENDING and are never purged.
+
+For deferred-payload events (all ORDER_*, DRAFT_ORDER_CREATED/UPDATED, some
+FULFILLMENT_*, CHECKOUT_*, stock-in-channel events) the EventDelivery row is
+created *before* the payload is generated. When `generate_deferred_payloads`
+produces no payload for a delivery (here: a webhook created through the public
+`webhookCreate` API with `asyncEvents` wider than what its subscription query
+selects), the row is left as PENDING with `payload_id = NULL` and nothing is sent.
+
+`delete_event_payloads_task` (the only periodic cleanup) deletes EventPayload rows
+and relies on the FK cascade, so a delivery without a payload is never removed:
+one orphan PENDING row per event, forever.
+"""
+
+import datetime
+from unittest import mock
+
+import graphene
+from django.utils import timezone
+
+from saleor.core import EventDeliveryStatus
+from saleor.core.models import EventDelivery, EventPayload
+from saleor.core.tasks import delete_event_payloads_task
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.graphql.webhook.enums import WebhookEventTypeAsyncEnum
+from saleor.webhook.event_types import WebhookEventAsyncType
+from saleor.webhook.models import Webhook, WebhookPayloadGeneration
+
+WEBHOOK_CREATE = """
+mutation($input: WebhookCreateInput!) {
+  webhookCreate(input: $input) {
+    webhook { id asyncEvents { eventType } }
+    errors { field code message }
+  }
+}
+"""
+ORDER_CANCEL = """
+mutation cancelOrder($id: ID!) {
+  orderCancel(id: $id) { order { status } errors { field code message } }
+}
+"""
+SUBSCRIPTION = "subscription { event { ... on OrderCancelled { order { id status } } } }"
+
+
+def test_deferred_delivery_without_payload_is_left_pending_and_never_cleaned(
+    staff_api_client,
+    permission_manage_apps,
+    permission_group_manage_orders,
+    permission_manage_orders,
+    order_with_lines,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_orders)
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            WEBHOOK_CREATE,
+            {
+                "input": {
+                    "app": graphene.Node.to_global_id("App", app.pk),
+                    "name": "orders",
+                    "targetUrl": "http://www.example.com/orders",
+                    "query": SUBSCRIPTION,
+                    "asyncEvents": [
+                        WebhookEventTypeAsyncEnum.ORDER_CANCELLED.name,
+                        WebhookEventTypeAsyncEnum.ORDER_UPDATED.name,
+                    ],
+                }
+            },
+        )
+    )
+    assert content["data"]["webhookCreate"]["errors"] == []
+    webhook = Webhook.objects.get()
+    assert webhook.payload_generation == WebhookPayloadGeneration.DEFERRED
+
+    # when: one staff action that fires ORDER_CANCELLED + ORDER_UPDATED
+    with mock.patch(
+        "saleor.webhook.transport.asynchronous.transport."
+        "send_webhook_request_async.apply_async"
+    ) as mocked_send:
+        content = get_graphql_content(
+            staff_api_client.post_graphql(
+                ORDER_CANCEL,
+                {"id": graphene.Node.to_global_id("Order", order_with_lines.pk)},
+            )
+        )
+    assert content["data"]["orderCancel"]["errors"] == []
+
+    # then: ORDER_CANCELLED got a payload and was handed over for sending...
+    cancelled = EventDelivery.objects.get(
+        event_type=WebhookEventAsyncType.ORDER_CANCELLED
+    )
+    mocked_send.assert_called_once()
+    assert mocked_send.call_args.kwargs["kwargs"]["event_delivery_id"] == cancelled.pk
+
+    # BUG: ...while the ORDER_UPDATED delivery was created, got no payload, was
+    # never sent and never moved out of PENDING.
+    stuck = EventDelivery.objects.get(event_type=WebhookEventAsyncType.ORDER_UPDATED)
+    assert stuck.status == EventDeliveryStatus.PENDING
+    assert stuck.payload_id is None
+    assert stuck.attempts.exists() is False
+
+    # when: both rows are far older than EVENT_PAYLOAD_DELETE_PERIOD (14 days)
+    # and the periodic cleanup runs
+    old = timezone.now() - datetime.timedelta(days=60)
+    assert settings.EVENT_PAYLOAD_DELETE_PERIOD < datetime.timedelta(days=60)
+    EventDelivery.objects.update(created_at=old)
+    EventPayload.objects.update(created_at=old)
+    with mock.patch("saleor.core.tasks.delete_files_from_private_storage_task.delay"):
+        delete_event_payloads_task()
+
+    # then: the delivery that had a payload is purged...
+    assert EventDelivery.objects.filter(pk=cancelled.pk).exists() is False
+    assert EventPayload.objects.exists() is False
+    # BUG: ...but the payload-less PENDING delivery survives the cleanup; nothing
+    # else in the codebase ever deletes it.
+    stuck.refresh_from_db(fields=("status",))
+    assert stuck.status == EventDeliveryStatus.PENDING
+    assert EventDelivery.objects.count() == 1
diff --git a/_repro/webhooks/test_event_delivery_retry_resends_sync_payment_request_and_drops_response.py b/_repro/webhooks/test_event_delivery_retry_resends_sync_payment_request_and_drops_response.py
new file mode 100644
index 0000000000..50149e6dc2
--- /dev/null
+++ b/_repro/webhooks/test_event_delivery_retry_resends_sync_payment_request_and_drops_response.py
@@ -0,0 +1,158 @@
+"""`eventDeliveryRetry` pushes a failed *synchronous* payment request through the async sender.
+
+Failed sync deliveries (e.g. TRANSACTION_REFUND_REQUESTED) are stored as FAILED
+EventDelivery rows and are retryable through `eventDeliveryRetry`. The mutation
+pushes any delivery through the *async* sender (`send_webhook_request_async`),
+which POSTs to the payment app again (with an empty body, because the stored
+payload of a failed transaction request has been wiped), only looks at the HTTP
+status and then deletes the delivery. Whatever the app answers (here:
+REFUND_SUCCESS) is thrown away: no TransactionEvent is created, the transaction
+amounts stay untouched, the mutation reports no error and the delivery vanishes.
+
+Real HTTP is used against a loopback server (see conftest.py).
+"""
+
+from decimal import Decimal
+
+import graphene
+
+from saleor.core import EventDeliveryStatus
+from saleor.core.models import EventDelivery
+from saleor.graphql.payment.enums import TransactionActionEnum
+from saleor.graphql.tests.utils import get_graphql_content
+from saleor.payment import TransactionEventType
+from saleor.payment.models import TransactionEvent, TransactionItem
+from saleor.webhook.event_types import WebhookEventSyncType
+
+REQUEST_ACTION = """
+mutation($id: ID, $action_type: TransactionActionEnum!, $amount: PositiveDecimal) {
+  transactionRequestAction(id: $id, actionType: $action_type, amount: $amount) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+DELIVERY_RETRY = """
+mutation($id: ID!) {
+  eventDeliveryRetry(id: $id) {
+    delivery { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_retry_of_failed_refund_request_posts_empty_body_and_drops_app_answer(
+    local_server,
+    staff_api_client,
+    permission_manage_payments,
+    permission_manage_apps,
+    permission_group_manage_orders,
+    order_with_lines,
+    app,
+    settings,
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    app.permissions.add(permission_manage_payments)
+    webhook = app.webhooks.create(
+        name="payment app", is_active=True, target_url=f"{local_server.url}/pay"
+    )
+    webhook.events.create(
+        event_type=WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED
+    )
+    refund_amount = Decimal("10.00")
+    transaction = TransactionItem.objects.create(
+        name="Credit card",
+        psp_reference="PSP ref",
+        available_actions=["refund"],
+        currency="USD",
+        order_id=order_with_lines.pk,
+        charged_value=refund_amount,
+        app_identifier=app.identifier,
+        app=app,
+    )
+    staff_api_client.user.user_permissions.add(
+        permission_manage_payments, permission_manage_apps
+    )
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # First refund request: the payment app answers 400, Saleor records a failure
+    # and keeps the FAILED delivery.
+    local_server.responses.append((400, b'{"error": "try again later"}', 0))
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            REQUEST_ACTION,
+            {
+                "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+                "action_type": TransactionActionEnum.REFUND.name,
+                "amount": refund_amount,
+            },
+        )
+    )
+    assert content["data"]["transactionRequestAction"]["errors"] == []
+    delivery = EventDelivery.objects.get()
+    assert delivery.event_type == WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED
+    assert delivery.status == EventDeliveryStatus.FAILED
+    assert len(local_server.requests) == 1
+    events_before_retry = sorted(
+        TransactionEvent.objects.filter(transaction=transaction).values_list(
+            "type", flat=True
+        )
+    )
+    assert events_before_retry == [
+        TransactionEventType.REFUND_FAILURE,
+        TransactionEventType.REFUND_REQUEST,
+    ]
+
+    # when: staff retries the failed delivery; this time the app performs the refund
+    psp_reference = "refund-123"
+    local_server.responses.append(
+        (
+            200,
+            local_server.json(
+                {
+                    "pspReference": psp_reference,
+                    "result": TransactionEventType.REFUND_SUCCESS.upper(),
+                    "amount": str(refund_amount),
+                }
+            ),
+            0,
+        )
+    )
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            DELIVERY_RETRY,
+            {"id": graphene.Node.to_global_id("EventDelivery", delivery.pk)},
+        )
+    )
+
+    # then
+    assert content["data"]["eventDeliveryRetry"]["errors"] == []
+    # BUG: the sync refund request was POSTed to the payment app a second time...
+    assert len(local_server.requests) == 2
+    assert (
+        local_server.requests[1]["headers"]["saleor-event"]
+        == WebhookEventSyncType.TRANSACTION_REFUND_REQUESTED
+    )
+    # (with an empty body - the stored payload of a failed transaction request is
+    # wiped, see test_transaction_request_retry_sends_empty_body.py)
+    assert local_server.requests[0]["body"] != b""
+    assert local_server.requests[1]["body"] == b""
+    # BUG: ...the app's REFUND_SUCCESS answer was thrown away: no new transaction
+    # event, nothing with the PSP reference, amounts unchanged...
+    events_after_retry = sorted(
+        TransactionEvent.objects.filter(transaction=transaction).values_list(
+            "type", flat=True
+        )
+    )
+    assert events_after_retry == events_before_retry
+    assert (
+        TransactionEvent.objects.filter(psp_reference=psp_reference).exists() is False
+    )
+    transaction.refresh_from_db(fields=("charged_value", "refunded_value"))
+    assert transaction.refunded_value == Decimal(0)
+    assert transaction.charged_value == refund_amount
+    # BUG: ...and the delivery was treated as a successful async delivery and deleted,
+    # so no trace of the second request is left.
+    assert EventDelivery.objects.exists() is False
