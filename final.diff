+from decimal import Decimal
+
+import graphene
+
+from saleor.giftcard.const import GIFT_CARD_PAYMENT_GATEWAY_ID
+from saleor.graphql.core.utils import to_global_id_or_none
+from saleor.graphql.tests.utils import (
+    get_graphql_content,
+    get_graphql_content_from_response,
+)
+from saleor.order import OrderChargeStatus, OrderGrantedRefundStatus
+from saleor.payment import TransactionAction
+
+GRANT_REFUND_CREATE = """
+mutation Create($id: ID!, $input: OrderGrantRefundCreateInput!) {
+  orderGrantRefundCreate(id: $id, input: $input) {
+    grantedRefund { id amount { amount } status lines { quantity } }
+    order { chargeStatus totalGrantedRefund { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+REQUEST_REFUND_FOR_GRANTED_REFUND = """
+mutation Refund($grantedRefundID: ID!) {
+  transactionRequestRefundForGrantedRefund(grantedRefundId: $grantedRefundID) {
+    transaction { id chargedAmount { amount } refundedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_negative_granted_refund_amount_is_accepted_and_charges_gift_card(
+    staff_api_client,
+    permission_group_manage_orders,
+    permission_manage_payments,
+    order_with_lines,
+    transaction_item_generator,
+    gift_card_created_by_staff,
+):
+    """orderGrantRefundCreate accepts a negative `amount` (plain Decimal scalar).
+
+    The order (fully paid) flips to PARTIAL charge status, and sending the granted
+    refund performs a "negative refund": it takes money FROM the gift card and raises
+    the charged amount above what was paid.
+    """
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.user_permissions.add(permission_manage_payments)
+    order = order_with_lines
+
+    gift_card = gift_card_created_by_staff
+    balance_before = gift_card.current_balance_amount
+    assert balance_before == Decimal(10)
+
+    paid = order.total_gross_amount
+    transaction = transaction_item_generator(
+        app_identifier=GIFT_CARD_PAYMENT_GATEWAY_ID,
+        order_id=order.pk,
+        gift_card=gift_card,
+        charged_value=paid,
+        available_actions=[TransactionAction.REFUND],
+    )
+    negative_amount = Decimal("-5.00")
+
+    # when
+    response = staff_api_client.post_graphql(
+        GRANT_REFUND_CREATE,
+        {
+            "id": to_global_id_or_none(order),
+            "input": {
+                "amount": negative_amount,
+                "transactionId": graphene.Node.to_global_id(
+                    "TransactionItem", transaction.token
+                ),
+            },
+        },
+    )
+    data = get_graphql_content(response)["data"]["orderGrantRefundCreate"]
+
+    # then
+    # BUG: negative amount accepted
+    assert data["errors"] == []
+    assert Decimal(str(data["grantedRefund"]["amount"]["amount"])) == negative_amount
+    order.refresh_from_db()
+    assert order.total_charged_amount == paid
+    # BUG: fully paid order is now reported as only partially charged
+    assert order.charge_status == OrderChargeStatus.PARTIAL
+    granted_refund = order.granted_refunds.get()
+    assert granted_refund.amount_value == negative_amount
+
+    # and when the "refund" is sent
+    response = staff_api_client.post_graphql(
+        REQUEST_REFUND_FOR_GRANTED_REFUND,
+        {"grantedRefundID": data["grantedRefund"]["id"]},
+    )
+    data = get_graphql_content(response)["data"][
+        "transactionRequestRefundForGrantedRefund"
+    ]
+    assert data["errors"] == []
+
+    transaction.refresh_from_db()
+    gift_card.refresh_from_db()
+    order.refresh_from_db()
+    granted_refund.refresh_from_db()
+
+    # BUG: the customer's gift card was debited instead of credited
+    assert gift_card.current_balance_amount == balance_before + negative_amount
+    # BUG: negative refunded amount, charged amount above what was paid
+    assert transaction.refunded_value == negative_amount
+    assert transaction.charged_value == paid - negative_amount
+    assert order.total_charged_amount == paid - negative_amount
+    assert granted_refund.status == OrderGrantedRefundStatus.SUCCESS
+
+
+def test_negative_line_quantity_crashes_with_integrity_error(
+    staff_api_client,
+    permission_group_manage_orders,
+    order_with_lines,
+    transaction_item_generator,
+):
+    """A negative line quantity is not validated and crashes on a DB check constraint."""
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    transaction = transaction_item_generator(
+        order_id=order.pk, charged_value=order.total_gross_amount
+    )
+    line = order.lines.first()
+
+    # when
+    response = staff_api_client.post_graphql(
+        GRANT_REFUND_CREATE,
+        {
+            "id": to_global_id_or_none(order),
+            "input": {
+                "lines": [{"id": to_global_id_or_none(line), "quantity": -1}],
+                "transactionId": graphene.Node.to_global_id(
+                    "TransactionItem", transaction.token
+                ),
+            },
+        },
+    )
+    content = get_graphql_content_from_response(response)
+    print("RESPONSE:", content)
+
+    # then
+    # BUG: unhandled IntegrityError (generic server error) instead of a line error
+    assert len(content["errors"]) == 1
+    assert content["errors"][0]["extensions"]["exception"]["code"] == "IntegrityError"
+    assert content["data"]["orderGrantRefundCreate"] is None
+    assert order.granted_refunds.exists() is False
