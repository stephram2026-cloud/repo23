+"""How do completing and shipping scale with the number of lines?"""
+
+import time
+
+from django.db import connection
+
+from live import *  # noqa: F403
+from live import DRAFT_COMPLETE, errors_of, mark_paid
+
+for n in (10, 50, 150, 400):
+    variants = [make_variant(stock_qty=100) for _ in range(n)]
+    draft = create_draft([(v, 1) for v, _ in variants])
+    t0 = time.time()
+    res = gql(DRAFT_COMPLETE, {"id": draft["id"]}, check=False)
+    t_complete = time.time() - t0
+    assert not errors_of(res, "draftOrderComplete"), res
+    mark_paid(draft["id"])
+    order = get_order(draft["id"])
+    t0 = time.time()
+    res = fulfill(order["id"], [(l["id"], 1) for l in order["lines"]], variants[0][1].warehouse)
+    t_fulfill = time.time() - t0
+    assert not errors_of(res, "orderFulfill"), res
+    print(f"  {n:>4} lines: draftOrderComplete {t_complete:6.2f}s   orderFulfill {t_fulfill:6.2f}s")
diff --git a/_repro/orders/26_sequential_consistency_sweep.py b/_repro/orders/26_sequential_consistency_sweep.py
new file mode 100644
index 0000000000..54613c96d1
--- /dev/null
+++ b/_repro/orders/26_sequential_consistency_sweep.py
@@ -0,0 +1,73 @@
+"""Sanity sweep of ordinary one-at-a-time flows; flags any stock inconsistency."""
+
+from django.db.models import Sum
+
+from live import *  # noqa: F403
+from live import (
+    LINE_DELETE, auto_confirm, brief, cancel_order, errors_of, fulfillment_cancel,
+    line_update, lines_create, new_order,
+)
+
+problems = []
+
+
+def check(label, variant, expect_qty, expect_alloc):
+    rows = list(Stock.objects.filter(product_variant=variant).order_by("pk"))
+    qty = sum(s.quantity for s in rows)
+    denorm = sum(s.quantity_allocated for s in rows)
+    real = Allocation.objects.filter(stock__product_variant=variant).aggregate(s=Sum("quantity_allocated"))["s"] or 0
+    ok = (qty, denorm, real) == (expect_qty, expect_alloc, expect_alloc)
+    print(f"  {'ok ' if ok else 'BAD'} {label}: quantity={qty} stock.allocated={denorm} sum(allocations)={real} (expected {expect_qty}/{expect_alloc})")
+    if not ok:
+        problems.append(label)
+
+
+whs = warehouses()
+
+# unconfirmed order edits
+auto_confirm(False)
+try:
+    v, s = make_variant(stock_qty=20)
+    v2, s2 = make_variant(stock_qty=20)
+    order = create_draft([(v, 4), (v2, 1)], complete=True)
+    check("unconfirmed placed (4)", v, 20, 4)
+    line = next(l for l in order["lines"] if l["variant"]["sku"] == v.sku)
+    assert not errors_of(line_update(line["id"], 7), "orderLineUpdate")
+    check("unconfirmed line 4 -> 7", v, 20, 7)
+    assert not errors_of(line_update(line["id"], 2), "orderLineUpdate")
+    check("unconfirmed line 7 -> 2", v, 20, 2)
+    res = line_update(line["id"], 500)
+    print("     over-stock edit ->", errors_of(res, "orderLineUpdate"))
+    check("unconfirmed line 2 -> 500 rejected", v, 20, 2)
+    assert not errors_of(lines_create(order["id"], v, 3), "orderLinesCreate")
+    check("unconfirmed add 3 more of same variant", v, 20, 5)
+    assert not errors_of(gql(LINE_DELETE, {"id": line["id"]}, check=False), "orderLineDelete")
+    check("unconfirmed line deleted", v, 20, 0)
+    assert not errors_of(cancel_order(order["id"]), "orderCancel")
+    check("unconfirmed order cancelled (other variant)", v2, 20, 0)
+finally:
+    auto_confirm(True)
+
+# ship from another warehouse than the one holding the allocation
+v, s = make_variant(stock_qty=10, warehouse=whs[0])
+Stock.objects.create(warehouse=whs[1], product_variant=v, quantity=10)
+order = new_order([(v, 4)])
+check("placed, two warehouses", v, 20, 4)
+alloc_wh = order["lines"][0]["allocations"][0]["warehouse"]["name"]
+other = whs[1] if alloc_wh == whs[0].name else whs[0]
+res = fulfill(order["id"], [(order["lines"][0]["id"], 4)], other)
+print("     ship from the other warehouse ->", errors_of(res, "orderFulfill"))
+check("shipped from the non-allocated warehouse", v, 16, 0)
+
+# partial ship, cancel the shipment with restock, cancel the order
+v, s = make_variant(stock_qty=10)
+order = new_order([(v, 6)])
+res = fulfill(order["id"], [(order["lines"][0]["id"], 2)], s.warehouse)
+check("partially shipped 2 of 6", v, 8, 4)
+order = get_order(order["id"])
+assert not errors_of(fulfillment_cancel(order["fulfillments"][0]["id"], warehouse=s.warehouse), "orderFulfillmentCancel")
+check("shipment cancelled + restocked", v, 10, 6)
+assert not errors_of(cancel_order(order["id"]), "orderCancel")
+check("order cancelled", v, 10, 0)
+
+print("SWEEP RESULT:", "all consistent" if not problems else f"inconsistent after: {problems}")
